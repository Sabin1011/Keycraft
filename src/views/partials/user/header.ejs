<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KeyCraft - Premium Mechanical Keyboards</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Questrial|Raleway:700,900" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    
<style>
  :root {
    --yellow: #fbbf24;
    --black: #0b0b0e;
    --dark-gray: #1a1a1f;
    --gray: #9ca3af;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Questrial', sans-serif;
    background: #0b0b0e;
    color: #e5e7eb;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ===== HEADER ===== */
  header {
    background: linear-gradient(180deg, #0f0f12, #0b0b0e);
    border-bottom: 1px solid #1f1f25;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .header-wrapper {
    padding: 18px 0;
  }

  .header-wrapper .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  /* ===== LOGO ===== */
  .logo {
    font-size: 32px;
    font-weight: 900;
    font-family: 'Raleway', sans-serif;
    color: #fff;
    text-decoration: none;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .logo span {
    color: var(--yellow);
  }

  /* ===== NAVIGATION ===== */
  nav {
    flex: 1;
  }

  nav ul {
    display: flex;
    list-style: none;
    gap: 34px;
    justify-content: center;
  }

  nav a {
    color: #e5e7eb;
    text-decoration: none;
    font-size: 14px;
    text-transform: lowercase;
    font-weight: 600;
    letter-spacing: .4px;
    position: relative;
    padding-bottom: 6px;
    transition: color .3s ease;
  }

  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--yellow);
    transition: width .3s ease;
  }

  nav a:hover {
    color: var(--yellow);
  }

  nav a:hover::after {
    width: 100%;
  }

  /* ===== HEADER ACTIONS ===== */
  .header-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  /* ===== CART ===== */
  .cart-btn {
    background: var(--dark-gray);
    color: #fff;
    border: 1px solid #2a2a2f;
    padding: 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all .3s ease;
  }

  .cart-btn:hover {
    background: #000;
    border-color: var(--yellow);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(251,191,36,.15);
  }

  .cart-badge {
    background: var(--yellow);
    color: #000;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
  }

  /* ===== LOGIN ===== */
  .login-btn {
    background: transparent;
    color: var(--yellow);
    border: 1px solid var(--yellow);
    padding: 10px 22px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all .3s ease;
  }

  .login-btn:hover {
    background: var(--yellow);
    color: #000;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(251,191,36,.25);
  }

  /* ===== REGISTER ===== */
  .register-btn {
    background: var(--yellow);
    color: #000;
    border: 1px solid var(--yellow);
    padding: 10px 22px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition: all .3s ease;
  }

  .register-btn:hover {
    background: #ffd166;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(251,191,36,.35);
  }

  /* ===== LOGOUT ===== */
  .logout-btn {
    background: #dc3545;
    color: #fff;
    border: 1px solid #dc3545;
    padding: 10px 20px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all .3s ease;
  }

  .logout-btn:hover {
    background: #c82333;
    border-color: #c82333;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(220,53,69,.35);
  }

  .profile-btn {
    padding-left: 8px;
    color: #fff;
    transition: transform .3s ease, color .3s ease;
  }

  .profile-btn:hover {
    transform: scale(1.15);
    color: var(--yellow);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .header-wrapper .container {
      flex-wrap: wrap;
      justify-content: center;
    }

    .logo {
      width: 100%;
      text-align: center;
      font-size: 28px;
      margin-bottom: 14px;
    }

    nav {
      width: 100%;
      order: 3;
    }

    nav ul {
      justify-content: center;
      flex-wrap: wrap;
      gap: 18px;
    }

    .header-actions {
      order: 2;
      margin-bottom: 12px;
    }
  }
</style>


</head>
<body>
 
    <header>
        <div class="header-wrapper">
            <div class="container">
        
                <a href="/home" class="logo">key<span>craft</span></a>

                <nav>
                    <ul>
                        <li><a href="/home">home</a></li>
                        <li><a href="/shop">shop</a></li>
                        <li><a href="/about">about</a></li>
                        <li><a href="/wallet">Wallet</a></li>
                        <li><a href="/wishlist">wishlist</a></li>
                    </ul>
                </nav>

     
                <div class="header-actions" id="dynamic-header-actions">
                    <% if (typeof user !== 'undefined' && user) { %>
              
                        <a href="/cart" class="cart-btn">
                            <i class="fas fa-shopping-cart"></i>
                            cart
                            <span class="cart-badge"><%= cartCount || 0 %></span>
                        </a>


                        <a href="/logout" class="logout-btn">
                            <i class="fas fa-sign-out-alt"></i>
                            logout
                        </a>

                          <a href="/profile" class="profile-btn">
                            <i class='bx bx-user' style="font-size: 23px;"></i>
                        </a>
                        
                    <% } else { %>
           
                        <a href="/login" class="login-btn">login</a>

                        <a href="/register" class="register-btn">register</a>
                        
                    <% } %>
                </div>
            </div>
        </div>
    </header>


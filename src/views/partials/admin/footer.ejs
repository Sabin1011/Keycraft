}

.right-bar .mb-3 {
    margin-bottom: 16px;
}

.right-bar .mt-0 {
    margin-top: 0;
}

/* Rightbar Overlay */
.rightbar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1040;
    display: none;
    transition: opacity 0.3s ease;
}

.rightbar-overlay.show {
    display: block;
    opacity: 1;
}

/* Scrollbar Styles */
.right-bar [data-simplebar] {
    scrollbar-width: thin;
    scrollbar-color: #ced4da #f8f9fa;
}

.right-bar [data-simplebar]::-webkit-scrollbar {
    width: 6px;
}

.right-bar [data-simplebar]::-webkit-scrollbar-track {
    background: #f8f9fa;
}

.right-bar [data-simplebar]::-webkit-scrollbar-thumb {
    background: #ced4da;
    border-radius: 3px;
}

.right-bar [data-simplebar]::-webkit-scrollbar-thumb:hover {
    background: #adb5bd;
}

/* Responsive Styles */
@media (max-width: 991.98px) {
    .footer .text-sm-end {

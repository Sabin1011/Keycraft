    background-color: #e9ecef;
    border: none;
    position: relative;
}

.right-bar .form-check-input:checked {
    background-color: #556ee6;
}

.right-bar .form-check-input:focus {
    box-shadow: 0 0 0 0.2rem rgba(85, 110, 230, 0.25);
    border: none;
}

.right-bar .form-check-label {
    margin-left: 12px;
    font-size: 14px;
    color: #495057;
    font-weight: 500;
    cursor: pointer;
}

.right-bar .mb-5 {

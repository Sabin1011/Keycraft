<%- include('../partials/admin/header') %>
<link rel="stylesheet" href="/css/admin/addOffer.css">

<body data-sidebar="dark">
<div class="main-content">
  <div class="page-content">
    <div class="container">

      <div class="page-title-box d-flex align-items-center justify-content-between">
        <h4 class="font-size-18">Add Offer</h4>
        <a href="/admin/offerManage" class="btn btn-secondary">← Back</a>
      </div>

      <div class="card">
        <div class="card-body">

          <form action="/admin/offer/add" method="POST">

            <label class="form-label">Offer Title</label>
            <input type="text" class="form-control mb-3" name="title" required>

            <label class="form-label">Description</label>
            <textarea class="form-control mb-3" name="description"></textarea>

            <label class="form-label">Offer Type</label>
            <select class="form-control mb-3" name="offerType" id="offerType" required>
              <option value="">Select Type</option>
              <option value="product">Product Offer</option>
              <option value="category">Category Offer</option>
              <option value="cart">Cart Offer</option>
            </select>


            <div id="productSelect" class="mb-3 d-none select-box">
            <label>Select Products</label>

            <select class="styled-multiselect" name="productIds" multiple>
                <% allProducts.forEach(p => { %>
                <option 
                    value="<%= p._id %>" 
                    <%= selectedProducts && selectedProducts.includes(p._id.toString()) ? "selected" : "" %>
                >
                    <%= p.name %>
                </option>
                <% }) %>
            </select>

            <small class="text-muted">Hold CTRL (Windows) or CMD (Mac) to select multiple</small>
            <div id="productPreview" class="selected-preview d-none"></div>
            </div>

            <div id="categorySelect" class="mb-3 d-none select-box">
            <label>Select Categories</label>

            <select class="styled-multiselect" name="categoryIds" multiple>
                <% allCategories.forEach(c => { %>
                <option 
                    value="<%= c._id %>" 
                    <%= selectedCategories && selectedCategories.includes(c._id.toString()) ? "selected" : "" %>
                >
                    <%= c.name %>
                </option>
                <% }) %>
            </select>

            <small class="text-muted">Hold CTRL (Windows) or CMD (Mac) to select multiple</small>
            <div id="categoryPreview" class="selected-preview d-none"></div>

            </div>

            <div id="minPurchaseWrapper" class="mb-3 d-none">
              <label class="form-label">Minimum Purchase Amount</label>
              <input type="number" class="form-control" name="minPurchaseAmount" placeholder="₹ Amount">
            </div>

            <label class="form-label">Discount Type</label>
            <select class="form-control mb-3" name="discountType" required>
              <option value="percentage">Percentage</option>
              <option value="flat">Flat</option>
            </select>

            <label class="form-label">Discount Value</label>
            <input type="number" class="form-control mb-3" name="discountValue" required>

            <label class="form-label">Max Discount Amount (optional)</label>
            <input type="number" class="form-control mb-3" name="maxDiscountAmount">

            <label class="form-label">Start Date</label>
            <input type="date" class="form-control mb-3" name="startDate" required>

            <label class="form-label">Expiry Date</label>
            <input type="date" class="form-control mb-4" name="expiryDate" required>

            <button class="btn btn-black w-100 py-2">Add Offer</button>

          </form>

        </div>
      </div>

    </div>
  </div>

<%- include('../partials/admin/footer') %>

<script>
  const offerType = document.getElementById("offerType");
  const productSelect = document.getElementById("productSelect");
  const categorySelect = document.getElementById("categorySelect");
  const minPurchaseWrapper = document.getElementById("minPurchaseWrapper");

  offerType.addEventListener("change", () => {
    const type = offerType.value;

    productSelect.classList.toggle("d-none", type !== "product");
    categorySelect.classList.toggle("d-none", type !== "category");
    minPurchaseWrapper.classList.toggle("d-none", type !== "cart");
  });
  document.querySelector("select[name='productIds']").addEventListener("change", function() {
    const preview = document.getElementById("productPreview");
    const selected = [...this.selectedOptions].map(opt => opt.text);

    preview.innerHTML = selected.map(s => `<span class='preview-badge'>${s}</span>`).join("");

    preview.classList.toggle("d-none", selected.length === 0);
});

document.querySelector("select[name='categoryIds']").addEventListener("change", function() {
    const preview = document.getElementById("categoryPreview");
    const selected = [...this.selectedOptions].map(opt => opt.text);

    preview.innerHTML = selected.map(s => `<span class='preview-badge'>${s}</span>`).join("");

    preview.classList.toggle("d-none", selected.length === 0);
}); 
</script>

</body>
</html>

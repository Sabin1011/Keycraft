<%- include('../partials/admin/header') %>

<div class="container mt-5">
    <h3 class="mb-4">Edit Coupon</h3>

    <div class="card p-4 shadow-sm">
        <form id="editCouponForm">

            <input type="hidden" id="couponId" value="<%= coupon._id %>">

            <div class="mb-3">
                <label class="form-label">Coupon Code</label>
                <input type="text" class="form-control" id="code" value="<%= coupon.code %>" >
                <small class="text-danger" id="err-code"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Discount Type</label>
                <select class="form-control" id="discountType">
                    <option value="percentage" <%= coupon.discountType === "percentage" ? "selected" : "" %>>Percentage</option>
                    <option value="flat" <%= coupon.discountType === "flat" ? "selected" : "" %>>Flat</option>
                </select>
                <small class="text-danger" id="err-discountType"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Discount Value</label>
                <input type="number" class="form-control" id="discountValue" value="<%= coupon.discountValue %>" >
                <small class="text-danger" id="err-discountValue"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Max Discount Amount</label>
                <input type="number" class="form-control" id="maxDiscountAmount" value="<%= coupon.maxDiscountAmount %>">
                <small class="text-danger" id="err-maxDiscountAmount"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Minimum Purchase Amount</label>
                <input type="number" class="form-control" id="minPurchaseAmount" value="<%= coupon.minPurchaseAmount %>">
                <small class="text-danger" id="err-minPurchaseAmount"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Expiry Date</label>
                <input type="date" class="form-control" id="expiryDate" value="<%= coupon.expiryDate.toISOString().split("T")[0] %>" >
                <small class="text-danger" id="err-expiryDate"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" id="description"><%= coupon.description %></textarea>
                <small class="text-danger" id="err-description"></small>
            </div>

            <button type="submit" class="btn btn-dark w-100">Save Changes</button>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.getElementById("editCouponForm").addEventListener("submit", async function (e) {
    e.preventDefault();

    document.querySelectorAll("small.text-danger").forEach(el => el.innerText = "");

    const formData = {
        couponId: couponId.value,
        code: code.value,
        discountType: discountType.value,
        discountValue: discountValue.value,
        maxDiscountAmount: maxDiscountAmount.value,
        minPurchaseAmount: minPurchaseAmount.value,
        expiryDate: expiryDate.value,
        description: description.value,
    };

    const response = await fetch("/admin/coupon/edit", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formData),
    });

    const data = await response.json();

    if (data.success) {
        Swal.fire({
            icon: "success",
            title: "Coupon Updated!",
            text: data.message,
        }).then(() => {
            window.location.href = "/admin/couponManage";
        });
    } else {

        if (data.errors) {
            for (let field in data.errors) {
                const errTag = document.getElementById(`err-${field}`);
                if (errTag) errTag.innerText = data.errors[field];
            }
        }

        if (data.errors?.general) {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: data.errors.general,
            });
        }
    }
});
</script>


<%- include('../partials/admin/footer') %>

 <%- include('../partials/admin/header') %>

 <link rel="stylesheet" href="/css/admin/addCategory.css">
<body>
  <div class="container-fluid">
    <!-- Page Title -->
    <div class="row">
      <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
          <h4 class="mb-sm-0 font-size-18">Add Category</h4>
          <div class="page-title-right">
            <ol class="breadcrumb m-0">
              <li class="breadcrumb-item"><a href="/admin/category">Ecommerce/</a></li>
              <li class="breadcrumb-item"><a href="/admin/category">Categories/</a></li>
              <li class="breadcrumb-item active">Add Category</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Add Category Form -->
    <div class="row">
      <div class="col-lg-8 col-xl-6 mx-auto">
        <div class="card">
          <div class="card-body">

            <% if (typeof message !== 'undefined') { %>
              <div class="alert alert-danger" role="alert">
                <%= message %>
              </div>
            <% } %>

            <form id="addCategoryForm" action="/admin/addCategory" method="post">

              <!-- Category Name -->
              <div class="mb-4">
                <label for="categoryName" class="form-label">
                  Category Name <span class="required">*</span>
                </label>
                <input 
                  type="text" 
                  class="form-control" 
                  id="categoryName" 
                  placeholder="Enter category name"
                  name="name"
                  
                />
                <div class="text-danger">
                  <%= errors && errors.name ? errors.name : '' %>
                </div>
                <div class="form-text">Enter a unique and descriptive category name</div>
              </div>

              <!-- Category Description -->
              <div class="mb-4">
                <label for="categoryDescription" class="form-label" >
                  Category Description <span class="required">*</span>
                </label>
                <textarea   
                  class="form-control" 
                  id="categoryDescription" 
                  placeholder="Enter category description"
                  rows="4"
                  name="description"
                   
                ><%= typeof description !== 'undefined' ? description : '' %></textarea>
                <div class="text-danger">
                  <%= errors && errors.description ? errors.description : '' %>
                </div>
                <div class="form-text">Provide a brief description of the category</div>
              </div>

              <!-- Buttons -->
              <div class="btn-container">
                <button type="button" class="cancel-btn" onclick={cancel()}>
                  Cancel
                </button>
                <button type="submit" class="submit-btn">
                  <i class='bx bx-plus'></i> Add Category
                </button>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/admin/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <script>
    function cancel(){
      window.location.href = "/admin/category"
    }
    
  </script>
</body>
</html>
<%- include('../partials/admin/header') %>
<link rel="stylesheet" href="/css/admin/editOffer.css">
<body data-sidebar="dark">
<div class="main-content">
  <div class="page-content">
    <div class="container">

      <div class="page-title-box d-flex align-items-center justify-content-between">
        <h4 class="font-size-18">Edit Offer</h4>
        <a href="/admin/offerManage" class="btn btn-secondary">← Back</a>
      </div>

      <div class="card">
        <div class="card-body">

          <form id="offerForm">

            <input type="hidden" name="offerId" value="<%= offer._id %>">

            <label class="form-label">Offer Title</label>
            <input
              type="text"
              class="form-control mb-3"
              name="title"
              value="<%= offer.title %>"
              required
            >

            <label class="form-label">Description</label>
            <textarea class="form-control mb-3" name="description"><%= offer.description || "" %></textarea>

            <label class="form-label">Offer Type</label>
            <select class="form-control mb-3" name="offerType" id="offerType" required>
              <option value="product" <%= offer.offerType === "product" ? "selected" : "" %>>Product Offer</option>
              <option value="category" <%= offer.offerType === "category" ? "selected" : "" %>>Category Offer</option>
              <option value="cart" <%= offer.offerType === "cart" ? "selected" : "" %>>Cart Offer</option>
            </select>

            <h5>Select Products</h5>
            <div id="productSelect" class="mb-3 select-box <%= offer.offerType !== 'product' ? 'd-none' : '' %>">
              <label>Select Products</label>

              <select class="styled-multiselect" name="productIds" multiple>
                <% allProducts.forEach(p => { %>
                  <option
                    value="<%= p._id %>"
                    <%= selectedProducts.includes(p._id.toString()) ? "selected" : "" %>
                  >
                    <%= p.name %>
                  </option>
                <% }) %>
              </select>

              <small class="text-muted">Hold CTRL (Windows) or CMD (Mac) to select multiple</small>
              <div id="productPreview" class="selected-preview"></div>
            </div>


  

            <div id="categorySelect" class="mb-3 select-box <%= offer.offerType !== 'category' ? 'd-none' : '' %>">
              <label>Select Categories</label>

              <select class="styled-multiselect" name="categoryIds" multiple>
                <% allCategories.forEach(c => { %>
                  <option
                    value="<%= c._id %>"
                    <%= selectedCategories.includes(c._id.toString()) ? "selected" : "" %>
                  >
                    <%= c.name %>
                  </option>
                <% }) %>
              </select>

              <small class="text-muted">Hold CTRL (Windows) or CMD (Mac) to select multiple</small>
              <div id="categoryPreview" class="selected-preview"></div>
            </div>

            <div id="minPurchaseWrapper" class="mb-3 <%= offer.offerType !== "cart" ? "d-none" : "" %>">
              <label class="form-label">Minimum Purchase Amount</label>
              <input
                type="number"
                class="form-control"
                name="minPurchaseAmount"
                value="<%= offer.minPurchaseAmount || "" %>"
              >
            </div>

            <label class="form-label">Discount Type</label>
            <select class="form-control mb-3" name="discountType" required>
              <option value="percentage" <%= offer.discountType === "percentage" ? "selected" : "" %>>
                Percentage
              </option>
              <option value="flat" <%= offer.discountType === "flat" ? "selected" : "" %>>
                Flat
              </option>
            </select>

            <label class="form-label">Discount Value</label>
            <input
              type="number"
              class="form-control mb-3"
              name="discountValue"
              value="<%= offer.discountValue %>"
              required
            >

            <label class="form-label">Max Discount Amount (optional)</label>
            <input
              type="number"
              class="form-control mb-3"
              name="maxDiscountAmount"
              value="<%= offer.maxDiscountAmount || "" %>"
            >

            <label class="form-label">Start Date</label>
            <input
              type="date"
              class="form-control mb-3"
              name="startDate"
              value="<%= offer.startDate.toISOString().split('T')[0] %>"
              required
            >

            <label class="form-label">Expiry Date</label>
            <input
              type="date"
              class="form-control mb-4"
              name="expiryDate"
              value="<%= offer.expiryDate.toISOString().split('T')[0] %>"
              required
            >

            <button type="button" onclick="updateOffer()" class="btn btn-black w-100 py-2">
              Update Offer
            </button>

          </form>

        </div>
      </div>

    </div>
  </div>

<%- include('../partials/admin/footer') %>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const offerType = document.getElementById("offerType");
  const productSelect = document.getElementById("productSelect");
  const categorySelect = document.getElementById("categorySelect");
  const minPurchaseWrapper = document.getElementById("minPurchaseWrapper");

  offerType.addEventListener("change", () => {
    const type = offerType.value;

    productSelect.classList.toggle("d-none", type !== "product");
    categorySelect.classList.toggle("d-none", type !== "category");
    minPurchaseWrapper.classList.toggle("d-none", type !== "cart");

    if(type!=="product"){
      document.querySelector("select[name='productIds']").selectedIndex=-1;
      document.getElementById("productPreview").innerHTML="";
    }

    if (type !== "category") {
      document.querySelector("select[name='categoryIds']").selectedIndex = -1;
      document.getElementById("categoryPreview").innerHTML = "";
    }

  });

  function updatePreview(selectName, previewId) {
    const select = document.querySelector(`select[name='${selectName}']`);
    const preview = document.getElementById(previewId);
    if (!select || !preview) return;

    const selected = [...select.selectedOptions].map(opt => opt.text);
    preview.innerHTML = selected.map(
      s => `<span class="preview-badge">${s}</span>`
    ).join("");

    preview.classList.toggle("d-none", selected.length === 0);
  }

  updatePreview("productIds", "productPreview");
  updatePreview("categoryIds", "categoryPreview");


  document.querySelector("select[name='productIds']")?.addEventListener("change", ()=> {
    updatePreview("productIds","productPreview");
  });

  document.querySelector("select[name='categoryIds']")?.addEventListener("change",()=>{
    updatePreview("categoryIds","categoryPreview")
  })


  function updateOffer() {
const form = document.getElementById("offerForm");
const formData = new FormData(form);

const data = {};
formData.forEach((value, key) => {
  if (data[key]) {
    if (!Array.isArray(data[key])) {
      data[key] = [data[key]];
    }
    data[key].push(value);
  } else {
    data[key] = value;
  }
});

  fetch("/admin/offer/<%= offer._id %>", {
    method: "PATCH",
    credentials: "same-origin", 
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify(data)
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      Swal.fire("Updated", "Offer updated successfully", "success")
        .then(() => window.location.href="/admin/offerManage");
    }
    else {
      Swal.fire("Error", "Failed to update offer","error")    
    }
  });
}
</script>

</body>
</html>

<%- include('../partials/admin/header') %>
<link rel="stylesheet" href="/css/admin/salesReport.css">
<div class="report-container">

  <h2>Sales Report</h2>

    <div style="margin:15px 0;">
      <a href="/admin/sales-report/pdf?reportType=<%= reportType %>&startDate=<%= startDate %>&endDate=<%= endDate %>"
        class="btn" 
        style="padding:10px 15px; background:#401f75; color:#fff; text-decoration:none;">
        Download PDF
      </a>

      <a href="/admin/sales-report/excel?reportType=<%= reportType %>&startDate=<%=startDate %>&endDate=<%= endDate %>"
        class="btn"
        style="padding:10px 15px; background:#1d6f42; color:#fff; text-decoration: none; margin-left:10px;"
        >
        Download Excel
      </a>
    </div>

  <form method="GET" action="/admin/sales-report" style="margin:20px 0;">
    <select name="reportType" onchange="this.form.submit()">
      <option value="">Custom</option>
      <option value="daily" <%= reportType === "daily" ? "selected" : "" %>>Daily</option>
      <option value="monthly" <%= reportType === "monthly" ? "selected" : "" %>>Monthly</option>
      <option value="yearly" <%= reportType === "yearly" ? "selected" : "" %>>Yearly</option>
    </select>
    <input type="date" name="startDate" value="<%= startDate %>"<%= reportType ? "disabled" : "" %>>
    <input type="date" name="endDate" value="<%= endDate %>" <%= reportType ? "disabled" : "" %>>
    <button type="submit">Apply</button>
  </form>

  <div class="cards">
    <div class="card">
      <h4>Total Orders</h4>
      <p><%= summary.totalOrders %></p>
    </div>
    <div class="card">
      <h4>Gross Sales</h4>
      <p>₹<%= summary.grossSales.toFixed(2) %></p>
    </div>
    <div class="card">
      <h4>Offer Discount</h4>
      <p>-₹<%= summary.offerDiscount.toFixed(2) %></p>
    </div>
    <div class="card">
      <h4>Coupon Discount</h4>
      <p>-₹<%= summary.couponDiscount.toFixed(2) %></p>
    </div>
    <div class="card">
      <h4>Net Revenue</h4>
      <p>₹<%= summary.netRevenue.toFixed(2) %></p>
    </div>
  </div>

  <div style="margin-top:25px;">
    <strong>Payment Methods:</strong>
    Razorpay: <%= paymentStats.razorpay %> |
    Wallet: <%= paymentStats.wallet %> |
    COD: <%= paymentStats.cod %>
  </div>

  <table>
    <thead>
      <tr>
        <th>Order ID</th>
        <th>Date</th>
        <th>Payment</th>
        <th>Subtotal</th>
        <th>Discount</th>
        <th>Final Amount</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length === 0) { %>
        <tr>
          <td colspan="7">No orders found</td>
        </tr>
      <% } %>

      <% orders.forEach(order => { %>
        <tr>
          <td><%= order.orderId || order._id %></td>
          <td><%= order.createdAt.toDateString() %></td>
          <td><%= order.paymentMethod %></td>
          <td>₹<%= (order.subtotal || 0).toFixed(2) %></td>
          <td>₹<%= ((order.offerDiscount || 0) + (order.discountAmount || 0)).toFixed(2) %></td>
          <td>₹<%= (order.finalAmount || 0).toFixed(2) %></td>
          <td><%= order.status %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="pagination">

  <% if (currentPage > 1) { %>
    <a href="?page=<%= currentPage - 1 %>&reportType=<%= reportType %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
      ⬅ Prev
    </a>
  <% } %>

  <% if (startPage > 1) { %>
    <a href="?page=1&reportType=<%= reportType %>&startDate=<%= startDate %>&endDate=<%= endDate %>">1</a>
    <span>...</span>
  <% } %>

  <% for (let i = startPage; i <= endPage; i++) { %>
    <a 
      href="?page=<%= i %>&reportType=<%= reportType %>&startDate=<%= startDate %>&endDate=<%= endDate %>"
      class="<%= i === currentPage ? 'active' : '' %>">
      <%= i %>
    </a>
  <% } %>

  <% if (endPage < totalPages) { %>
    <span>...</span>
    <a href="?page=<%= totalPages %>&reportType=<%= reportType %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
      <%= totalPages %>
    </a>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="?page=<%= currentPage + 1 %>&reportType=<%= reportType %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
      Next ➡
    </a>
  <% } %>

</div>


<%- include('../partials/admin/footer') %>
    
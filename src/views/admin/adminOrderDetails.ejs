<%- include('../partials/admin/header') %>

<link rel="stylesheet" href="/css/admin/orderDetails.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container">
  <h2>Order Management</h2>
  <table>
    <thead>
      <tr>
        <th>Order ID</th>
        <th>User</th>
        <th>Payment</th>
        <th>Total</th>
        <th>Status</th>
        <th>Placed On</th>
        <th>Action</th>
      </tr>
    </thead>

    <tbody>
      

      <div style="margin-bottom: 20px; display: flex; gap: 10px;">
      <form action="/admin/orders" method="GET" style="display: flex; gap: 10px; width: 100%;">
        <input 
          type="text" 
          name="search" 
          placeholder="Search by Order ID..." 
          value="<%= typeof search !== 'undefined' ? search : '' %>"
          style="
            flex: 1;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 15px;
          "
        />

        <button 
          type="submit" 
          class="btn" 
          style="
            background: #401f75; 
            padding: 10px 18px;
            border-radius: 6px;
            color: #fff;
            font-weight: 500;
          "
        >
          Search
        </button>

        <% if (typeof search !== "undefined" && search.trim() !== "") { %>
          <a 
            href="/admin/orders" 
            class="btn"
            style="
              background: #e74c3c; 
              padding: 10px 18px;
              border-radius: 6px;
              color: #fff;
              font-weight: 500;
              text-decoration: none;
            "
          >
            Clear
          </a>
        <% } %>
      </form>
    </div>


      <% orders.forEach(order => { %>
        <% 
  const returnItems = order.items.filter(
    item => item.status === "Return Requested"
  );
  const totalItems = order.items.length;
%>


<% if (returnItems.length > 0) { %>
<tr>
  <td colspan="7">
    <div style="
      background:#fff3cd;
      border:1px solid #ffeeba;
      padding:12px 16px;
      border-radius:6px;
      margin-bottom:10px;
    ">
      <strong style="color:#856404;">
        🔄 Return Requested
      </strong>

      <div style="margin-top:6px; color:#856404; font-size:14px;">
        <% if (returnItems.length === totalItems) { %>
          Entire order has been requested for return
        <% } else { %>
          <%= returnItems.length %> item(s) requested for return
        <% } %>
      </div>
    </div>
  </td>
</tr>
<% } %>

        <tr>
          <td><%= order.orderId %></td>

          <td>
            <%= order.userId ? order.userId.username : "Unknown User" %>
          </td>

          <td><%= order.paymentMethod %></td>

          <td>₹ <%= order.finalAmount %></td>

          <td>
            
              <select name="status" id="status-<%= order.orderId %>" class="status-select">
                <%statusOptions.forEach(s=>{ %>
                  <option value="<%=s %>" <%=order.status === s? "selected" : "" %> > <%=s %> </option>
                <%});%>
              </select>       
          </td>

          <td>
            <%= order.createdAt.toLocaleDateString() %>
          </td>


          <td>
              <button type="button" class="btn-update" onclick="updateOrderStatus('<%= order.orderId %>')">Update</button>
            
          </td>

          <td>
            <a
              href="/admin/orders/<%= order.orderId %>"
              style="
                background:#3498db;
                color:white;
                padding:6px 12px;
                border-radius:5px;
                text-decoration:none;
              "
            >
              View
            </a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script>
function acceptReturn(orderId, itemId) {
  Swal.fire({
    title: "Accept Return?",
    text: "This will refund the amount and restock inventory.",
    icon: "warning",
    showCancelButton: true,
    confirmButtonText: "Yes, Accept",
  }).then(result => {
    if (result.isConfirmed) {
      fetch(`/order/${orderId}/accept-return/${itemId}`, {
        method: "PATCH"
      }).then(() => location.reload());
    }
  });
}

function rejectReturn(orderId, itemId) {
  Swal.fire({
    title: "Reject Return?",
    text: "This will mark item as Delivered again.",
    icon: "warning",
    showCancelButton: true,
    confirmButtonText: "Yes, Reject",
  }).then(result => {
    if (result.isConfirmed) {
      fetch(`/order/${orderId}/reject-return/${itemId}`, {
        method: "PATCH"
      }).then(() => location.reload());
    }
  });
}

function updateOrderStatus(orderId) {
  const status = document.getElementById("status-" + orderId).value;

  fetch(`/admin/orders/${orderId}/status`, {
    method: "PATCH",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({ status })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      Swal.fire("Updated!", "Order status updated", "success")
        .then(() => location.reload());
    } else {
      Swal.fire("Error", "Failed to update status", "error");
    }
  });
}
</script>

<%- include('../partials/admin/footer') %>

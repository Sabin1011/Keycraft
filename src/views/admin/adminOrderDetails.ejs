<%- include('../partials/admin/header') %>

<link rel="stylesheet" href="/css/admin/orderDetails.css">
<div class="container">
  <h2>Order Management</h2>
  <table>
    <thead>
      <tr>
        <th>Order ID</th>
        <th>User</th>
        <th>Payment</th>
        <th>Total</th>
        <th>Status</th>
        <th>Placed On</th>
        <th>Action</th>
      </tr>
    </thead>

    <tbody>
      

      <div style="margin-bottom: 20px; display: flex; gap: 10px;">
      <form action="/admin/orders" method="GET" style="display: flex; gap: 10px; width: 100%;">
        <input 
          type="text" 
          name="search" 
          placeholder="Search by Order ID..." 
          value="<%= typeof search !== 'undefined' ? search : '' %>"
          style="
            flex: 1;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 15px;
          "
        />

        <button 
          type="submit" 
          class="btn" 
          style="
            background: #401f75; 
            padding: 10px 18px;
            border-radius: 6px;
            color: #fff;
            font-weight: 500;
          "
        >
          Search
        </button>

        <% if (typeof search !== "undefined" && search.trim() !== "") { %>
          <a 
            href="/admin/orders" 
            class="btn"
            style="
              background: #e74c3c; 
              padding: 10px 18px;
              border-radius: 6px;
              color: #fff;
              font-weight: 500;
              text-decoration: none;
            "
          >
            Clear
          </a>
        <% } %>
      </form>
    </div>


      <% orders.forEach(order => { %>
        <tr>
          <td><%= order.orderId %></td>

          <td>
            <%= order.userId ? order.userId.username : "Unknown User" %>
          </td>

          <td><%= order.paymentMethod %></td>

          <td>₹ <%= order.finalAmount %></td>

          <td>
            <form action="/admin/orders/update-status/<%= order.orderId %>" method="POST">
              <select name="status" id="" class="status-select">
                <%statusOptions.forEach(s=>{ %>
                  <option value="<%=s %>" <%=order.status === s? "selected" : "" %> > <%=s %> </option>
                <%});%>
              </select>
          </td>

          <td>
            <%= order.createdAt.toLocaleDateString() %>
          </td>


          <td>
              <button type="submit" class="btn-update">Update</button>
            </form>
          </td>

          <td>
  <a
    href="/admin/orders/<%= order.orderId %>"
    style="
      background:#3498db;
      color:white;
      padding:6px 12px;
      border-radius:5px;
      text-decoration:none;
    "
  >
    View
  </a>
</td>


        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/admin/footer') %>

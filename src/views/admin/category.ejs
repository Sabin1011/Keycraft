<%- include('../partials/admin/header') %>
<link rel="stylesheet" href="/css/admin/category.css">
<body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
          <h4 class="mb-sm-0 font-size-18">Categories</h4>
          <div class="page-title-right">
            <ol class="breadcrumb m-0">
              <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
              <li class="breadcrumb-item active">Categories</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Search and Add Button -->
    <div class="row mb-3">
      <div class="col-sm-12 col-md-6">
        <div class="search-container">


          <form action="/admin/category" method="GET" class="search-form" id="searchForm">
            <div class="search-input-wrapper">
              <i class="bx bx-search search-icon"></i>
              <input 
                type="text" 
                class="search-input form-control" 
                id="searchInput" 
                placeholder="Search categories..." 
                name="search"
                value="<%= locals.search || '' %>" />
              <i class="bx bx-x cancel-icon" onclick="clearSearch()"></i>
            </div>
            <button type="submit" class="search-button">Search</button>
          </form>



        </div>
      </div>
      <div class="col-sm-12 col-md-6 text-end">
        <a href="/admin/addCategory" style="text-decoration: none;">
          <button class="add-category-btn">
            <i class='bx bx-plus'></i> Add Category
          </button>
        </a>
      </div>
    </div>

    <!-- Success/Error Messages -->
    <% if (locals.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class='bx bx-check-circle'></i> <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <% if (locals.error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class='bx bx-error-circle'></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <!-- Category Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-body">
            <div class="table-responsive">
              <table class="user-table table align-middle table-nowrap dt-responsive nowrap w-100" id="categoryTable">
                <thead class="table-light">
                  <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 25%;">Category Name</th>
                    <th style="width: 35%;">Description</th>
                    <th style="width: 13%;">Status</th>
                    <th style="width: 18%;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (categories && categories.length > 0) { %>
                    <% categories.forEach((cat, index) => { %>
                      <tr class="<%= !cat.status ? 'soft-deleted-row' : '' %>">
                        <td><%= ((currentPage - 1) * limit) + index + 1 %></td>
                        <td>
                          <div class="category-info">
                            <div class="category-image">
                              <i class='bx bx-category' style="font-size: 20px;"></i>
                            </div>
                            <div class="category-details">
                              <span class="category-name"><%= cat.name %></span>
                            </div>
                          </div>
                        </td>
                        <td>
                          <span class="category-description"><%= cat.description %></span>
                        </td>
                        <td>
                          <span class="status-badge <%= cat.status ? 'status-active' : 'status-blocked' %>">
                            <%= cat.status ? 'Active' : 'Blocked' %>
                          </span>
                        </td>
                        <td>
                          <div class="action-icons">
                            <i class='bx bx-edit action-icon' title="Edit" 
                               onclick="editCategory('<%= cat._id %>')"></i>
                            <% if (!cat.status) { %>
                              <button class="btn btn-sm unblock-btn" 
                                      onclick="toggleBlock('<%= cat._id %>', '<%= cat.name %>', '<%= cat.status %>')">
                                Unblock
                              </button>
                            <% } else { %>
                              <button class="btn btn-sm block-btn" 
                                      onclick="toggleBlock('<%= cat._id %>', '<%= cat.name %>', '<%= cat.status %>')">
                                Block
                              </button>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5">
                        <div class="no-data">
                          <i class='bx bx-folder-open'></i>
                          <p><strong>No categories found</strong></p>
                          <% if (locals.search) { %>
                            <p>Try adjusting your search criteria</p>
                          <% } else { %>
                            <p>Start by adding your first category</p>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- Pagination -->
            <% if (totalCategories > 0) { %>
            <div class="pagination-container">
              <div class="pagination-info">
                Showing <strong><%= ((currentPage - 1) * limit) + 1 %>-<%= Math.min(currentPage * limit, totalCategories) %></strong> 
                of <strong><%= totalCategories %></strong> categories
              </div>
              <nav aria-label="Category pagination">
                <ul class="pagination">
                  <!-- Previous Button -->
                  <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="?page=<%= currentPage - 1 %><%= locals.search ? '&search=' + search : '' %>">←</a>
                  </li>

                  <% 
                    const totalPages = Math.ceil(totalCategories / limit);
                    const maxVisiblePages = 5;
                    let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
                    let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
                    
                    if (endPage - startPage < maxVisiblePages - 1) {
                      startPage = Math.max(1, endPage - maxVisiblePages + 1);
                    }
                  %>

                  <!-- Page Numbers -->
                  <% for (let i = startPage; i <= endPage; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                      <a class="page-link" href="?page=<%= i %><%= locals.search ? '&search=' + search : '' %>"><%= i %></a>
                    </li>
                  <% } %>

                  <!-- Next Button -->
                  <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="?page=<%= currentPage + 1 %><%= locals.search ? '&search=' + search : '' %>">→</a>
                  </li>
                </ul>
              </nav>
            </div>
            <% } %>

          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/admin/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <script>
    function clearSearch() {
      window.location.href = '/admin/category';
      console.log("je")
    }

    function editCategory(id) {
      window.location.href = `/admin/editCategory/${id}`;
    }

    function toggleBlock(categoryId, categoryName, currentStatus) {
      // Determine the action based on current status
      const action = currentStatus ? 'Block' : 'Unblock';
      const confirmColor = currentStatus ? '#dc3545' : '#28a745';
      const successMessage = currentStatus 
        ? 'Category has been blocked.' 
        : 'Category has been unblocked.';

      Swal.fire({
        title: `${action} this category?`,
        text: `Are you sure you want to ${action.toLowerCase()} "${categoryName}"?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: confirmColor,
        cancelButtonColor: '#6c757d',
        confirmButtonText: `Yes, ${action.toLowerCase()} it!`,
        cancelButtonText: 'Cancel'
      }).then((result) => {
        if (result.isConfirmed) {
          // Show loading
          Swal.fire({
            title: 'Processing...',
            text: 'Please wait',
            allowOutsideClick: false,
            didOpen: () => {
              Swal.showLoading();
            }
          });

          // Send AJAX request to toggle category status
          fetch(`/admin/blockCategory/${categoryId}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
            }
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              Swal.fire({
                title: action + 'ed!',
                text: successMessage,
                icon: 'success',
                timer: 1500,
                showConfirmButton: false
              }).then(() => {
                window.location.reload();
              });
            } else {
              Swal.fire('Error!', data.message || 'Something went wrong.', 'error');
            }
          })
          .catch(error => {
            console.error('Error:', error);
            Swal.fire('Error!', 'Failed to update category status.', 'error');
          });
        }
      });
    }

    // Auto-hide alerts after 5 seconds
    document.addEventListener('DOMContentLoaded', function() {
      const alerts = document.querySelectorAll('.alert');
      alerts.forEach(alert => {
        setTimeout(() => {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }, 5000);
      });

      // Show/hide cancel icon based on search input
      const searchInput = document.getElementById('searchInput');
      const cancelIcon = document.querySelector('.cancel-icon');
      
      if (searchInput && cancelIcon) {
        searchInput.addEventListener('input', function() {
          cancelIcon.style.display = this.value.length > 0 ? 'block' : 'none';
        });
        
        // Initial check
        cancelIcon.style.display = searchInput.value.length > 0 ? 'block' : 'none';
      }
    });
  </script>
</body>
</html>
<%- include('../partials/admin/header') %>

<link rel="stylesheet" href="/css/admin/singleOrderDetails.css">
<div class="container">
  <h2>Order Details</h2>

  <div class="box">
    <p><strong>Order ID:</strong> <%= order.orderId %></p>
    <p><strong>Status:</strong> <%= order.status %></p>
    <p><strong>Payment Method:</strong> <%= order.paymentMethod %></p>
    <p><strong>Payment Status:</strong> <%= order.paymentStatus %></p>
    <p><strong>Placed On:</strong> <%= order.createdAt.toLocaleString() %></p>
    <p><strong>Total Amount:</strong> ₹ <%= order.finalAmount %></p>
  </div>
  <div class="box">
    <h4>User Details</h4>
    <p><strong>Name:</strong> <%= order.userId?.username %></p>
    <p><strong>Email:</strong> <%= order.userId?.email %></p>
  </div>

  <div class="box">
    <h4>Delivery Address</h4>
    <p>
      <%= order.address.fullName %><br />
      <%= order.address.houseName %>, <%= order.address.street %><br />
      <%= order.address.city %> - <%= order.address.pincode %><br />
      Phone: <%= order.address.phone %>
    </p>
  </div>

  <div class="box">
    <h4>Ordered Items</h4>

    <% const allReturned = order.items.every(i => i.status === "Returned"); %>

    <% if (allReturned) { %>
      <div class="box" style="background:#e8f5e9;border-left:5px solid #28a745;">
        <h4 style="color:#2e7d32;">✅ Entire Order Returned</h4>
        <p>All items in this order have been returned and refunded.</p>
      </div>
    <% } %>

    <table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Variant</th>
          <th>Price</th>
          <th>Qty</th>
          <th>Status</th>
          <th>Return Action</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% order.items.forEach(item => { %>
        <tr>
          <td><%= item.product.name %></td>
          <td><%= item.variantName || "—" %></td>
          <td>₹ <%= item.price %></td>
          <td><%= item.quantity %></td>

          <td>><%=item.status %></td>

          <td>
            <% if(item.status === "Return Requested"){ %>
            <button
              style="background:#28a745; color:#fff; padding:5px 10px; border-radius:5px;"
              onclick="acceptReturn('<%= order.orderId %>', '<%= item._id %>')"
            >
              Accept
            </button>


              <button
                style="
                  background: #dc3545;
                  color: #fff;
                  border: none;
                  padding: 5px 10px;
                  border-radius: 5px;
                "
                onclick="rejectReturn('<%= order.orderId %>','<%=item.id %>')"
              >
                Reject
              </button>
            

            <% } else if(item.status === "Returned") { %>
            <span style="color: green; font-weight: 600">Returned</span>

            <% } else { %>

            <span style="color: #6c757d">—</span>

            <% } %>
          </td>


          <td>₹ <%= item.price * item.quantity %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <a
    href="/admin/orders"
    style="display: inline-block; margin-top: 15px; color: #3498db"
  >
    ← Back to Orders
  </a>
</div>

<%- include('../partials/admin/footer') %>

<script>

  function acceptReturn(orderId, itemId) {
    fetch(`/admin/order/${orderId}/accept-return/${itemId}`,{
      method: 'PATCH'
    })
    .then(res=>res.json())
    .then(data => {
      if(data.success){
           location.reload();
      }
    });
  } 

  function rejectReturn(orderId, itemId) {
    fetch(`/admin/order/${orderId}/reject-return/${itemId}`,{
      method: 'PATCH'
    })
    .then(res=>res.json())
    .then(data => {
      if(data.success){
        location.reload();
      }
    })
  }
</script>

<%- include('../partials/admin/header') %>
<link rel="stylesheet" href="/public/css/admin/userManage.css">

<body data-sidebar="dark">
  <div class="main-content">
    <div class="page-content">
      <div class="container-fluid">

        <div class="row">
          <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
              <h4 class="mb-sm-0 font-size-18">Customers</h4>
              <div class="page-title-right">
                <ol class="breadcrumb m-0">
                  <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                  <li class="breadcrumb-item active">Customers</li>
                </ol>
              </div>
            </div>
          </div>
        </div>

        <% if (locals.success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class='bx bx-check-circle'></i> <%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <% if (locals.error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class='bx bx-error-circle'></i> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <div class="row mb-3">
          <div class="col-sm-12 col-md-6">
            <div class="search-container">
              <form action="/admin/userManage" method="GET" class="search-form" id="searchForm">
                <div class="search-input-wrapper">
                  <i class="bx bx-search search-icon"></i>
                  <input 
                    type="text" 
                    class="search-input form-control" 
                    id="searchInput" 
                    placeholder="Search users..." 
                    name="search"
                    value="<%= locals.search || '' %>" 
                    autocomplete="off" />
                  <% if (locals.search && locals.search.trim() !== '') { %>
                    <i class="bx bx-x cancel-icon" onclick="clearSearch()" style="display: block;"></i>
                  <% } else { %>
                    <i class="bx bx-x cancel-icon" onclick="clearSearch()"></i>
                  <% } %>
                </div>
                <button type="submit" class="search-button">Search</button>
              </form>
            </div>
          </div>
        </div>

        <!-- User Table -->
        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-body">
                <div class="table-responsive">
                  <table class="user-table table align-middle table-nowrap dt-responsive nowrap w-100" id="customerList-table">
                    <thead class="table-light">
                      <tr>
                        <th>#</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Block/Unblock</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (users && users.length > 0) { %>
                        <% users.forEach((user, index) => { %>
                          <tr>
                            <td><%= ((currentPage - 1) * limit) + index + 1 %></td>
                            <td><%= user.username %></td>
                            <td><%= user.email %></td>
                            <td><%= user.phone || '-' %></td>
                            <td>
                              <% if (user.status) { %>
                                <span class="badge bg-success">Active</span>
                              <% } else { %>
                                <span class="badge bg-danger">Blocked</span>
                              <% } %>
                            </td>
                            <td>
                              <% if (user.status) { %>
                                <button onclick="confirmBlock('<%= user._id %>', '<%= user.username %>', true)" class="btn btn-danger btn-sm waves-effect waves-light">
                                  Block
                                </button>
                              <% } else { %>
                                <button onclick="confirmBlock('<%= user._id %>', '<%= user.username %>', false)" class="btn btn-success btn-sm waves-effect waves-light">
                                  Unblock
                                </button>
                              <% } %>
                            </td>
                          </tr>
                        <% }) %>
                      <% } else { %>
                        <tr>
                          <td colspan="6" class="text-center text-muted py-4">
                            <i class='bx bx-user-x' style="font-size: 48px; opacity: 0.3;"></i>
                            <p class="mt-2"><strong>No users found</strong></p>
                            <% if (locals.search) { %>
                              <p>Try adjusting your search criteria</p>
                            <% } %>
                          </td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>

                <!-- Pagination -->
                <% if (totalUsers > 0) { %>
                <div class="pagination-container">
                  <div class="pagination-info">
                    Showing <strong><%= ((currentPage - 1) * limit) + 1 %>-<%= Math.min(currentPage * limit, totalUsers) %></strong> 
                    of <strong><%= totalUsers %></strong> users
                  </div>
                  <nav aria-label="User pagination">
                    <ul class="pagination">
                      <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="?page=<%= currentPage - 1 %><%= locals.search ? '&search=' + search : '' %>">←</a>
                      </li>

                      <% 
                        const totalPages = Math.ceil(totalUsers / limit);
                        const maxVisiblePages = 5;
                        let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
                        let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
                        
                        if (endPage - startPage < maxVisiblePages - 1) {
                          startPage = Math.max(1, endPage - maxVisiblePages + 1);
                        }
                      %>

                      <!-- Page Numbers -->
                      <% for (let i = startPage; i <= endPage; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                          <a class="page-link" href="?page=<%= i %><%= locals.search ? '&search=' + search : '' %>"><%= i %></a>
                        </li>
                      <% } %>

                      <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="?page=<%= currentPage + 1 %><%= locals.search ? '&search=' + search : '' %>">→</a>
                      </li>
                    </ul>
                  </nav>
                </div>
                <% } %>

              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <%- include('../partials/admin/footer') %>

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
      function confirmBlock(userId, username, currentStatus) {
        const action = currentStatus ? 'Block' : 'Unblock';
        const confirmColor = currentStatus ? '#dc3545' : '#28a745';

        Swal.fire({
          title: `${action} this user?`,
          text: `Are you sure you want to ${action.toLowerCase()} "${username}"?`,
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: confirmColor,
          cancelButtonColor: "#6c757d",
          confirmButtonText: `Yes, ${action.toLowerCase()}!`,
          cancelButtonText: "Cancel"
        }).then((result) => {
          if (result.isConfirmed) {
            // Show loading
            Swal.fire({
              title: 'Processing...',
              text: 'Please wait',
              allowOutsideClick: false,
              didOpen: () => {
                Swal.showLoading();
              }
            });

            // Send AJAX request to block/unblock user
            fetch(`/admin/blockUser/${userId}`, {
              method: 'PATCH',
              headers: {
                'Content-Type': 'application/json',
              }
            })
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                Swal.fire({
                  title: action + 'ed!',
                  text: data.message,
                  icon: 'success',
                  timer: 1500,
                  showConfirmButton: false
                }).then(() => {
                  window.location.reload();
                });
              } else {
                Swal.fire('Error!', data.message || 'Something went wrong.', 'error');
              }
            })
            .catch(error => {
              console.error('Error:', error);
              Swal.fire('Error!', 'Failed to update user status.', 'error');
            });
          }
        });
      }

      function clearSearch() {
        window.location.href = '/admin/userManage';
      }

      // Auto-hide alerts after 5 seconds
      document.addEventListener('DOMContentLoaded', function() {
        const alerts = document.querySelectorAll('.alert');
        alerts.forEach(alert => {
          setTimeout(() => {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }, 5000);
        });

        // Show/hide cancel icon based on search input
        const searchInput = document.getElementById('searchInput');
        const cancelIcon = document.querySelector('.cancel-icon');
        
        if (searchInput && cancelIcon) {
          searchInput.addEventListener('input', function() {
            cancelIcon.style.display = this.value.length > 0 ? 'block' : 'none';
          });
          
          // Initial check
          cancelIcon.style.display = searchInput.value.length > 0 ? 'block' : 'none';
        }
      });
    </script>

  </div>
</body>
</html>
<%- include('../partials/admin/header') %>
<link rel="stylesheet" href="/css/admin/editProduct.css">
<body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
          <h4 class="mb-sm-0 font-size-18">Edit Product</h4>
          <div class="page-title-right">
            <ol class="breadcrumb m-0">
              <li class="breadcrumb-item"><a href="#">Ecommerce/</a></li>
              <li class="breadcrumb-item"><a href="/admin/adminProduct">Products/</a></li>
              <li class="breadcrumb-item active">Edit Product</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <form id="editProductForm" enctype="multipart/form-data" action="/admin/updateProduct/<%= product._id %>" method="post">
      <div class="row">
        <div class="col-lg-8">
          <div class="card">
            <div class="card-header">
              <h5 class="card-title">Basic Information</h5>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <label for="productName" class="form-label">Product Name<span class="required">*</span></label>
                <input type="text" name="productName" class="form-control" id="productName" 
                       value="<%= product.name %>" placeholder="Enter product name" required>
              </div>

              <div class="mb-3">
                <label for="description" class="form-label">Description<span class="required">*</span></label>
                <textarea name="description" class="form-control" id="description" rows="4" 
                          placeholder="Enter product description" required><%= product.description %></textarea>
                <div class="help-text">Provide a detailed description of the product</div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <h5 class="card-title">Stock Quantity (by Variants)</h5>
            </div>
            <div class="card-body">
              <div class="stock-variants-container" id="stockVariantsContainer">
                <% if (product.variants && product.variants.length > 0) { %>
                  <% product.variants.forEach((variant, index) => { %>
                    <div class="stock-variant-item" data-variant-index="<%= index %>">
                      <input type="text" name="variantName[]" class="form-control variant-label" 
                             value="<%= variant.name %>" placeholder="Variant name" style="flex: 0 0 150px;">
                      <input type="number" name="variantQty[]" class="form-control variant-input" 
                             value="<%= variant.quantity %>" placeholder="Enter quantity" min="0">
                      <button type="button" class="remove-variant-btn" onclick="removeVariantItem(this)">
                        Remove
                      </button>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="stock-variant-item">
                    <input type="text" name="variantName[]" class="form-control variant-label" 
                           value="Red Key" placeholder="Variant name" style="flex: 0 0 150px;">
                    <input type="number" name="variantQty[]" class="form-control variant-input" 
                           placeholder="Enter quantity" min="0" value="0">
                  </div>
                <% } %>
              </div>
              <button type="button" class="add-variant-btn mt-3" onclick="addVariant()">
                Add Custom Variant
              </button>
              <div class="help-text mt-2">Add stock quantities for different product variants</div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <h5 class="card-title">Product Images</h5>
            </div>
            <div class="card-body">
              <div class="image-upload-container" id="imageUploadContainer" 
                   onclick="document.getElementById('imageInput').click()">
                Click to upload or drag and drop
                <div class="upload-hint">PNG, JPG or JPEG (MAX. 5MB)</div>
              </div>
              <input type="file" name="images" id="imageInput" accept="image/*" multiple 
                     style="display: none;" onchange="handleImageUpload(event)">
              <div class="preview-container" id="previewContainer"></div>
              <div id="existingImagesContainer" style="display:none;">
                <% (product.images || []).forEach(function(imgUrl, i) { %>
                  <input type="hidden" class="existing-image-input" value="<%= imgUrl %>">
                <% }); %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="card">
            <div class="card-header">
              <h5 class="card-title">Pricing</h5>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <label for="price" class="form-label">Price<span class="required">*</span></label>
                <input type="number" name="price" class="form-control" id="price" 
                       value="<%= product.price %>" placeholder="Enter amount" step="1" min="0" required>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <h5 class="card-title">Category</h5>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <label for="category" class="form-label">Select Category<span class="required">*</span></label>

                <select name="category" class="form-select" id="category" required>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat._id %>" <%= product.category._id.toString() === cat._id.toString() ? 'selected' : '' %>>
                      <%= cat.name %>
                    </option>
                  <% }) %>
                </select>

              </div>
            </div>
          </div>

          
        </div>
      </div>  

      <div class="row mt-4">
        <div class="col-12">
          <div class="card">
            <div class="card-body">
              <div class="form-actions">
                <button type="button" class="btn-secondary" onclick="cancelForm()">Cancel</button>
                <button type="submit" class="btn-primary">Save Changes</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>

    <div id="cropModal" class="crop-modal">
      <div class="crop-modal-content">
        <h5>Crop Image</h5>
        <div class="crop-container">
          <img id="cropImage" src="" alt="Crop">
        </div>
        <div class="crop-actions">
          <button type="button" class="btn-secondary" onclick="closeCropModal()">Cancel</button>
          <button type="button" class="btn-primary" onclick="applyCrop()">Apply Crop</button>
        </div>
      </div>
    </div>

  <%- include('../partials/admin/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

  <script>
  // Add this complete script section to replace your existing script in the EJS file

const productId = '<%= product._id %>';

const existingInputs = Array.from(document.querySelectorAll('.existing-image-input'));
const existingImages = existingInputs.map(i => i.value);

let uploadedImages = [];
let variantCounter = 0;
let cropper = null;
let currentCropImageId = null;

window.addEventListener('DOMContentLoaded', () => {
  existingImages.forEach(imgUrl => {
    uploadedImages.push({
      id: Date.now() + Math.random(),
      url: imgUrl,
      file: null,
      existing: true
    });
  });
  renderImagePreviews();
});

function renderImagePreviews() {
  const container = document.getElementById('previewContainer');
  if (!container) return;
  container.innerHTML = uploadedImages.map(img => `
    <div class="preview-item" data-id="${img.id}">
      <img src="${img.url}" alt="Preview" class="preview-image">
      <div class="image-actions">
        <button type="button" class="crop-image" onclick="openCropModal('${img.id}')" title="Crop Image">
          <i class="fas fa-crop"></i>
        </button>
        <button type="button" class="remove-image" onclick="removeImage('${img.id}')" title="Remove Image">
          <i class="fas fa-times"></i>
        </button>
      </div>
    </div>
  `).join('');
}

function removeImage(id) {
  uploadedImages = uploadedImages.filter(img => img.id != id);
  renderImagePreviews();
}

function handleImageUpload(event) {
  const files = Array.from(event.target.files || []);
  files.forEach(file => {
    if (file.size > 5 * 1024 * 1024) {
      Swal.fire('Error', 'Image size should not exceed 5MB', 'error');
      return;
    }
    const reader = new FileReader();
    reader.onload = function(e) {
      uploadedImages.push({
        id: Date.now() + Math.random(),
        url: e.target.result,
        file: file,
        existing: false
      });
      renderImagePreviews();
    };
    reader.readAsDataURL(file);
  });
  event.target.value = '';
}


function openCropModal(imageId) {
  const image = uploadedImages.find(img => img.id == imageId);
  if (!image) return;
  
  currentCropImageId = imageId;
  const modal = document.getElementById('cropModal');
  const cropImage = document.getElementById('cropImage');
  
  cropImage.src = image.url;
  modal.style.display = 'block';

  cropImage.onload = function() {
    if (cropper) {
      cropper.destroy();
    }
    cropper = new Cropper(cropImage, {
      aspectRatio: NaN, 
      viewMode: 1,
      autoCropArea: 1,
      responsive: true,
      restore: false,
      guides: true,
      center: true,
      highlight: false,
      cropBoxMovable: true,
      cropBoxResizable: true,
      toggleDragModeOnDblclick: false,
    });
  };
}

function closeCropModal() {
  const modal = document.getElementById('cropModal');
  modal.style.display = 'none';
  if (cropper) {
    cropper.destroy();
    cropper = null;
  }
  currentCropImageId = null;
}

function applyCrop() {
  if (!cropper || !currentCropImageId) return;
  
  // Get cropped canvas
  const canvas = cropper.getCroppedCanvas({
    maxWidth: 2000,
    maxHeight: 2000,
    imageSmoothingEnabled: true,
    imageSmoothingQuality: 'high',
  });
  
 
  canvas.toBlob((blob) => {
    if (!blob) {
      Swal.fire('Error', 'Failed to crop image', 'error');
      return;
    }
    

    const file = new File([blob], `cropped_${Date.now()}.jpg`, { type: 'image/jpeg' });

    const reader = new FileReader();
    reader.onload = function(e) {
 
      const imageIndex = uploadedImages.findIndex(img => img.id == currentCropImageId);
      if (imageIndex !== -1) {
        uploadedImages[imageIndex] = {
          id: currentCropImageId,
          url: e.target.result,
          file: file,
          existing: false,
          cropped: true
        };
        renderImagePreviews();
      }
      
      closeCropModal();
      Swal.fire({
        icon: 'success',
        title: 'Image cropped successfully',
        timer: 1500,
        showConfirmButton: false
      });
    };
    reader.readAsDataURL(blob);
  }, 'image/jpeg', 0.95);
}


const uploadContainer = document.getElementById('imageUploadContainer');
if (uploadContainer) {
  ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
    uploadContainer.addEventListener(eventName, preventDefaults, false);
  });
  
  function preventDefaults(e) {
    e.preventDefault();
    e.stopPropagation();
  }
  
  ['dragenter', 'dragover'].forEach(eventName => {
    uploadContainer.addEventListener(eventName, () => {
      uploadContainer.classList.add('dragover');
    }, false);
  });
  
  ['dragleave', 'drop'].forEach(eventName => {
    uploadContainer.addEventListener(eventName, () => {
      uploadContainer.classList.remove('dragover');
    }, false);
  });
  
  uploadContainer.addEventListener('drop', (e) => {
    const dt = e.dataTransfer;
    const files = dt.files;
    document.getElementById('imageInput').files = files;
    handleImageUpload({ target: { files: files } });
  }, false);
}

function addVariant() {
  const container = document.getElementById('stockVariantsContainer');
  const newVariant = document.createElement('div');
  newVariant.className = 'stock-variant-item';
  newVariant.innerHTML = `
    <input type="text" name="variantName[]" class="form-control variant-label" 
           placeholder="Variant name" style="flex: 0 0 150px;">
    <input type="number" name="variantQty[]" class="form-control variant-input" 
           placeholder="Enter quantity" min="0" value="0">
    <button type="button" class="remove-variant-btn" onclick="removeVariantItem(this)">
      Remove
    </button>
  `;
  container.appendChild(newVariant);
}

function removeVariantItem(button) {
  button.closest('.stock-variant-item').remove();
}

function cancelForm() {
  window.location.href = '/admin/adminProduct';
}


document.getElementById('editProductForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  
  const formData = new FormData(this);
  
  formData.delete('images');
  

  uploadedImages.forEach((img, index) => {
    if (img.file) {
      formData.append('images', img.file);
    }
  });
  
  uploadedImages.filter(img => img.existing && !img.cropped).forEach(img => {
    formData.append('existingImages', img.url);
  });
  console.log('Total images:', uploadedImages.length);
  console.log('Existing unchanged:', uploadedImages.filter(img => img.existing && !img.cropped).length);
  console.log('New/Cropped:', uploadedImages.filter(img => img.file).length);
  
  try {
    const response = await fetch(this.action, {
      method: 'POST',
      body: formData
    });
    
    if (response.ok) {
      Swal.fire({
        icon: 'success',
        title: 'Product updated successfully',
        showConfirmButton: false,
        timer: 1500
      }).then(() => {
        window.location.href = '/admin/adminProduct';
      });
    } else {
      throw new Error('Update failed');
    }
  } catch (error) {
    Swal.fire({
      icon: 'error',
      title: 'Error updating product',
      text: error.message
    });
  }
});
</script>
 
</body>
</html>
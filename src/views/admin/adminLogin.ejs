<body>
    
    <div class="login-container">
        <div class="card">
            <div class="card-header">
                <div class="logo">KEYCRAFT ADMIN</div>
                <p class="mt-2 mb-0">Login to Admin Dashboard</p>
            </div>
            <div class="card-body p-4">
                
                <form id="loginForm" action="/admin/adminlogin" method="post" >
                    
                    <div class="mb-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input type="text"  class="form-control" id="email" name="email" placeholder="Email address" value="<%= email %>">
                        </div>
                        <div id="emailError" class="invalid-feedback"></div>
                        <% if (errors && errors.email) { %>
                            <div class="invalid-feedback d-block"><%= errors.email %></div>
                        <% } %>
                    </div>
                    
                    
                    <div class="mb-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input type="password" class="form-control" id="password" name="password" placeholder="Password" value="<%= password %>">
                             <span class="input-group-text" onclick="togglePassword()" style="cursor:pointer;">
                                <i id="toggleIcon" class="fas fa-eye"></i>
                            </span>
                        </div>
                        <div id="passwordError" class="invalid-feedback"></div>
                        <% if (errors && errors.password) { %>
                            <div class="invalid-feedback d-block"><%= errors.password %></div>
                        <% } %>
                    </div>
                    
                   
                    <button type="submit" class="btn btn-primary w-100">
                        Log In
                    </button>
                </form>
            </div>
        </div>
        
        <div class="text-center mt-4 text-muted">
            <small>&copy; 2025 Keycraft. All rights reserved.</small>
        </div>
    </div>

    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    
   

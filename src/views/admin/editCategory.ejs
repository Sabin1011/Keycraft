<%- include('../partials/admin/header') %>
<link rel="stylesheet" href="/css/admin/editCategory.css">
<body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
          <h4 class="mb-sm-0 font-size-18">Edit Category</h4>
          <div class="page-title-right">
            <ol class="breadcrumb m-0">
              <li class="breadcrumb-item"><a href="#">Ecommerce/</a></li>
              <li class="breadcrumb-item"><a href="/admin/categories">Categories/</a></li>
              <li class="breadcrumb-item active">Edit Category</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-lg-8 col-xl-6 mx-auto">
        <div class="card">
          <div class="card-body">


            <form id="EditCategoryForm">
              
              <div class="mb-4">
                <label for="categoryName" class="form-label">
                  Category Name <span class="required">*</span>
                </label>
                <input 
                  type="text" 
                  class="form-control" 
                  id="categoryName" 
                  name="name"
                  placeholder="Enter category name"
                  value="<%= category.name %>"
                  required
                />
                <div class="form-text">Edit category name</div>
              </div>

              <div class="mb-4">
                <label for="categoryDescription" class="form-label">
                  Category Description <span class="required">*</span>
                </label>
                <textarea 
                  class="form-control" 
                  id="categoryDescription" 
                  name="description"
                  placeholder="Enter category description"
                  rows="4"
                  required
                ><%= category.description %></textarea>
                <div class="form-text">Edit the description of the category</div>
              </div>

              <div class="btn-container">
                <button type="button" class="cancel-btn" onclick="goBack()">
                  Cancel
                </button>
                <button type="button" class="submit-btn" onclick="updateCategory()">
                  <i class='bx bx-edit'></i> Update Category
                </button>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/admin/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <script>
    function goBack() {
      window.location.href = '/admin/category';
    }

    function updateCategory(){
      const name = document.getElementById("categoryName").value;
      const description = document.getElementById("categoryDescription").value;

      fetch("/admin/category/<%= category._id %>",{
        method: "PATCH",
        headers: {
          "content-type":"application/json"
        },
        body: JSON.stringify({name, description})
      })

      .then(res=>res.json())
      .then(data =>{
        if(data.success) {
          Swal.fire("Updated!", "Category updated successfully.", "success")
          .then(()=>{
            window.location.href = "/admin/category";
          });

        } else {
          Swal.fire("Error", "Update failed", "error");
        }
        
      })
    }

  </script>
</body>
</html>

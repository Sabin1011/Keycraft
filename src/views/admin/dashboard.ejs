<%- include('../partials/admin/header') %>
<link rel="stylesheet" href="/css/admin/dashboard.css">

<div class="container-fluid">

  <!-- PAGE TITLE + FILTER -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5 mt-4">
    <h2 class="mb-0">Admin Dashboard</h2>

    <select id="filter" class="form-select w-auto">
      <option value="daily">Daily</option>
      <option value="month" selected>Monthly</option>
      <option value="year">Yearly</option>
    </select>
  </div>

  <!-- SALES OVERVIEW - Main chart (more prominence) -->
  <div class="card mb-5 shadow-sm">
    <div class="card-header">📊 Sales Overview</div>
    <div class="card-body p-4 p-lg-5">
      <canvas id="salesChart" height="140"></canvas>
    </div>
  </div>

  <!-- TWO COLUMN SECTION -->
  <div class="row g-4 mb-5">

    <!-- PIE CHART -->
    <div class="col-lg-6">
      <div class="card h-100 shadow-sm">
        <div class="card-header">📈 Sales Distribution</div>
        <div class="card-body d-flex align-items-center justify-content-center p-4 p-lg-5">
          <canvas id="salesPieChart"></canvas>
        </div>
      </div>
    </div>

    <!-- TOP PRODUCTS -->
    <div class="col-lg-6">
      <div class="card h-100 shadow-sm">
        <div class="card-header">🔥 Top 10 Products</div>
        <ul class="list-group list-group-flush">
          <% bestProducts.forEach((p, i) => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
              <span><%= i + 1 %>. <%= p.name %></span>
              <span class="badge bg-dark rounded-pill px-3 py-2"><%= p.totalSold %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>

  </div>

  <!-- CATEGORIES - Full width -->
  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header">🏷️ Top 10 Categories</div>
        <ul class="list-group list-group-flush">
          <% bestCategories.forEach((c, i) => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
              <span><%= i + 1 %>. <%= c._id %></span>
              <span class="badge bg-secondary rounded-pill px-3 py-2"><%= c.totalSold %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
// ── Your original JavaScript remains completely unchanged ──
const ctx = document.getElementById("salesChart").getContext("2d");

const salesChart = new Chart(ctx, {
  type: "bar",
  data: {
    labels: [],
    datasets: [{
      label: "Total Sales (₹)",
      data: [],
      backgroundColor: "#2c3e50"
    }]
  },
  options: {
    responsive: true,
    scales: { y: { beginAtZero: true } }
  }
});

async function loadChart(filter) {
  const res = await fetch(`/admin/sales-data?filter=${filter}`);
  const data = await res.json();

  salesChart.data.labels = data.labels;
  salesChart.data.datasets[0].data = data.values;
  salesChart.update();
}

// Initial load (monthly)
loadChart("month");

document.getElementById("filter").addEventListener("change", (e) => {
  loadChart(e.target.value);
});

const pieCtx = document.getElementById("salesPieChart").getContext("2d");

const salesPieChart = new Chart(pieCtx, {
  type: "pie",
  data: {
    labels: [],
    datasets: [{
      data: [],
      backgroundColor: [
        "#1abc9c",
        "#3498db",
        "#9b59b6",
        "#f1c40f",
        "#e67e22",
        "#e74c3c"
      ]
    }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: {
        position: "bottom"
      }
    }
  }
});

async function loadPieChart(filter) {
  const res = await fetch(`/admin/sales-data?filter=${filter}`);
  const data = await res.json();

  salesPieChart.data.labels = data.labels;
  salesPieChart.data.datasets[0].data = data.values;
  salesPieChart.update();
}

loadPieChart("month");

document.getElementById("filter").addEventListener("change", (e) => {
  loadPieChart(e.target.value);
});
</script>

<%- include('../partials/admin/footer') %>
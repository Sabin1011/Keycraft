<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password - KeyCraft</title>

    <link
      href="https://fonts.googleapis.com/css?family=Questrial|Raleway:700,900"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Questrial", sans-serif;
        background: #f5f5f5;
        color: #222;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
      }

      .breadcrumb {
        padding: 15px 0;
        background: #fff;
        border-bottom: 1px solid #e5e5e5;
      }

      .breadcrumb a {
        color: #666;
        text-decoration: none;
        font-size: 13px;
        transition: color 0.3s;
      }

      .breadcrumb a:hover {
        color: #222;
      }

      .breadcrumb span {
        color: #999;
        margin: 0 8px;
      }

      .change-password-section {
        padding: 80px 0;
        min-height: calc(100vh - 400px);
        display: flex;
        align-items: center;
      }

      .change-password-container {
        max-width: 550px;
        margin: 0 auto;
        width: 100%;
      }

      .change-password-form {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 50px;
      }

      .form-icon {
        width: 80px;
        height: 80px;
        background: #f5f5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
      }

      .form-icon i {
        font-size: 36px;
        color: #666;
      }

      .form-title {
        font-size: 28px;
        font-family: "Raleway", sans-serif;
        font-weight: 900;
        text-transform: lowercase;
        margin-bottom: 15px;
        text-align: center;
      }

      .form-description {
        text-align: center;
        color: #666;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 35px;
      }

      .form-group {
        margin-bottom: 25px;
        position: relative;
      }

      .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        text-transform: lowercase;
        margin-bottom: 8px;
        color: #222;
      }

      .password-input-wrapper {
        position: relative;
      }

      .form-input {
        width: 100%;
        padding: 15px 50px 15px 18px;
        border: 2px solid #e5e5e5;
        border-radius: 5px;
        font-size: 14px;
        font-family: "Questrial", sans-serif;
        transition: all 0.3s;
      }

      .form-input:focus {
        outline: none;
        border-color: #222;
      }

      .toggle-password {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #999;
        font-size: 16px;
        padding: 5px;
        transition: color 0.3s;
      }

      .toggle-password:hover {
        color: #222;
      }

      .btn {
        width: 100%;
        padding: 18px 30px;
        border: none;
        font-size: 14px;
        text-transform: lowercase;
        cursor: pointer;
        border-radius: 5px;
        transition: all 0.3s;
        font-family: "Questrial", sans-serif;
        font-weight: 600;
        margin-bottom: 15px;
      }

      .btn-primary {
        background: #222;
        color: #fff;
      }

      .btn-primary:hover:not(:disabled) {
        background: #000;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
      }

      .btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .btn-secondary {
        background: #fff;
        color: #222;
        border: 2px solid #222;
        padding: 16px 28px;
      }

      .btn-secondary:hover {
        background: #222;
        color: #fff;
      }

      .error-message {
        background: #fee;
        border: 1px solid #fcc;
        color: #c33;
        padding: 12px;
        border-radius: 5px;
        margin-bottom: 20px;
        font-size: 13px;
        text-align: center;
      }

      .error-message.active {
        animation: fadeIn 0.3s;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .info-box {
        background: #f9f9f9;
        border-left: 4px solid #666;
        padding: 15px 20px;
        margin-top: 25px;
        border-radius: 5px;
      }

      .info-box p {
        font-size: 13px;
        color: #666;
        line-height: 1.6;
        margin: 0;
      }

      .back-to-profile {
        text-align: center;
        margin-top: 25px;
        font-size: 14px;
        color: #666;
      }

      .back-to-profile a {
        color: #222;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.3s;
      }

      .back-to-profile a:hover {
        color: #666;
      }

      @media (max-width: 768px) {
        .change-password-form {
          padding: 35px 25px;
        }

        .form-title {
          font-size: 24px;
        }
      }
    </style>
  </head>
  <body>
    <section class="breadcrumb">
      <div class="container">
        <a href="/home">home</a>
        <span>/</span>
        <a href="/profile">my profile</a>
        <span>/</span>
        <span style="color: #222">change password</span>
      </div>
    </section>

    <section class="change-password-section">
      <div class="container">
        <div class="change-password-container">
          <div class="change-password-form">
            <div class="form-icon">
              <i class="fa fa-lock"></i>
            </div>

            <h2 class="form-title">change your password</h2>

            <p class="form-description">
              enter your current password and choose a new strong password to
              update your account security.
            </p>
            
            <% if (errors?.general) { %>
            <div class="error-message active" style="color: red;"><%= errors.general %></div>
            <% } %>

            <form
              action="/profile/change-password"
              method="POST"
              id="changePasswordForm"
            >
              <div class="form-group">
                <label for="currentPassword" class="form-label"
                  >current password</label
                >
                <div class="password-input-wrapper">
                  <input
                    type="password"
                    name="currentPassword"
                    id="currentPassword"
                    class="form-input"
                    placeholder="enter your current password"
                  />

                  <button
                    type="button"
                    class="toggle-password"
                    onclick="togglePassword('currentPassword')"
                  >
                    <i class="fa fa-eye" id="currentPassword-icon"></i>
                  </button>
                </div>
                <div class="field-error" style="color: red;">
                  <%= errors?.currentPassword || "" %>
                </div>
              </div>

              <div class="form-group">
                <label for="newPassword" class="form-label">new password</label>
                <div class="password-input-wrapper">
                  <input
                    type="password"
                    name="newPassword"
                    id="newPassword"
                    class="form-input"
                    placeholder="enter new password"
                  />
                  <button
                    type="button"
                    class="toggle-password"
                    onclick="togglePassword('newPassword')"
                  >
                    <i class="fa fa-eye" id="newPassword-icon"></i>
                  </button>
                </div>
                <div class="field-error" style="color: red;"><%= errors?.newPassword || "" %></div>
              </div>

              <div class="form-group">
                <label for="confirmPassword" class="form-label"
                  >confirm new password</label
                >
                <div class="password-input-wrapper">
                  <input
                    type="password"
                    name="confirmPassword"
                    id="confirmPassword"
                    class="form-input"
                    placeholder="re-enter new password"
                  />
                  <button
                    type="button"
                    class="toggle-password"
                    onclick="togglePassword('confirmPassword')"
                  >
                    <i class="fa fa-eye" id="confirmPassword-icon"></i>
                  </button>
                </div>
                <div class="field-error" style="color: red;">
                  <%= errors?.confirmPassword || "" %>
                </div>
              </div>

              <button type="submit" class="btn btn-primary" id="submitBtn">
                <i class="fa fa-check"></i> update password
              </button>

              <button
                type="button"
                class="btn btn-secondary"
                onclick="window.location.href='/profile'"
              >
                <i class="fa fa-times"></i> cancel
              </button>
            </form>

            <div class="info-box">
              <p>
                <i class="fa fa-info-circle"></i> <b>security tip:</b> use a mix
                of uppercase, lowercase, numbers & symbols for a strong
                password.
              </p>
            </div>

            <div class="back-to-profile">
              need help? <a href="/support">contact support</a>
            </div>
          </div>
        </div>
      </div>
    </section>
    
          <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>




    // Existing togglePassword function remains the same
    function togglePassword(fieldId) {
        const input = document.getElementById(fieldId);
        const icon = document.getElementById(fieldId + "-icon");

        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("fa-eye", "fa-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("fa-eye-slash", "fa-eye");
        }
    }

    // --- New AJAX Submission Logic ---

    const form = document.getElementById("changePasswordForm");
    const submitBtn = document.getElementById("submitBtn");
    
    // Function to clear previous inline errors
    function clearErrors() {
        document.querySelectorAll('.field-error').forEach(el => el.textContent = '');
        document.querySelector('.error-message')?.remove(); // Clear general error box if present
    }

    // Function to display new inline errors
    function displayErrors(errors) {
        clearErrors();
        
        // Display field-specific errors
        for (const key in errors) {
            const errorElement = document.querySelector(`.form-group input[name="${key}"]`)
                .closest('.form-group')
                .querySelector('.field-error');
            
            if (errorElement) {
                errorElement.textContent = errors[key];
            }
        }
    }

    if (form) {
        form.addEventListener("submit", async function(e) {
            e.preventDefault(); // Stop default form submission
            
            const originalBtnHtml = submitBtn.innerHTML;

            clearErrors(); // Clear all previous errors

            // 1. Set Loading State
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> updating...';

            // 2. Gather form data
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            try {
                // 3. Send AJAX Request
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const responseData = await response.json();

                if (response.ok && responseData.success) {
                    // 4. Success: Show SWAL and Redirect
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: responseData.message,
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.href = responseData.redirectUrl;
                    });

                } else if (response.status === 400 && responseData.errors) {
                    // 5. Validation Failure (400 Bad Request)
                    displayErrors(responseData.errors);
                    
                    Swal.fire({
                        icon: 'warning',
                        title: 'Validation Failed',
                        text: responseData.message || 'Please correct the highlighted errors.',
                        confirmButtonColor: '#222'
                    });

                } else {
                    // 6. Other Errors (401, 404, 500)
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: responseData.message || 'An unexpected error occurred.',
                        confirmButtonColor: '#dc3545'
                    });
                }

            } catch (error) {
                console.error('AJAX Submission Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Network Error',
                    text: 'Could not connect to the server.',
                    confirmButtonColor: '#dc3545'
                });
            } finally {
                // 7. Restore button state
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnHtml;
            }
        });
    }

     
      function togglePassword(fieldId) {
        const input = document.getElementById(fieldId);
        const icon = document.getElementById(fieldId + "-icon");

        if (input.type === "password") {
          input.type = "text";
          icon.classList.replace("fa-eye", "fa-eye-slash");
        } else {
          input.type = "password";
          icon.classList.replace("fa-eye-slash", "fa-eye");
        }
      }

    
      document
        .getElementById("changePasswordForm")
        .addEventListener("submit", function () {
          const submitBtn = document.getElementById("submitBtn");
          submitBtn.disabled = true;
          submitBtn.innerHTML =
            '<i class="fa fa-spinner fa-spin"></i> updating...';
        });
    </script>
  </body>
</html>

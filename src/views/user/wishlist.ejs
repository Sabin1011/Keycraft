<%- include('../partials/user/header') %>

<link rel="stylesheet" href="/css/user/wishlist.css">

<!-- Header -->
<section class="page-header">
  <h1>Wishlist</h1>
</section>


<div class="container">

  <% if (!products || products.length === 0) { %>
    <div class="empty-state">
      <i class="fa fa-heart-o"></i>
      <h3>Your wishlist is empty</h3>
      <p>Add products you love and access them anytime.</p>
      <a href="/shop" class="btn btn-view">Continue Shopping</a>
    </div>

  <% } else { %>

    <div class="wishlist-grid">
      <% products.forEach(product => { %>
                <%

        const prod = product.productId;
        const selectedVariant = prod?.variants?.find(
          v=> v._id.toString() === product.variantId?.toString()
        );
        %>

        <div class="product-card">

          <div class="product-image">
              <% if (product.productId && product.productId.images && product.productId.images.length > 0) { %>
                  <img src="<%= product.productId.images[0] %>" alt="<%= product.productId.name %>">
              <% } else { %>
                  <img src="/images/default-product.png" alt="Unavailable Product">
              <% } %>
          </div>


          <div class="product-info">
            <div class="product-name"><%= product.productId?.name %></div>

            <div class="product-variant">

            <% if (selectedVariant) { %>
                Variant: <strong><%= selectedVariant.name %></strong>
            <% } else { %>
                Variant: <strong>Default</strong>
            <% } %>
          </div>

            <div class="product-price">
                ₹<%= ((product.productId.salePrice || product.productId.price) || 0).toFixed(2) %>
            </div>

            <div class="product-actions">

              <a href="/singleProduct/<%= product.productId._id %>?variant=<%=product.variantId %>" class="btn btn-view">
                View Details
              </a>

              <form action="/cart/add/<%= product.productId?._id %>" method="POST" style="display:inline;">
                

                <input type="hidden" name="variantId" value="<%= product.variantId %>">

                <%  
                  const p = product.productId;
                  const isBlocked = !p?.status || !p?.category?.status;
                  const isOutOfStock = p?.totalStock <= 0;
                %>

                <% if (isBlocked) { %>

                    <button class="btn btn-cart" disabled>
                      Unavailable
                    </button>

                <% } else if (isOutOfStock) { %>

                    <button class="btn btn-cart" disabled>
                      Out of Stock
                    </button>

                <% } else { %>

                    <button class="btn btn-cart" type="submit">
                      Add to Cart
                    </button>

                <% } %>

              </form>


              <button class="btn btn-remove" onclick="removeFromWishlist('<%= product.productId._id %>', this)">Remove</button>

            </div>
          </div>

        </div>


      <% }) %>

<%
  let hasOutOfStockOrUnavailable = false;

  products.forEach(item => {
    const p = item.productId;

    if (!p?.status || !p?.category?.status || p?.totalStock <= 0) {
      hasOutOfStockOrUnavailable = true;
    }
  });
%>


    </div>

<div class="add-all-container">
  <form action="/wishlist/add-all-to-cart" method="POST">
    <button 
      class="btn-add-all" 
      type="submit"
      <%= hasOutOfStockOrUnavailable ? "disabled style='opacity:0.6; cursor:not-allowed;'" : "" %>
    >
      Add All to Cart
    </button>
  </form>

  <% if (hasOutOfStockOrUnavailable) { %>
    <p style="color: red; margin-top: 12px; font-size: 14px;">
      Some items in your wishlist are unavailable or out of stock.
      Remove them to enable "Add All to Cart".
    </p>
  <% } %>
</div>

  <% } %>

</div>
<script>
  async function removeFromWishlist(productId, button) {
    try {
        const res = await fetch(`/wishlist/remove/${productId}`, {
            method: 'DELETE',
            
        });
        const data = await res.json();

        if (data.success) {
            // Remove the product card from DOM
            const card = button.closest('.product-card');
            if (card) card.remove();
        } else {
            alert(data.message || "Failed to remove");
        }
    } catch (err) {
        console.error(err);
        alert("Error removing product");
    }
}

</script>

<%- include('../partials/user/footer') %>
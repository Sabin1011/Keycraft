<%- include('../partials/user/header') %>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: "Questrial", sans-serif;
    background: #fafafa;
    color: #1a1a1a;
  }

  /* Page Header */
  .page-header {
    padding: 80px 20px 60px;
    text-align: center;
    background: #fff;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 60px;
  }
  .page-header h1 {
    font-size: 32px;
    font-weight: 300;
    letter-spacing: 2px;
    color: #1a1a1a;
    text-transform: uppercase;
  }
  .page-header::after {
    content: '';
    display: block;
    width: 60px;
    height: 2px;
    background: #1a1a1a;
    margin: 20px auto 0;
  }

  /* Main container */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px 100px;
  }

  /* Wishlist Grid */
  .wishlist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 40px;
  }

  /* Product card redesign */
  .product-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    transition: all 0.3s ease;
    position: relative;
  }
  .product-card:hover {
    border-color: #1a1a1a;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .product-image {
    height: 320px;
    overflow: hidden;
    background: #f8f8f8;
    position: relative;
  }
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: 0.6s ease;
  }
  .product-card:hover img {
    transform: scale(1.05);
  }

  .product-info {
    padding: 30px 25px;
  }

  .product-name {
    font-size: 16px;
    font-weight: 400;
    margin-bottom: 12px;
    color: #1a1a1a;
    letter-spacing: 0.5px;
    text-transform: capitalize;
    min-height: 40px;
  }

  .product-price {
    font-size: 18px;
    font-weight: 500;
    color: #1a1a1a;
    margin-bottom: 25px;
    letter-spacing: 0.5px;
  }

  /* Action Buttons */
  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn {
    padding: 12px 24px;
    border: 1px solid #1a1a1a;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: block;
    text-align: center;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    background: transparent;
  }

  .btn-view {
    background: #1a1a1a;
    color: #fff;
    border-color: #1a1a1a;
  }
  .btn-view:hover {
    background: #333;
    border-color: #333;
  }

  .btn-cart {
    background: transparent;
    color: #1a1a1a;
    border-color: #1a1a1a;
  }
  .btn-cart:hover {
    background: #1a1a1a;
    color: #fff;
  }

  .btn-remove {
    background: transparent;
    color: #666;
    border-color: #d0d0d0;
    font-size: 10px;
    padding: 10px;
  }
  .btn-remove:hover {
    background: #1a1a1a;
    color: #fff;
    border-color: #1a1a1a;
  }

  .btn:disabled {
    background: #f5f5f5;
    color: #999;
    border-color: #e0e0e0;
    cursor: not-allowed;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 120px 20px;
    color: #666;
  }
  .empty-state i {
    font-size: 60px;
    color: #d0d0d0;
    margin-bottom: 30px;
  }
  .empty-state h3 {
    font-size: 24px;
    font-weight: 300;
    margin-bottom: 12px;
    color: #1a1a1a;
    letter-spacing: 1px;
  }
  .empty-state p {
    font-size: 14px;
    color: #999;
    margin-bottom: 30px;
  }
  .empty-state .btn-view {
    display: inline-block;
    padding: 14px 40px;
    font-size: 12px;
  }

  /* Add all to cart button */
  .add-all-container {
    margin-top: 60px;
    text-align: center;
    padding-top: 60px;
    border-top: 1px solid #e5e5e5;
  }
  .btn-add-all {
    padding: 16px 50px;
    font-size: 12px;
    background: #1a1a1a;
    color: #fff;
    border: 1px solid #1a1a1a;
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }
  .btn-add-all:hover {
    background: #333;
    border-color: #333;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 20px 80px;
    }
    .page-header {
      padding: 60px 20px 40px;
    }
    .page-header h1 { 
      font-size: 24px; 
    }
    .wishlist-grid { 
      grid-template-columns: 1fr; 
      gap: 30px;
    }
    .product-image {
      height: 280px;
    }
  }
</style>


<!-- Header -->
<section class="page-header">
  <h1>Wishlist</h1>
</section>


<div class="container">

  <% if (!products || products.length === 0) { %>
    <div class="empty-state">
      <i class="fa fa-heart-o"></i>
      <h3>Your wishlist is empty</h3>
      <p>Add products you love and access them anytime.</p>
      <a href="/shop" class="btn btn-view">Continue Shopping</a>
    </div>

  <% } else { %>

    <div class="wishlist-grid">
      <% products.forEach(product => { %>
        <div class="product-card">

          <div class="product-image">
              <% if (product.productId && product.productId.images && product.productId.images.length > 0) { %>
                  <img src="<%= product.productId.images[0] %>" alt="<%= product.productId.name %>">
              <% } else { %>
                  <img src="/images/default-product.png" alt="Unavailable Product">
              <% } %>
          </div>


          <div class="product-info">
            <div class="product-name"><%= product.productId?.name %></div>

            <div class="product-price">
                ₹<%= ((product.productId.salePrice || product.productId.price) || 0).toFixed(2) %>
            </div>


            <div class="product-actions">

              <a href="/singleProduct/<%= product._id %>" class="btn btn-view">
                View Details
              </a>

              <form action="/cart/add/<%= product.productId?._id %>" method="POST" style="display:inline;">

                <% 
                  const p = product.productId;
                  const isBlocked = !p?.status || !p?.category?.status;
                  const isOutOfStock = p?.totalStock <= 0;
                %>

                <% if (isBlocked) { %>

                    <button class="btn btn-cart" disabled>
                      Unavailable
                    </button>

                <% } else if (isOutOfStock) { %>

                    <button class="btn btn-cart" disabled>
                      Out of Stock
                    </button>

                <% } else { %>

                    <button class="btn btn-cart" type="submit">
                      Add to Cart
                    </button>

                <% } %>

              </form>


              <button class="btn btn-remove" onclick="removeFromWishlist('<%= product.productId._id %>', this)">Remove</button>

            </div>
          </div>

        </div>
      <% }) %>
    </div>

    <!-- Add All to Cart Button -->
    <div class="add-all-container">
      <form action="/wishlist/add-all-to-cart" method="POST">
        <button class="btn-add-all" type="submit">
          Add All to Cart
        </button>
      </form>
    </div>

  <% } %>

</div>
<script>
  async function removeFromWishlist(productId, button) {
    try {
        const res = await fetch(`/wishlist/remove/${productId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();

        if (data.success) {
            // Remove the product card from DOM
            const card = button.closest('.product-card');
            if (card) card.remove();
        } else {
            alert(data.message || "Failed to remove");
        }
    } catch (err) {
        console.error(err);
        alert("Error removing product");
    }
}

</script>

<%- include('../partials/user/footer') %>
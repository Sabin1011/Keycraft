<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - KeyCraft</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Questrial|Raleway:700,900" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/user/register.css">
</head>
<body>
    <div class="register-container">
        <a href="/" class="logo" style="margin-left: 170px;">key<span>craft</span></a>

        <div class="register-content">
            <h1 class="register-title">create account</h1>

            
            <div class="error-message <%= generalError ? 'show' : '' %>" id="errorMessage">
                <i class="fa fa-exclamation-circle"></i> <%= generalError || '' %>
            </div>

            <form id="registerForm" method="post" novalidate>
                <div class="input-wrapper">
                    <label>Username</label>
                    <input 
                        type="text" 
                        id="name" 
                        name="username" 
                        placeholder="your name" 
                        value="<%= oldInput?.username || '' %>" 
                         
                    >
                    <% if (errors?.username) { %>
                        <p class="input-error"><%= errors.username %></p>
                    <% } %>
                </div>

                <div class="input-wrapper">
                    <label>Email</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        placeholder="your email" 
                        value="<%= oldInput?.email || '' %>" 
                         
                    >
                    <% if (errors?.email) { %>
                        <p class="input-error"><%= errors.email %></p>
                    <% } %>
                </div>

                <div class="input-wrapper">
                    <label>Phone</label>
                    <input 
                        type="tel" 
                        id="phone" 
                        name="phone" 
                        placeholder="phone number" 
                        value="<%= oldInput?.phone || '' %>" 
                         
                    >
                    <% if (errors?.phone) { %>
                        <p class="input-error"><%= errors.phone %></p>
                    <% } %>
                </div>

                <div class="input-wrapper password-wrapper">
                    <label>Password</label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        placeholder="enter password" 
                        value="<%= oldInput?.password || '' %>" 
                         
                    >

                    <i class="fa fa-eye eye-toggle" onclick="togglePassword('password', this)"></i>

                    <% if (errors?.password) { %>
                        <p class="input-error"><%= errors.password %></p>
                    <% } %>
                </div>

                <div class="input-wrapper password-wrapper">
                    <label>Confirm Password</label>
                    <input 
                        type="password" 
                        id="confirmPassword" 
                        name="confirm_password" 
                        placeholder="repeat password" 
                        value="<%= oldInput?.confirm_password || '' %>" 
                         
                    >

                    <i class="fa fa-eye eye-toggle" onclick="togglePassword('confirmPassword', this)"></i>

                    <% if (errors?.confirmPassword) { %>
                        <p class="input-error"><%= errors.confirmPassword %></p>
                    <% } %>
                </div>

                <div class="input-wrapper">
                    <label>Referral Code (Optional)</label>
                    <input 
                        type="text"
                        name="referralCode"
                        placeholder="Enter referral code"
                        value="<%= oldInput?.referralCode || '' %>"
                    >
                </div>


                <!-- Checkbox (Fixed!) -->
                <div class="checkbox-wrapper">
                    <label class="checkbox-entry">
                        <input type="checkbox" name="agree" required>
                        <span>I agree to the <a href="/privacy-policy">privacy policy</a> and <a href="/terms">terms of service</a></span>
                    </label>
                    <% if (errors?.agree) { %>
                        <p class="input-error"><%= errors.agree %></p>
                    <% } %>
                </div>

                <button type="submit" class="btn btn-primary" id="submitBtn">
                    create account
                </button>
            </form>
            
            <div class="divider">
                <span>or</span>
            </div>
            
            <button class="btn btn-secondary" onclick="handleGoogleSignIn()">
                <svg width="18" height="18" viewBox="0 0 18 18">
                    <path fill="#4285F4" d="M16.51 8H8.98v3h4.3c-.18 1-.74 1.48-1.6 2.04v2.01h2.6a7.8 7.8 0 0 0 2.38-5.88c0-.57-.05-.66-.15-1.18z"/>
                    <path fill="#34A853" d="M8.98 17c2.16 0 3.97-.72 5.3-1.94l-2.6-2a4.8 4.8 0 0 1-7.18-2.54H1.83v2.07A8 8 0 0 0 8.98 17z"/>
                    <path fill="#FBBC05" d="M4.5 10.52a4.8 4.8 0 0 1 0-3.04V5.41H1.83a8 8 0 0 0 0 7.18l2.67-2.07z"/>
                    <path fill="#EA4335" d="M8.98 4.18c1.17 0 2.23.4 3.06 1.2l2.3-2.3A8 8 0 0 0 1.83 5.4L4.5 7.49a4.77 4.77 0 0 1 4.48-3.3z"/>
                </svg>
                continue with google
            </button>

            <div class="login-link">
                already have an account? <a href="/login">log in</a>
            </div>
        </div>
    </div>

    <script>
        document.getElementById("registerForm").addEventListener("submit", (event) => {

            document.querySelectorAll(".input-error").forEach(e=>e.textContent = "");

            const email = document.getElementById("email").value;
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            if (!email || !password) {
                alert("Please fill all fields");
            };

            if(password.length<6){
                alert("Password must be of atleast 6 characters");
            };
        });
        
        function togglePassword(inputId, icon) {
            const input = document.getElementById(inputId);

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
        
        function handleGoogleSignIn() {
            const submitBtn = event.target;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner" style="border-color: rgba(0,0,0,0.3); border-top-color: #222;"></span> connecting...';
            
            setTimeout(() => {
                window.location.href = '/auth/google';
            }, 1000);
        }

        window.addEventListener('load', () => {
            document.getElementById('name').focus();
        });
    </script>
</body>
</html>
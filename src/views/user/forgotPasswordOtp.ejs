<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify OTP - KeyCraft</title>

    <link
      href="https://fonts.googleapis.com/css?family=Questrial|Raleway:700,900"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
      rel="stylesheet"
    />


    <link rel="stylesheet" href="/css/user/forgotPasswordOtp.css">
  </head>

  <body>
    <div class="otp-container">
      <a href="/" class="logo" style="margin-left: 170px"
        >key<span>craft</span></a
      >

      <div class="otp-content">
        <div class="otp-icon">
          <i class="fa fa-key"></i>
        </div>

        <h1 class="otp-title">reset your password</h1>
        <p class="otp-subtitle">we've sent a 4-digit code to</p>
        <p class="otp-email" id="userEmail"><%= email || 'your email' %></p>

        <form id="otpForm" method="POST" action="/forgot-password/verify-otp">
          <input type="hidden" name="email" value="<%= email %>" />

          <input
            type="text"
            name="otp"
            id="otpInput"
            class="otp-input"
            maxlength="4"
            autocomplete="off"
            inputmode="numeric"
            pattern="\d*"
            placeholder="____"
            required
          />

          <% if (typeof error !== 'undefined' && error) { %>
          <p style="color: #e74c3c; font-size: 14px; margin-top: 14px">
            <%= error %>
          </p>
          <% } %>

          <div class="otp-timer" id="timerDisplay">
            <i class="fa fa-clock-o"></i>
            <span
              >code expires in
              <span class="timer-count" id="timer">05:00</span></span
            >
          </div>

          <div class="resend-section">
            didn't receive the code?
            <a href="/forgot-password/resend-otp" class="resend-link"
              >resend otp</a
            >
          </div>

          <button type="submit" class="btn btn-primary" id="verifyBtn">
            verify & continue
          </button>
        </form>

        <button
          type="button"
          class="btn btn-secondary"
          onclick="window.location.href='/forgot-password'"
        >
          change email
        </button>

        <div class="back-link">
          <a href="/login"><i class="fa fa-arrow-left"></i> back to login</a>
        </div>
      </div>
    </div>

    <script>
      window.addEventListener("load", () => {
        document.getElementById("otpInput").focus();
      });

      let timeLeft = 300;
      const timerElement = document.getElementById("timer");

      const countdown = setInterval(() => {
        timeLeft--;
        const minutes = String(Math.floor(timeLeft / 60)).padStart(2, "0");
        const seconds = String(timeLeft % 60).padStart(2, "0");
        timerElement.textContent = `${minutes}:${seconds}`;

        if (timeLeft <= 0) {
          clearInterval(countdown);
          timerElement.textContent = "expired";
          timerElement.style.color = "#e74c3c";
          document.getElementById("otpInput").disabled = true;
          document.getElementById("verifyBtn").disabled = true;
        }
      }, 1000);
    </script>
  </body>
</html>

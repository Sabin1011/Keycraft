<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify OTP - KeyCraft</title>

    <link
      href="https://fonts.googleapis.com/css?family=Questrial|Raleway:700,900"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
      rel="stylesheet"
    />

    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: "Questrial", sans-serif;
        background: #f5f5f5;
        color: #222;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .otp-container {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 40px 50px 50px;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        position: relative;
      }

      .logo {
        font-size: 24px;
        font-weight: 900;
        font-family: "Raleway", sans-serif;
        color: #222;
        text-decoration: none;
        position: absolute;
        top: 20px;
        left: 30px;
      }

      .logo span { color: #666; }

      .otp-content { margin-top: 40px; text-align: center; }

      .otp-icon {
        width: 80px; height: 80px;
        background: #f5f5f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
      }

      .otp-icon i { font-size: 36px; color: #222; }

      .otp-title {
        font-size: 32px;
        font-family: "Raleway", sans-serif;
        font-weight: 900;
        text-transform: lowercase;
        margin-bottom: 15px;
      }

      .otp-subtitle { color: #666; font-size: 15px; line-height: 1.6; margin-bottom: 10px; }

      .otp-email { color: #222; font-weight: 600; margin-bottom: 40px; }

      .otp-input {
        width: 180px; height: 60px;
        border: 2px solid #e5e5e5;
        border-radius: 8px;
        text-align: center;
        font-size: 24px;
        font-family: "Raleway", sans-serif;
        font-weight: 700;
        letter-spacing: 10px;
        outline: none;
        transition: all 0.3s;
      }

      .otp-input:focus {
        border-color: #222;
        transform: scale(1.05);
      }

      .otp-input.error {
        border-color: #e74c3c;
        animation: shake 0.5s;
      }

      .otp-timer { margin-top: 30px; }

      .resend-section { margin: 20px auto; }

      .resend-link { color: #222; text-decoration: underline; font-weight: 600; }

      .btn {
        width: 100%;
        padding: 18px 30px;
        border: none;
        font-size: 14px;
        text-transform: lowercase;
        cursor: pointer;
        border-radius: 5px;
        transition: all 0.3s;
        font-family: "Questrial", sans-serif;
        font-weight: 600;
        margin-bottom: 15px;
      }

      .btn-primary { background: #222; color: #fff; }
      .btn-primary:hover:not(:disabled) { background: #000; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,0,0,0.2); }
      .btn-primary:disabled { background: #ccc; cursor: not-allowed; }

      .btn-secondary { background: #fff; color: #222; border: 2px solid #222; }
      .btn-secondary:hover { background: #222; color: #fff; }

      .back-link { margin-top: 20px; }
      .back-link a { color: #666; text-decoration: none; }
      .back-link a:hover { text-decoration: underline; }

      @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-10px); }
        75% { transform: translateX(10px); }
      }
    </style>
  </head>

  <body>
    <div class="otp-container">
      <a href="/" class="logo" style="margin-left: 170px">key<span>craft</span></a>

      <div class="otp-content">
        <div class="otp-icon">
          <i class="fa fa-key"></i> <!-- Changed to key icon for password reset -->
        </div>

        <h1 class="otp-title">reset your password</h1>
        <p class="otp-subtitle">we've sent a 4-digit code to</p>
        <p class="otp-email" id="userEmail"><%= email || 'your email' %></p>

        <form id="otpForm" method="POST" action="/forgot-password/verify-otp">
          <input type="hidden" name="email" value="<%= email %>">

          <input
            type="text"
            name="otp"
            id="otpInput"
            class="otp-input"
            maxlength="4"
            autocomplete="off"
            inputmode="numeric"
            pattern="\d*"
            placeholder="____"
            required
          />

          <% if (typeof error !== 'undefined' && error) { %>
            <p style="color: #e74c3c; font-size: 14px; margin-top: 14px;">
              <%= error %>
            </p>
          <% } %>

          <div class="otp-timer" id="timerDisplay">
            <i class="fa fa-clock-o"></i>
            <span>code expires in <span class="timer-count" id="timer">05:00</span></span>
          </div>

          <div class="resend-section">
            didn't receive the code?
            <a href="/forgot-password/resend-otp" class="resend-link">resend otp</a>
          </div>

          <button type="submit" class="btn btn-primary" id="verifyBtn">
            verify & continue
          </button>
        </form>

        <button type="button" class="btn btn-secondary" onclick="window.location.href='/forgot-password'">
          change email
        </button>

        <div class="back-link">
          <a href="/login"><i class="fa fa-arrow-left"></i> back to login</a>
        </div>
      </div>
    </div>

    <script>
      // Auto-focus OTP input
      window.addEventListener("load", () => {
        document.getElementById("otpInput").focus();
      });

      // 5-minute countdown timer
      let timeLeft = 300; // 5 minutes
      const timerElement = document.getElementById("timer");

      const countdown = setInterval(() => {
        timeLeft--;
        const minutes = String(Math.floor(timeLeft / 60)).padStart(2, "0");
        const seconds = String(timeLeft % 60).padStart(2, "0");
        timerElement.textContent = `${minutes}:${seconds}`;

        if (timeLeft <= 0) {
          clearInterval(countdown);
          timerElement.textContent = "expired";
          timerElement.style.color = "#e74c3c";
          document.getElementById("otpInput").disabled = true;
          document.getElementById("verifyBtn").disabled = true;
        }
      }, 1000);
    </script>
  </body>
</html>
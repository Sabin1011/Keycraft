<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify OTP - KeyCraft</title>

  <link
    href="https://fonts.googleapis.com/css?family=Questrial|Raleway:700,900"
    rel="stylesheet"
  />
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    rel="stylesheet"
  />

  <style>
    /* --- your existing CSS unchanged --- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "Questrial", sans-serif;
      background: #f5f5f5;
      color: #222;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .otp-container {
      background: #fff;
      border: 1px solid #e5e5e5;
      border-radius: 10px;
      padding: 40px 50px 50px;
      max-width: 500px;
      width: 100%;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
      position: relative;
    }

    .logo {
      font-size: 24px;
      font-weight: 900;
      font-family: "Raleway", sans-serif;
      color: #222;
      text-decoration: none;
      position: absolute;
      top: 20px;
      left: 30px;
    }

    .logo span {
      color: #666;
    }

    .otp-content {
      margin-top: 40px;
      text-align: center;
    }

    .otp-icon {
      width: 80px;
      height: 80px;
      background: #f5f5f5;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 30px;
    }

    .otp-icon i {
      font-size: 36px;
      color: #222;
    }

    .otp-title {
      font-size: 32px;
      font-family: "Raleway", sans-serif;
      font-weight: 900;
      text-transform: lowercase;
      margin-bottom: 15px;
    }

    .otp-subtitle {
      color: #666;
      font-size: 15px;
      margin-bottom: 10px;
      line-height: 1.6;
    }

    .otp-email {
      color: #222;
      font-weight: 600;
      margin-bottom: 40px;
    }

    .otp-input {
      width: 180px;
      height: 60px;
      border: 2px solid #e5e5e5;
      border-radius: 8px;
      text-align: center;
      font-size: 24px;
      font-family: "Raleway", sans-serif;
      font-weight: 700;
      transition: all 0.3s;
      outline: none;
      letter-spacing: 10px;
    }

    .otp-input:focus {
      border-color: #222;
      transform: scale(1.05);
    }

    .otp-input.error {
      border-color: #e74c3c;
      animation: shake 0.5s;
    }

    .otp-timer{
      margin-top:30px;
    }
    .resend-section{
      margin: 20px auto;
    }

    @keyframes shake {
      0%,
      100% {
        transform: translateX(0);
      }
      25% {
        transform: translateX(-10px);
      }
      75% {
        transform: translateX(10px);
      }
    }

    .btn {
      width: 100%;
      padding: 18px 30px;
      border: none;
      font-size: 14px;
      text-transform: lowercase;
      cursor: pointer;
      border-radius: 5px;
      transition: all 0.3s;
      font-family: "Questrial", sans-serif;
      font-weight: 600;
      margin-bottom: 15px;
    }

    .btn-primary {
      background: #222;
      color: #fff;
    }

    .btn-primary:hover:not(:disabled) {
      background: #000;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .btn-primary:disabled {
      background: #ccc;
      cursor: not-allowed;
    }

    .btn-secondary {
      background: #fff;
      color: #222;
      border: 2px solid #222;
    }

    .btn-secondary:hover {
      background: #222;
      color: #fff;
    }

    /* ... (rest of CSS same) ... */
  </style>
</head>

<body>
  <div class="otp-container">
    <a href="/" class="logo" style="margin-left: 170px;">key<span>craft</span></a>

    <div class="otp-content">
      <div class="otp-icon">
        <i class="fa fa-envelope-o"></i>
      </div>

      <h1 class="otp-title">verify your email</h1>
      <p class="otp-subtitle">we've sent a verification code to</p>
      <p class="otp-email" id="userEmail"></p>

      <div
        class="error-message<% if (locals.error) { %> show<% } %>"
        id="errorMessage"
      >
        <i class="fa fa-exclamation-circle"></i>
      </div>

      <div
        class="success-message<% if (locals.success) { %> show<% } %>"
        id="successMessage"
      >
        <i class="fa fa-check-circle"></i>
      </div>

      <form id="otpForm" method="POST" action="/verify-otp" ">
        <!-- Hidden email -->
        <input type="hidden" name="email" id="emailField" />

        <!-- Single OTP input (only one key now) -->
        <input
          type="text"
          name="otp"
          id="otpInput"
          class="otp-input"
          maxlength="4"
          autocomplete="off"
          inputmode="numeric"
          pattern="\d*"
          placeholder="____"
        />

        <% if(error){ %> 
              <p style="color: #e74c3c; font-size: 14px; margin-top: 14px;"><%= error %></p>
        <% } %>

        <div class="otp-timer" id="timerDisplay">
          <i class="fa fa-clock-o"></i>
          <span>code expires in <span class="timer-count" id="timer">05:00</span></span>
        </div>

        <div class="resend-section">
          didn't receive the code?
          <a href="#" class="resend-link" id="resendLink" onclick="resendOTP(event)">resend otp</a>
        </div>

        <button type="submit" class="btn btn-primary" id="verifyBtn">
          verify & continue
        </button>
      </form>

      <button type="button" class="btn btn-secondary" onclick="window.location.href='/register'">
        change email
      </button>

      <div class="back-link">
        <a href="/register"><i class="fa fa-arrow-left"></i> back to registration</a>
      </div>
    </div>
  </div>

  <script>
    const userEmail = "";
    document.getElementById("userEmail").textContent = userEmail;
    document.getElementById("emailField").value = userEmail;

    // Timer
    let timeLeft = 300;
    const timerElement = document.getElementById("timer");
    const countdown = setInterval(() => {
      timeLeft--;
      const minutes = Math.floor(timeLeft / 60);
      const seconds = timeLeft % 60;
      timerElement.textContent = `${minutes.toString().padStart(2, "0")}:${seconds
        .toString()
        .padStart(2, "0")}`;
      if (timeLeft <= 0) {
        clearInterval(countdown);
        timerElement.classList.add("timer-expired");
        timerElement.textContent = "expired";
        document.getElementById("otpInput").disabled = true;
        document.getElementById("verifyBtn").disabled = true;
      }
    }, 1000);

    function handleSubmit(event) {
      event.preventDefault();

      const otp = document.getElementById("otpInput").value.trim();
      const errorMsg = document.getElementById("errorMessage");
      const successMsg = document.getElementById("successMessage");
      const verifyBtn = document.getElementById("verifyBtn");

      errorMsg.classList.remove("show");
      successMsg.classList.remove("show");

      if (otp.length !== 4 || !/^\d+$/.test(otp)) {
        errorMsg.textContent = "Please enter a valid 4-digit OTP.";
        errorMsg.classList.add("show");
        return false;
      }

      verifyBtn.disabled = true;
      verifyBtn.innerHTML = 'verifying <span class="spinner"></span>';

      const form = document.getElementById("otpForm");
      const formData = new FormData(form);

      fetch(form.action, { method: "POST", body: formData })
        .then((response) => response.json())
        .then((data) => {
          if (data.success) {
            successMsg.textContent = "OTP verified successfully!";
            successMsg.classList.add("show");
            verifyBtn.innerHTML = '<i class="fa fa-check"></i> verified';
            setTimeout(() => {
              window.location.href =
                data.redirect || "/welcome?email=" + encodeURIComponent(userEmail);
            }, 2000);
          } else {
            errorMsg.textContent = data.message || "Invalid OTP. Please try again.";
            errorMsg.classList.add("show");
            document.getElementById("otpInput").classList.add("error");
            document.getElementById("otpInput").value = "";
            setTimeout(() => {
              document.getElementById("otpInput").classList.remove("error");
              document.getElementById("otpInput").focus();
            }, 500);
            verifyBtn.disabled = false;
            verifyBtn.textContent = "verify & continue";
          }
        })
        .catch((error) => {
          console.error("Error:", error);
          errorMsg.textContent = "An error occurred. Please try again.";
          errorMsg.classList.add("show");
          verifyBtn.disabled = false;
          verifyBtn.textContent = "verify & continue";
        });
      return false;
    }

    function resendOTP(event) {
      event.preventDefault();
      const resendLink = document.getElementById("resendLink");
      const successMsg = document.getElementById("successMessage");
      resendLink.classList.add("disabled");

      fetch("/resend-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: userEmail }),
      })
        .then((response) => response.json())
        .then((data) => {
          if (data.success) {
            successMsg.textContent = "New OTP sent successfully!";
            successMsg.classList.add("show");
            document.getElementById("otpInput").disabled = false;
            document.getElementById("otpInput").value = "";
            setTimeout(() => successMsg.classList.remove("show"), 3000);
            setTimeout(() => resendLink.classList.remove("disabled"), 30000);
          } else {
            successMsg.textContent = data.message || "Failed to resend OTP";
            successMsg.classList.add("show");
            setTimeout(() => {
              successMsg.classList.remove("show");
              resendLink.classList.remove("disabled");
            }, 3000);
          }
        })
        .catch(() => {
          successMsg.textContent = "Failed to resend OTP";
          successMsg.classList.add("show");
          setTimeout(() => {
            successMsg.classList.remove("show");
            resendLink.classList.remove("disabled");
          }, 3000);
        });
    }

    window.addEventListener("load", () => {
      document.getElementById("otpInput").focus();
    });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify OTP - KeyCraft</title>

    <link
      href="https://fonts.googleapis.com/css?family=Questrial|Raleway:700,900"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
      rel="stylesheet"
    />

<link rel="stylesheet" href="/css/user/otp.css">
  </head>

  <body>
    <div class="otp-container">
      <a href="/" class="logo" style="margin-left: 170px"
        >key<span>craft</span></a
      >

      <div class="otp-content">
        <div class="otp-icon">
          <i class="fa fa-envelope-o"></i>
        </div>

        <h1 class="otp-title">verify your email</h1>
        <p class="otp-subtitle">we've sent a verification code to</p>
        <p class="otp-email" id="userEmail"></p>

        <form id="otpForm" method="POST" action="/verify-otp">
          <!-- Hidden email -->
          <input type="hidden" name="email" id="emailField" />

          <!-- Single OTP input (only one key now) -->
          <input
            type="text"
            name="otp"
            id="otpInput"
            class="otp-input"
            maxlength="4"
            autocomplete="off"
            inputmode="numeric"
            pattern="\d*"
            placeholder="____"
          />

          <% if(error){ %>
          <p style="color: #e74c3c; font-size: 14px; margin-top: 14px">
            <%= error %>
          </p>
          <% } %>
          
          <div class="otp-timer" id="timerDisplay">
            <i class="fa fa-clock-o"></i>
            <span
              >code expires in
              <span class="timer-count" id="timer">05:00</span></span
            >
          </div>

          <div class="resend-section">
            didn't receive the code?
            <a href="/resend-otp" class="resend-link">resend otp</a>
          </div>

          <button type="submit" class="btn btn-primary" id="verifyBtn">
            verify & continue
          </button>
        </form>

        <button
          type="button"
          class="btn btn-secondary"
          onclick="window.location.href='/register'"
        >
          change email
        </button>

        <div class="back-link">
          <a href="/register"
            ><i class="fa fa-arrow-left"></i> back to registration</a
          >
        </div>
      </div>
    </div>

    <script>
      const userEmail = "";
      document.getElementById("userEmail").textContent = userEmail;
      document.getElementById("emailField").value = userEmail;

      // Timer
      let timeLeft = 300;
      const timerElement = document.getElementById("timer");
      const countdown = setInterval(() => {
        timeLeft--;
        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        timerElement.textContent = `${minutes
          .toString()
          .padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;
        if (timeLeft <= 0) {
          clearInterval(countdown);
          timerElement.classList.add("timer-expired");
          timerElement.textContent = "expired";
          document.getElementById("otpInput").disabled = true;
          document.getElementById("verifyBtn").disabled = true;
        }
      }, 1000);

      window.addEventListener("load", () => {
        document.getElementById("otpInput").focus();
      });
    </script>
  </body>
</html>

<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/css/user/home.css">

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <h1>Are you ready<br><strong>To get Premium Keyboards?</strong></h1>
        <p>Discover the perfect typing experience with our curated collection of premium mechanical keyboards</p>
        <a href="/about" class="button">LEARN MORE</a>
        <a href="/shop" class="button button-secondary">EXPLORE NOW</a>
    </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-title">
      <div class="section-subtitle">Get all the goodies</div>
      <h2>Latest Keyboards</h2>
      <div class="title-underline"></div>
    </div>

    <div class="product-grid">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <div class="product-card">
            <% if (product.totalStock === 0) { %>
              <div class="product-label red">out of stock</div>
            <% } else if (product.totalStock < 5) { %>
              <div class="product-label red">low stock</div>
            <% } else { %>
              <div class="product-label">available</div>
            <% } %>

            <div class="product-image">

              <% if (product.images && product.images.length > 0) { %>
                <img src="<%= product.images[0] %>" alt="<%= product.name %>">
              <% } else { %>
                <img src="/images/default-product.png" alt="No Image">
              <% } %>
              <% if (user) { %>
                    <% 
                        const isInWishlist = wishlistProductIds.includes(product._id.toString())
                    %>
                    <button class="wishlist-btn" data-id="<%= product._id %>">
                        <i class="fas fa-heart <%= isInWishlist ? 'active' : '' %>"></i>
                    </button>
                <% } %>
            </div>

            <div class="product-info">
              <div class="product-category"><%= product.category ? product.category.name : 'Uncategorized' %></div>
              <div class="product-name"><%= product.name %></div>
              <div class="product-specs"><%= product.description.substring(0, 50) %>...</div>



<div class="product-price">
  <% if (product.hasOffer) { %>
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
      <span style="text-decoration: line-through; color: #95a5a6; font-size: 16px; font-weight: 400;">
        ₹<%= product.originalPrice.toFixed(2) %>
      </span>
      <span style="color: #2c3e50; font-size: 22px; font-weight: 600;">
        ₹<%= product.discountedPrice.toFixed(2) %>
      </span>
      <span style="background: #27ae60; color: #fff; padding: 4px 8px; font-size: 11px; font-weight: 600; border-radius: 3px;">
        <% if (product.offerDetails.discountType === 'percentage') { %>
          <%= product.discountPercentage %>% OFF
        <% } else { %>
          ₹<%= product.discountAmount.toFixed(0) %> OFF
        <% } %>
      </span>
          </div>
          <% if (product.offerDetails) { %>
            <div style="margin-top: 8px; font-size: 11px; color: #e67e22; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
              🎉 <%= product.offerDetails.title %>
            </div>
          <% } %>
        <% } else { %>
          ₹<%= product.originalPrice.toFixed(2) %>
        <% } %> 
      </div>
              <div class="product-actions">
                <a href="/singleProduct/<%= product._id %>" class="btn-small">details</a>
                <% if (product.totalStock > 0) { %>
                    <form action="/cart/add/<%= product._id %>" method="POST" style="width:100%;">
                        <input type="hidden" name="variantId" value="<%= product.variants && product.variants.length > 0 ? product.variants[0]._id : null %>">
                        <button type="submit" class="btn-small btn-primary" style="width:100%;">add to cart</button>
                    </form>
                <% } else { %>
                  <button class="btn-small" disabled style="opacity:0.6;">unavailable</button>
                <% } %>
                
              </div>    
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="text-align:center; color:#888;">No products available.</p>
      <% } %>
    </div>
  </div>
</section>

<!-- Brands Section -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <div class="section-subtitle"><h2>Popular brands</h2></div>
            
            <div class="title-underline"></div>
        </div>

        <div class="brands-grid">
            <div class="brand-item" >
                <img src="/assets/keychron.png" alt="Keychron logo" />
            </div>
            <div class="brand-item">
                <img src="/assets/Logitech-Logo.png" alt="Keychron logo" />
            </div>
            <div class="brand-item">
                <img src="/assets/Razer.png"  alt="Keychron logo" />
            </div>
            <div class="brand-item">
                <img src="/assets/Corsair.png"  alt="Keychron logo" />
            </div>
            <div class="brand-item">
                <img src="/assets/reddragon.png"  alt="Keychron logo" />
            </div>
        </div>
    </div>
</section>

<script>

document.querySelectorAll('.wishlist-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
        const productId = btn.dataset.id;
        const icon = btn.querySelector('i');
        let url = '';

        if(icon.classList.contains('active')){
            url = '/wishlist/remove/' + productId;
        } else {
            url = '/wishlist/add/' + productId;
        }

        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if(data.success){
                icon.classList.toggle('active');
            } else {
                alert(data.message);
            }
        } catch(err){
            console.error(err);
        }
    });
});

</script>

<%- include('../partials/user/footer') %>
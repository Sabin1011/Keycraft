<%- include('../partials/user/header') %>

<style>

    /* Hero Section */
    .hero {
        background: linear-gradient(rgba(51, 4, 105, 0.39), rgba(0, 0, 0, 0.719)), url('/assets/homeBackground.avif') center/cover no-repeat;
        color: #2c3e50;
        padding: 140px 0;
        text-align: center;
    }

    .hero h1 {
        font-size: 38px;
        font-family: 'Raleway', sans-serif;
        font-weight: 300;
        margin-bottom: 15px;
        text-transform: capitalize;
        color: #c78de4;
        line-height: 1.3;
    }

    .hero h1 strong {
        display: block;
        font-size: 52px;
        font-weight: 700;
        color: #c78de4;
        margin-top: 5px;
    }

    .hero p {
        font-size: 16px;
        margin-bottom: 40px;
        color: #ffffff;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.6;
    }

    .button {
        background: #480489;
        color: #fff;
        border: none;
        padding: 14px 35px;
        font-size: 13px;
        text-transform: uppercase;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
        font-family: 'Questrial', sans-serif;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-right: 15px;
    }

    .button:hover {
        background: #b364fe;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .button-secondary {
        background: transparent;
        color: #ffffff;
        border: 2px solid #432c50;
    }

    .button-secondary:hover {
        background: #b364fe;
        color: #fff;
    }

    /* Search Bar */
    .search-section {
        padding: 30px 0;
        background: #fff;
    }

    .search-container {
        display: flex;
        justify-content: flex-end;
    }

    .search-box {
        position: relative;
        width: 100%;
        max-width: 400px;
    }
    
    .search-box input {
        width: 100%;
        padding: 12px 45px 12px 20px;
        border: 1px solid #dfe6e9;
        border-radius: 25px;
        font-size: 14px;
        font-family: 'Questrial', sans-serif;
        transition: all 0.3s;
        background: #f8f9fa;
    }

    .search-box input:focus {
        outline: none;
        border-color: #2c3e50;
        box-shadow: 0 2px 10px rgba(44, 62, 80, 0.1);
        background: #fff;
    }

    .search-box button {
        position: absolute;
        right: 5px;
        top: 50%;
        transform: translateY(-50%);
        background: #2c3e50;
        color: #fff;
        border: none;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        cursor: pointer;
        transition: background 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .search-box button:hover {
        background: #34495e;
    }

    /* Categories Section */
    .section {
        padding: 80px 0;
        background: #fff;
    }

    .section:nth-child(even) {
        background: #f8f9fa;
    }

    .section-title {
        text-align: center;
        margin-bottom: 60px;
    }

    .section-subtitle {
        color: #95a5a6;
        font-size: 12px;
        text-transform: uppercase;
        margin-bottom: 10px;
        letter-spacing: 2px;
        font-weight: 600;
    }

    .section-title h2 {
        font-size: 36px;
        font-family: 'Raleway', sans-serif;
        font-weight: 300;
        text-transform: capitalize;
        color: #2c3e50;
    }

    .title-underline {
        width: 50px;
        height: 3px;
        background: #2c3e50;
        margin: 20px auto 0;
    }

    /* Category Tabs */
    .category-tabs {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-bottom: 50px;
        flex-wrap: wrap;
    }

    .category-tab {
        padding: 10px 25px;
        background: #fff;
        border: 1px solid #dfe6e9;
        cursor: pointer;
        font-size: 13px;
        text-transform: capitalize;
        transition: all 0.3s;
        font-family: 'Questrial', sans-serif;
        font-weight: 500;
    }

    .category-tab:hover,
    .category-tab.active {
        background: #2c3e50;
        color: #fff;
        border-color: #2c3e50;
    }

    /* Product Grid */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }

    .product-card {
        background: #fff;
        border: 1px solid #ecf0f1;
        transition: transform 0.3s, box-shadow 0.3s;
        position: relative;
        overflow: hidden;
        border-radius: 0;
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.12);
    }

    .product-label {
        position: absolute;
        top: 20px;
        left: 20px;
        background: #2c3e50;
        color: #fff;
        padding: 6px 14px;
        font-size: 10px;
        text-transform: uppercase;
        z-index: 1;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .product-label.red {
        background: #e74c3c;
    }

    .product-image {
        width: 100%;
        height: 280px;
        object-fit: cover;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 80px;
        color: #ddd;
    }

    .product-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-info {
        padding: 25px;
    }

    .product-category {
        color: #95a5a6;
        font-size: 11px;
        text-transform: uppercase;
        margin-bottom: 10px;
        letter-spacing: 1px;
        font-weight: 600;
    }

    .product-name {
        font-size: 19px;
        font-weight: 400;
        margin-bottom: 12px;
        color: #2c3e50;
        font-family: 'Raleway', sans-serif;
    }

    .product-specs {
        font-size: 13px;
        color: #7f8c8d;
        margin-bottom: 18px;
        line-height: 1.5;
    }

    .product-price {
        font-size: 22px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 18px;
    }

    .product-actions {
        display: flex;
        gap: 10px;
    }

    .btn-small {
        flex: 1;
        padding: 11px;
        background: #fff;
        border: 1px solid #dfe6e9;
        cursor: pointer;
        font-size: 12px;
        text-transform: uppercase;
        transition: all 0.3s;
        font-family: 'Questrial', sans-serif;
        border-radius: 0;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .btn-small:hover {
        background: #2c3e50;
        color: #fff;
        border-color: #2c3e50;
    }

    .btn-primary {
        background: #2c3e50;
        color: #fff;
        border-color: #2c3e50;
        border-radius: 0;
    }

    .btn-primary:hover {
        background: #34495e;
    }

    /* Brands Section */
    .brands-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 25px;
        text-align: center;
    }

    .brand-item {
        padding: 35px 20px;
        background: #fff;
        border: 1px solid #ecf0f1;
        transition: all 0.3s;
        cursor: pointer;
        border-radius: 6px;
    }

    .brand-item:hover {
        border-color: #2c3e50;
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .brand-item img {
        max-width: 100%;
        max-height: 60px;
        object-fit: contain;
    }

    
    .brand-name {
        font-size: 16px;
        font-weight: 600;
        color: #2c3e50;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .product-actions a{
        text-decoration: none;
        display: flex;
        justify-content: center;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .hero h1 {
            font-size: 28px;
        }

        .hero h1 strong {
            font-size: 38px;
        }

        .product-grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
        }

        .search-box {
            max-width: 100%;
        }

        .button {
            margin-right: 0;
            margin-bottom: 10px;
            display: block;
            width: 100%;
        }
    }
</style>

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <h1>Are you ready<br><strong>To get Premium Keyboards?</strong></h1>
        <p>Discover the perfect typing experience with our curated collection of premium mechanical keyboards</p>
        <a href="/shop" class="button">LEARN MORE</a>
        <a href="/shop" class="button button-secondary">EXPLORE NOW</a>
    </div>
</section>

<!-- Featured Keyboards -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <div class="section-subtitle">Get all the goodies</div>
      <h2>Latest Keyboards</h2>
      <div class="title-underline"></div>
    </div>

    <div class="product-grid">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <div class="product-card">
            <% if (product.totalStock === 0) { %>
              <div class="product-label red">out of stock</div>
            <% } else if (product.totalStock < 5) { %>
              <div class="product-label red">low stock</div>
            <% } else { %>
              <div class="product-label">available</div>
            <% } %>

            <div class="product-image">
              <% if (product.images && product.images.length > 0) { %>
                <img src="<%= product.images[0] %>" alt="<%= product.name %>">
              <% } else { %>
                <img src="/images/default-product.png" alt="No Image">
              <% } %>
            </div>

            <div class="product-info">
              <div class="product-category"><%= product.category ? product.category.name : 'Uncategorized' %></div>
              <div class="product-name"><%= product.name %></div>
              <div class="product-specs"><%= product.description.substring(0, 50) %>...</div>
              <div class="product-price">₹<%= product.price.toFixed(2) %></div>

              <div class="product-actions">
                <a href="/singleProduct/<%= product._id %>" class="btn-small">details</a>
                <% if (product.totalStock > 0) { %>
                  <button class="btn-small btn-primary">add to cart</button>
                <% } else { %>
                  <button class="btn-small" disabled style="opacity:0.6;">unavailable</button>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="text-align:center; color:#888;">No products available.</p>
      <% } %>
    </div>
  </div>
</section>

<!-- Brands Section -->
<section class="section">
    <div class="container">
        <div class="section-title">
            <div class="section-subtitle"><h2>Popular brands</h2></div>
            
            <div class="title-underline"></div>
        </div>

        <div class="brands-grid">
            <div class="brand-item" >
                <img src="/assets/keychron.png" alt="Keychron logo" />
            </div>
            <div class="brand-item">
                <img src="/assets/Logitech-Logo.png" alt="Keychron logo" />
            </div>
            <div class="brand-item">
                <img src="/assets/Razer.png"  alt="Keychron logo" />
            </div>
            <div class="brand-item">
                <img src="/assets/Corsair.png"  alt="Keychron logo" />
            </div>
            <div class="brand-item">
                <img src="/assets/reddragon.png"  alt="Keychron logo" />
            </div>
        </div>
    </div>
</section>

<%- include('../partials/user/footer') %>
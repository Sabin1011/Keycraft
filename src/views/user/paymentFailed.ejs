<%- include('../partials/user/header') %>

<style>
  .failure-container {
    min-height: 80vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #fafafa;
  }

  .failure-card {
    background: #fff;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    text-align: center;
    max-width: 450px;
    width: 100%;
  }

  .failure-icon {
    font-size: 60px;
    color: #e74c3c;
    margin-bottom: 15px;
  }

  .failure-card h2 {
    color: #333;
    margin-bottom: 10px;
  }

  .failure-card p {
    color: #666;
    margin-bottom: 25px;
    font-size: 15px;
  }

  .btn {
    display: inline-block;
    margin: 8px;
    padding: 12px 25px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }

  .btn-retry {
    background: #401f75;
    color: #fff;
  }

  .btn-orders {
    background: #e0e0e0;
    color: #333;
  }

  .btn-retry:hover {
    background: #2f1557;
  }

  .btn-orders:hover {
    background: #ccc;
  }
</style>

<section class="failure-container">
  <div class="failure-card">
    <div class="failure-icon">❌</div>

    <h2>Payment Failed</h2>
    <p>
      Your payment could not be completed or was cancelled.<br>
      No amount has been deducted.
    </p>

    <a href="/retry-payment" class="btn btn-retry">
      Retry Payment
    </a>

    <a href="/my-orders" class="btn btn-orders">
      Go to My Orders
    </a>
  </div>
</section>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>


</script>


<%- include('../partials/user/footer') %>

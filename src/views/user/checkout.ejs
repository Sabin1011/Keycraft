<%- include('../partials/user/header') %>

<link rel="stylesheet" href="/css/user/checkout.css">
<section class="breadcrumb">
  <div class="container">
    <a href="/">home</a>
    <span>/</span>
    <a href="/cart">cart</a>
    <span>/</span>
    <span style="color: #222">checkout</span>
  </div>
</section>

<section class="checkout-section">
  <div class="container">
    <% if (success) { %>
    <div style="padding: 15px 20px; background: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 10px; margin-bottom: 25px;">
      <i class="fa fa-check-circle"></i> <%= success %>
    </div>
    <% } %>
    <% if (error) { %>
    <div style="padding: 15px 20px; background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 10px; margin-bottom: 25px;">
      <i class="fa fa-exclamation-circle"></i> <%= error %>
    </div>
    <% } %>

    <div class="page-header">
      <div class="page-title">checkout</div>
      <div style="font-size: 16px; opacity: 0.9;">review your order and complete purchase</div>
    </div>

    <div class="checkout-layout">
      <div>
        <div class="checkout-card">
          <div class="card-header">
            <h2 class="card-title">
              <i class="fa fa-map-marker"></i> delivery address
            </h2>
            <a href="/profile/address/add?returnUrl=/checkout" class="btn btn-secondary btn-small">
              <i class="fa fa-plus"></i> add new
            </a>
          </div>

          <% if (addresses && addresses.length > 0) { %>
            <form id="addressForm">
              <div class="address-list">
                <% addresses.forEach(address => { %>
                  <label class="address-item <%= selectedAddressId === address._id.toString() ? 'selected' : '' %>">
                    <div class="address-radio">
                      <input 
                        type="radio" 
                        name="selectedAddress" 
                        value="<%= address._id %>"
                        <%= selectedAddressId === address._id.toString() ? 'checked' : '' %>
                        >
                      <div class="address-content">
                        <div class="address-type">
                          <% if (address.isDefault) { %>
                            <i class="fa fa-star" style="color: #ffa500;"></i>
                          <% } %>
                          <%= address.type %>
                          <% if (address.label) { %> - <%= address.label %><% } %>
                        </div>
                        <div class="address-text">
                          <%= address.street %><br>
                          <%= address.city %>, <%= address.state %> <%= address.zipCode %><br>
                          <%= address.country %>
                        </div>
                        <div class="address-actions">
                          <a href="/profile/address/<%= address._id %>/edit?returnUrl=/checkout" 
                             class="btn btn-secondary btn-small"
                             onclick="event.stopPropagation();">
                            <i class="fa fa-edit"></i> edit
                          </a>
                        </div>
                      </div>
                    </div>
                  </label>

                <% }) %>
              </div>
            </form>
          <% } else { %>
            <div class="empty-state">
              <i class="fa fa-map-marker"></i>
              <p>no saved addresses yet</p>
              <a href="/profile/address/add?returnUrl=/checkout" class="btn btn-primary" style="margin-top: 15px;">
                <i class="fa fa-plus"></i> add your first address
              </a>
            </div>
          <% } %>
        </div>
      </div>

      <div>
        <div class="checkout-card">
          <div class="card-header">
            <h2 class="card-title">
              <i class="fa fa-shopping-cart"></i> order summary
            </h2>
          </div>

          <% if (cartItems && cartItems.length > 0) { %>
            <div style="margin-bottom: 20px; max-height: 300px; overflow-y: auto;">

              <% cartItems.forEach(item => { %>
                <div style="display: flex; gap: 15px; padding: 15px; background: #f8f9fa; border-radius: 8px; margin-bottom: 10px;">
                  <% if (item.product.images && item.product.images.length > 0) { %>
                    <img 
                      src="<%= item.product.images[0] %>" 
                      alt="<%= item.product.name %>"
                      style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;">
                  <% } %>
                  <div style="flex: 1;">
                    <div style="font-weight: 600; font-size: 14px; margin-bottom: 5px;">
                      <%= item.product.name %>
                    </div>

                    
                      <div style="color: #666; font-size: 13px;">

                        Qty: <%= item.quantity %> × ₹<%= item.discountedPrice.toFixed(2) %>

                        <% if (item.offerDetails) { %>
                          <span
                            style="
                              margin-left: 8px;
                              background: #27ae60;
                              color: #fff;
                              padding: 3px 7px;
                              font-size: 10px;
                              font-weight: 600;
                              border-radius: 3px;
                              vertical-align: middle;
                            "
                          >
                            <% if (item.offerDetails.discountType === 'percentage') { %>
                              <%= item.offerDetails.discountValue %>% OFF
                            <% } else { %>
                              ₹<%= item.offerDetails.discountValue %> OFF
                            <% } %>
                          </span>
                        <% } %>

                        <div style="margin-top: 4px;">
                          <% if (item.selectedVariant) { %>
                            Variant: <strong><%= item.selectedVariant.name %></strong>
                          <% } else { %>
                            Variant: <strong>Default</strong>
                          <% } %>
                        </div>

                        <% if (item.offerDetails?.title) { %>
                          <div
                            style="
                              margin-top: 4px;
                              font-size: 11px;
                              color: #e67e22;
                              font-weight: 600;
                            "
                          >
                            🎉 <%= item.offerDetails.title %>
                          </div>
                        <% } %>

                      </div>

                  </div>
                  
                  <div style="font-weight: 600; color: #401f75;">
                    ₹<%= item.itemTotal.toFixed(2) %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>

          <div class="order-summary">

            <div class="summary-row">
              <span>Subtotal</span>
              <span>₹<span id="subtotal"><%= cartSubtotal.toFixed(2) %></span></span>
            </div>

            <div id="couponDiscountRow"></div>

            <div class="summary-row">
              <span>Shipping</span>
              <span>Free</span>
            </div>

            <div class="summary-row" id="finalTotalRow">
              <span>Total</span>
              <span>₹<%= grandTotal.toFixed(2) %></span>
            </div>

          </div>


          <div class="checkout-card" style="margin-top: 20px;">
            <div class="card-header">
              <h2 class="card-title">
                <i class="fa fa-tag"></i> apply coupon
              </h2>
            </div>

            <button
              type="button"
              class="btn btn-secondary"
              style="margin-bottom:10px;width:100%;"
              onclick="openCouponModal()"
            >
              🎁 View Available Coupons
            </button>


            <div style="display: flex; gap: 10px;">
              <input 
                type="text" 
                id="couponInput" 
                name="couponCode"
                placeholder="Enter coupon code"
                class="form-control"
                style="flex: 1; text-transform: uppercase;"
              />

              <button 
                type="button" 
                id="applyCouponBtn"
                class="btn btn-primary"
                style="white-space: nowrap;"
              >
                Apply
              </button>
            </div>

            <small id="couponMessage" style="color: red; display: block; margin-top: 8px;"></small>
            
          </div>

            <div class="checkout-card" style="margin-top: 20px;">
                <div class="card-header">
                    <h2 class="card-title">
                    <i class="fa fa-credit-card"></i> payment method
                    </h2>
                </div>

          <form id="checkoutForm" action="/proceedToCheckout" method="POST">

            <input type="hidden" name="addressId" value="<%= selectedAddressId %>">
            <input type="hidden" name="couponCode" id="hiddenCouponCode">

            <label class="address-item" style="cursor: pointer;">
              
              <div class="address-radio">
                <input type="radio" name="paymentMethod" value="cod" id="codOption">

                <div class="address-content">
                  
                  
                  <div class="address-type">Cash on Delivery</div>


                          <div class="address-text">Pay once the product is delivered</div>
                                          <p id="codMessage" style="color: red; font-size: 12px; display: none;">
                  Cash on Delivery is not available for orders above ₹1000
                </p>
                  
                </div>
              </div>
            </label>


            <label class="address-item" style="cursor: pointer; margin-top: 10px;">
              <div class="address-radio">
                <input type="radio" name="paymentMethod" value="razorpay">
                <div class="address-content">
                  <div class="address-type">Online Payment</div>
                  <div class="address-text">Pay securely using Razorpay</div>
                </div>
              </div>
            </label>

            <label class="address-item" style="cursor: pointer; margin-top: 10px;">
              <div class="address-radio">

                <input type="radio" name="paymentMethod" value="wallet" />
                <div class="address-content">
                <div class="address-type">Pay using Wallet</div>
                <div class="address-text">
                  <% if (wallet) { %>
                    (Balance: ₹<%= wallet.balance.toFixed(2) %>)
                  <% } %>
                </div>
                </div>     
              </div>
            </label>

            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px;">
              <i class="fa fa-lock"></i> Proceed to Payment
            </button>
          </form>

          <% if (!selectedAddressId && addresses.length > 0) { %>
            <p style="text-align: center; color: #999; font-size: 12px; margin-top: 10px;">
              Please select a delivery address
            </p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<div id="couponModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:999;">
  <div style="background:#fff;max-width:450px;margin:8% auto;padding:20px;border-radius:12px;">

    <h3 style="margin-bottom:15px;">Available Coupons</h3>

    <% if (availableCoupons.length === 0) { %>
      <p style="color:#888;">No coupons available for this order</p>
    <% } %>

    <% availableCoupons.forEach(coupon => { %>
      <div style="border:1px dashed #ccc;padding:12px;border-radius:8px;margin-bottom:10px;">
        <strong><%= coupon.code %></strong>
        <p style="font-size:13px;color:#666;"><%= coupon.description %></p>

        <p style="font-size:12px;">
          Min: ₹<%= coupon.minPurchaseAmount %> |
          <% if (coupon.discountType === "percentage") { %>
            <%= coupon.discountValue %>% OFF
          <% } else { %>
            ₹<%= coupon.discountValue %> OFF
          <% } %>
        </p>

        <button
          class="btn btn-primary btn-small"
          onclick="applyCouponFromModal('<%= coupon.code %>')"
        >
          Apply
        </button>
      </div>
    <% }) %>

    <button class="btn btn-secondary" style="width:100%;" onclick="closeCouponModal()">Close</button>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>


  document.getElementById("checkoutForm").addEventListener("submit", function(e){
    e.preventDefault();

    const paymentSelected = document.querySelector('input[name="paymentMethod"]:checked');
    const addressId =  document.querySelector('input[name="addressId"]').value;
    const couponCode = document.getElementById("hiddenCouponCode").value;


    if(!paymentSelected){
  
      swal.fire({
        icon:"error",
        title:"Selected Payment Method",
        text:"Please choose a payment method to continue "
      });
      return false;
    }

    if(paymentSelected.value === "cod" || paymentSelected.value=== "wallet"){
      this.submit();
      return;
    }

    if(paymentSelected.value === "razorpay"){
      startRazorpayPayment(addressId, couponCode);
    }
  })



const addressRadios = document.querySelectorAll(
  'input[name="selectedAddress"]'
);
const mainAddressInput = document.querySelector('input[name="addressId"]');

addressRadios.forEach((radio) => {
  radio.addEventListener("change", async () => {
    const addressId = radio.value;
    
    try {
      const res = await fetch("/checkout/select-address", {
        method: "PATCH", 
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ addressId }),
      });

      const data = await res.json();

      if (!data.success) {
        Swal.fire("Error", data.message || "Failed to select address", "error");
        return;
      }

      mainAddressInput.value = addressId;

    } catch (err) {
      console.error(err);
      Swal.fire("Error", "Something went wrong", "error");
    }
  });
});

  
  document.querySelectorAll(".delete-address-form").forEach((form) => {
    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      const result = await Swal.fire({
        title: "Delete this address?",
        text: "You won't be able to recover it!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#3085d6",
        confirmButtonText: "Yes, delete it!",
        cancelButtonText: "Cancel",
      });

      if (result.isConfirmed) {
        Swal.fire({
          title: "Deleting...",
          allowOutsideClick: false,
          didOpen: () => {
            Swal.showLoading();
          },
        });

        form.submit();
      }
    });
  });

  document.getElementById("applyCouponBtn").addEventListener("click", async () => {
  const code = document.getElementById("couponInput").value.trim().toUpperCase();
  const msg = document.getElementById("couponMessage");

  if (!code) {
    msg.style.color = "red";
    msg.innerText = "Please enter a coupon code";
    return;
  }

  const cartTotal = Number("<%= cartSubtotal %>");

  const res = await fetch("/coupon/validate", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ couponCode: code, cartTotal })
  });

  const data = await res.json();

  if (!data.success) {
    msg.style.color = "red";
    msg.innerText = data.message;
    document.getElementById("hiddenCouponCode").value = "";
    return;
  }

  msg.style.color = "green";
  msg.innerText = `Coupon applied! You saved ₹${data.discountAmount}`;

  document.getElementById("hiddenCouponCode").value = code;

  document.getElementById("couponDiscountRow").innerHTML = `
    <div class="summary-row" style="color:#27ae60;">
      <span>Coupon (${code})</span>
      <span>-₹${data.discountAmount.toFixed(2)}</span>
    </div>
  `;

  document.getElementById("finalTotalRow").innerHTML = `
    <span>Total</span>
    <span>₹${data.finalAmount.toFixed(2)}</span>
  `;
  updateCODAvailability(data.finalAmount);
});

async function startRazorpayPayment(addressId, couponCode) {
  try {
    const res = await fetch("/place-order", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        addressId,
        paymentMethod: "razorpay",
        couponCode
      })
    });

    const data = await res.json();

    if (!data.success) {
      Swal.fire("Error", "Unable to initiate payment", "error");
      return;
    }

    openRazorpay(data);

  } catch (err) {
    console.error(err);
    Swal.fire("Error", "Something went wrong", "error");
  }
}


function openRazorpay(data) {
    console.log("Opening Razorpay with:", data);

  if (!data.orderId) {
    Swal.fire("Error", "Order ID missing. Please retry.", "error");
    return;
  }

  const options = {
    key: data.key,
    amount: data.amount,
    currency: "INR",
    name: "Your Store",
    description: "Order Payment",
    order_id: data.razorpayOrderId,

    handler: function (response) {
      verifyPayment(response,data.orderId);
    },


    modal: {
      ondismiss: function () {
        window.location.href = `/payment-failed?orderId=${data.orderId}`;
      }
    },

    theme: { color: "#401f75" }
  };


   new Razorpay(options).open();
}

async function verifyPayment(response, orderId) {
  try {
    const res = await fetch("/verify-payment", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        ...response,
        orderId
      }),
    });

    const data = await res.json();

    if (data.success) {
      window.location.href = `/order-success?orderId=${data.orderId}`;
    } else {
      window.location.href = `/payment-failed?orderId=${data.orderId}`;
    }

  } catch (err) {
    console.error(err);
    window.location.href = `/payment-failed?orderId=${orderId}`;
  }
}



const ORDER_LIMIT_FOR_COD = 1000;
const grandTotal = Number("<%= grandTotal %>");

const codRadio = document.getElementById("codOption")
const codMessage = document.getElementById("codMessage")
function updateCODAvailability(Total) {
  if(Total > ORDER_LIMIT_FOR_COD) {
    codRadio.disabled = true;
    codRadio.checked = false;
    codMessage.style.display = "block";
  } else {
    codRadio.disabled = false;
    codMessage.style.display = "none";
  }
}

updateCODAvailability(grandTotal)

function openCouponModal() {
  document.getElementById("couponModal").style.display = "block";
}

function closeCouponModal() {
  document.getElementById("couponModal").style.display = "none";
}

function applyCouponFromModal(code) {
  document.getElementById("couponInput").value = code;
  document.getElementById("applyCouponBtn").click();
  closeCouponModal();
}

</script>

<%- include('../partials/user/footer') %>
<%- include('../partials/user/header') %>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Questrial', sans-serif;
        background: #fafafa;
        color: #1a1a1a;
    }

    .checkout-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 40px 100px;
    }

    .checkout-header {
        text-align: center;
        margin-bottom: 60px;
        padding-bottom: 30px;
        border-bottom: 1px solid #e5e5e5;
    }

    .checkout-header h1 {
        font-size: 32px;
        font-weight: 300;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #1a1a1a;
        margin-bottom: 20px;
    }

    .checkout-header::after {
        content: '';
        display: block;
        width: 60px;
        height: 2px;
        background: #1a1a1a;
        margin: 20px auto 0;
    }

    .checkout-content {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 40px;
    }

    /* Left Section - Address & Products */
    .checkout-left {
        display: flex;
        flex-direction: column;
        gap: 40px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 500;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 25px;
        color: #1a1a1a;
    }

    /* Address Section */
    .address-section {
        background: #fff;
        border: 1px solid #e5e5e5;
        padding: 35px;
    }

    .address-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .address-card {
        border: 2px solid #e5e5e5;
        padding: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

    .address-card.selected {
        border-color: #1a1a1a;
        background: #f9f9f9;
    }

    .address-card:hover {
        border-color: #666;
    }

    .address-card input[type="radio"] {
        position: absolute;
        top: 15px;
        right: 15px;
    }

    .address-name {
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .address-details {
        font-size: 13px;
        line-height: 1.6;
        color: #666;
        margin-bottom: 8px;
    }

    .address-phone {
        font-size: 13px;
        color: #666;
        margin-bottom: 15px;
    }

    .address-actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #e5e5e5;
    }

    .btn-edit,
    .btn-delete {
        padding: 6px 12px;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 1px solid #d0d0d0;
        background: transparent;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
    }

    .btn-edit:hover {
        background: #1a1a1a;
        color: #fff;
        border-color: #1a1a1a;
    }

    .btn-delete:hover {
        background: #c62828;
        color: #fff;
        border-color: #c62828;
    }

    .btn-add-address {
        padding: 12px 30px;
        background: transparent;
        border: 2px solid #1a1a1a;
        color: #1a1a1a;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-add-address:hover {
        background: #1a1a1a;
        color: #fff;
    }

    /* Products Section */
    .products-section {
        background: #fff;
        border: 1px solid #e5e5e5;
        padding: 35px;
    }

    .product-item {
        display: grid;
        grid-template-columns: 100px 1fr auto;
        gap: 20px;
        padding: 20px 0;
        border-bottom: 1px solid #e5e5e5;
    }

    .product-item:last-child {
        border-bottom: none;
    }

    .product-img {
        width: 100px;
        height: 100px;
        background: #f8f8f8;
    }

    .product-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-details h4 {
        font-size: 15px;
        font-weight: 500;
        margin-bottom: 8px;
        text-transform: capitalize;
    }

    .product-details p {
        font-size: 13px;
        color: #666;
        margin-bottom: 4px;
    }

    .product-price {
        text-align: right;
    }

    .product-price .price {
        font-size: 16px;
        font-weight: 600;
        color: #1a1a1a;
    }

    /* Right Section - Order Summary */
    .order-summary {
        background: #fff;
        border: 1px solid #e5e5e5;
        padding: 35px;
        height: fit-content;
        position: sticky;
        top: 20px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        font-size: 14px;
        color: #666;
    }

    .summary-row.total {
        border-top: 2px solid #1a1a1a;
        margin-top: 15px;
        padding-top: 20px;
        font-size: 18px;
        font-weight: 600;
        color: #1a1a1a;
    }

    .summary-row.discount {
        color: #27ae60;
    }

    .btn-place-order {
        width: 100%;
        padding: 16px;
        background: #1a1a1a;
        color: #fff;
        border: none;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        cursor: pointer;
        margin-top: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-place-order:hover {
        background: #333;
    }

    .btn-place-order:disabled {
        background: #ccc;
        cursor: not-allowed;
    }

    /* Add/Edit Address Modal */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

    .modal.active {
        display: flex;
    }

    .modal-content {
        background: #fff;
        width: 90%;
        max-width: 500px;
        padding: 40px;
        position: relative;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-header {
        font-size: 20px;
        font-weight: 500;
        margin-bottom: 30px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .close-modal {
        position: absolute;
        top: 20px;
        right: 20px;
        font-size: 24px;
        cursor: pointer;
        background: none;
        border: none;
        color: #666;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid #e5e5e5;
        font-size: 14px;
        font-family: 'Questrial', sans-serif;
        transition: border 0.3s ease;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #1a1a1a;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 80px;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-submit,
    .btn-cancel {
        flex: 1;
        padding: 12px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-submit {
        background: #1a1a1a;
        color: #fff;
        border: 1px solid #1a1a1a;
    }

    .btn-submit:hover {
        background: #333;
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid #d0d0d0;
        color: #666;
    }

    .btn-cancel:hover {
        border-color: #1a1a1a;
        color: #1a1a1a;
    }

    @media (max-width: 968px) {
        .checkout-container {
            padding: 40px 20px;
        }

        .checkout-content {
            grid-template-columns: 1fr;
        }

        .order-summary {
            position: static;
        }

        .address-list {
            grid-template-columns: 1fr;
        }

        .product-item {
            grid-template-columns: 80px 1fr;
            gap: 15px;
        }

        .product-price {
            grid-column: 2;
            text-align: left;
            margin-top: 10px;
        }
    }
</style>

<div class="checkout-container">
    <div class="checkout-header">
        <h1>Checkout</h1>
    </div>

    <div class="checkout-content">
        <!-- Left Section -->
        <div class="checkout-left">
            <!-- Address Section -->
            <div class="address-section">
                <h2 class="section-title">Delivery Address</h2>

                <form method="POST" action="/checkout/place-order" id="checkoutForm">
                    <div class="address-list">
                        <% if (addresses && addresses.length > 0) { %>
                            <% addresses.forEach((address, index) => { %>
                                <div class="address-card <%= address.isDefault ? 'selected' : '' %>" 
                                     onclick="selectAddress(this, '<%= address._id %>')">
                                    <input type="radio" 
                                           name="selectedAddress" 
                                           value="<%= address._id %>" 
                                           <%= address.isDefault ? 'checked' : '' %>
                                           required>
                                    <div class="address-name"><%= address.name %></div>
                                    <div class="address-details">
                                        <%= address.addressLine1 %><br>
                                        <% if (address.addressLine2) { %><%= address.addressLine2 %><br><% } %>
                                        <%= address.city %>, <%= address.state %> - <%= address.pincode %>
                                    </div>
                                    <div class="address-phone">Phone: <%= address.phone %></div>
                                    <div class="address-actions">
                                        <button type="button" class="btn-edit" 
                                                onclick="event.stopPropagation(); editAddress('<%= address._id %>')">
                                            Edit
                                        </button>
                                        <button type="button" class="btn-delete" 
                                                onclick="event.stopPropagation(); deleteAddress('<%= address._id %>')">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p style="color: #666;">No addresses added yet. Please add a delivery address.</p>
                        <% } %>
                    </div>

                    <button type="button" class="btn-add-address" onclick="openAddressModal()">
                        + Add New Address
                    </button>
                </form>
            </div>

            <!-- Products Section -->
            <div class="products-section">
                <h2 class="section-title">Order Items</h2>

                <% if (cart && cart.items && cart.items.length > 0) { %>
                    <% cart.items.forEach(item => { %>
                        <div class="product-item">
                            <div class="product-img">
                                <% if (item.product.images && item.product.images.length > 0) { %>
                                    <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>">
                                <% } else { %>
                                    <img src="/images/default-product.png" alt="No Image">
                                <% } %>
                            </div>
                            <div class="product-details">
                                <h4><%= item.product.name %></h4>
                                <p>Quantity: <%= item.quantity %></p>
                                <p>Price: ₹<%= item.product.price.toFixed(2) %></p>
                            </div>
                            <div class="product-price">
                                <span class="price">₹<%= (item.product.price * item.quantity).toFixed(2) %></span>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: #666;">No items in cart.</p>
                <% } %>
            </div>
        </div>

        <!-- Right Section - Order Summary -->
        <div class="order-summary">
            <h2 class="section-title">Order Summary</h2>

            <% 
                const subtotal = cart ? cart.totalPrice : 0;
                const tax = subtotal * 0.18; // 18% tax
                const discount = cart ? (cart.discount || 0) : 0;
                const shipping = subtotal > 500 ? 0 : 50;
                const total = subtotal + tax - discount + shipping;
            %>

            <div class="summary-row">
                <span>Subtotal (<%= cart ? cart.items.length : 0 %> items)</span>
                <span>₹<%= subtotal.toFixed(2) %></span>
            </div>

            <div class="summary-row">
                <span>Tax (18%)</span>
                <span>₹<%= tax.toFixed(2) %></span>
            </div>

            <% if (discount > 0) { %>
                <div class="summary-row discount">
                    <span>Discount</span>
                    <span>-₹<%= discount.toFixed(2) %></span>
                </div>
            <% } %>

            <div class="summary-row">
                <span>Shipping</span>
                <span><%= shipping === 0 ? 'Free' : '₹' + shipping.toFixed(2) %></span>
            </div>

            <div class="summary-row total">
                <span>Total Amount</span>
                <span>₹<%= total.toFixed(2) %></span>
            </div>

            <button type="submit" 
                    form="checkoutForm" 
                    class="btn-place-order"
                    <%= (!addresses || addresses.length === 0 || !cart || cart.items.length === 0) ? 'disabled' : '' %>>
                Place Order (Cash on Delivery)
            </button>
        </div>
    </div>
</div>

<!-- Add/Edit Address Modal -->
<div class="modal" id="addressModal">
    <div class="modal-content">
        <button class="close-modal" onclick="closeAddressModal()">&times;</button>
        <h3 class="modal-header" id="modalTitle">Add New Address</h3>

        <form id="addressForm" method="POST" action="/checkout/add-address">
            <input type="hidden" name="addressId" id="addressId">

            <div class="form-group">
                <label>Full Name *</label>
                <input type="text" name="name" id="name" required>
            </div>

            <div class="form-group">
                <label>Phone Number *</label>
                <input type="tel" name="phone" id="phone" pattern="[0-9]{10}" required>
            </div>

            <div class="form-group">
                <label>Address Line 1 *</label>
                <input type="text" name="addressLine1" id="addressLine1" required>
            </div>

            <div class="form-group">
                <label>Address Line 2</label>
                <input type="text" name="addressLine2" id="addressLine2">
            </div>

            <div class="form-group">
                <label>City *</label>
                <input type="text" name="city" id="city" required>
            </div>

            <div class="form-group">
                <label>State *</label>
                <input type="text" name="state" id="state" required>
            </div>

            <div class="form-group">
                <label>Pincode *</label>
                <input type="text" name="pincode" id="pincode" pattern="[0-9]{6}" required>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">Save Address</button>
                <button type="button" class="btn-cancel" onclick="closeAddressModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
    function selectAddress(card, addressId) {
        // Remove selected class from all cards
        document.querySelectorAll('.address-card').forEach(c => c.classList.remove('selected'));
        
        // Add selected class to clicked card
        card.classList.add('selected');
        
        // Check the radio button
        card.querySelector('input[type="radio"]').checked = true;
    }

    function openAddressModal(addressData = null) {
        const modal = document.getElementById('addressModal');
        const form = document.getElementById('addressForm');
        const modalTitle = document.getElementById('modalTitle');

        if (addressData) {
            modalTitle.textContent = 'Edit Address';
            form.action = '/checkout/edit-address';
            
            // Populate form fields
            document.getElementById('addressId').value = addressData._id || '';
            document.getElementById('name').value = addressData.name || '';
            document.getElementById('phone').value = addressData.phone || '';
            document.getElementById('addressLine1').value = addressData.addressLine1 || '';
            document.getElementById('addressLine2').value = addressData.addressLine2 || '';
            document.getElementById('city').value = addressData.city || '';
            document.getElementById('state').value = addressData.state || '';
            document.getElementById('pincode').value = addressData.pincode || '';
        } else {
            modalTitle.textContent = 'Add New Address';
            form.action = '/checkout/add-address';
            form.reset();
            document.getElementById('addressId').value = '';
        }

        modal.classList.add('active');
    }

    function closeAddressModal() {
        document.getElementById('addressModal').classList.remove('active');
        document.getElementById('addressForm').reset();
    }

    async function editAddress(addressId) {
        try {
            const response = await fetch(`/checkout/get-address/${addressId}`);
            const data = await response.json();
            
            if (data.success) {
                openAddressModal(data.address);
            }
        } catch (error) {
            console.error('Error fetching address:', error);
            alert('Failed to load address details');
        }
    }

    async function deleteAddress(addressId) {
        if (!confirm('Are you sure you want to delete this address?')) {
            return;
        }

        try {
            const response = await fetch(`/checkout/delete-address/${addressId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'Failed to delete address');
            }
        } catch (error) {
            console.error('Error deleting address:', error);
            alert('Failed to delete address');
        }
    }

    // Close modal when clicking outside
    document.getElementById('addressModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeAddressModal();
        }
    });
</script>

<%- include('../partials/user/footer') %>
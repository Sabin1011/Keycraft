<%- include('../partials/user/header') %>

<style>
  body {
    background: #0f0f12;
    color: #eaeaea;
    font-family: 'Poppins', sans-serif;
  }

  .error-container {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .error-box {
    text-align: center;
    max-width: 700px;
  }

  .error-code {
    font-size: 120px;
    font-weight: 800;
    letter-spacing: 6px;
    color: #ffb703;
    animation: popIn 0.8s ease forwards;
  }

  /* Keyboard keys */
  .keyboard {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 30px 0;
  }

  .key {
    width: 70px;
    height: 70px;
    background: linear-gradient(145deg, #1a1a1f, #0b0b0e);
    border-radius: 10px;
    box-shadow: 0 6px 0 #000, inset 0 0 0 1px #2a2a2f;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 700;
    color: #fff;
    animation: keyPress 1.8s infinite ease-in-out;
  }

  .key:nth-child(2) { animation-delay: 0.2s; }
  .key:nth-child(3) { animation-delay: 0.4s; }

  /* Message */
  .error-message {
    font-size: 18px;
    color: #cfcfcf;
    margin-top: 20px;
  }

  .typing {
    font-family: monospace;
    font-size: 16px;
    margin-top: 10px;
    color: #7dd3fc;
  }

  .cursor {
    display: inline-block;
    width: 10px;
    background: #7dd3fc;
    margin-left: 3px;
    animation: blink 1s infinite;
  }

  /* Buttons */
  .actions {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .btn {
    padding: 14px 28px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-home {
    background: #ffb703;
    color: #000;
  }

  .btn-home:hover {
    background: #ffd166;
  }

  .btn-shop {
    border: 1px solid #ffb703;
    color: #ffb703;
  }

  .btn-shop:hover {
    background: #ffb703;
    color: #000;
  }

  @keyframes keyPress {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @keyframes blink {
    0%, 50%, 100% { opacity: 1; }
    25%, 75% { opacity: 0; }
  }

  @keyframes popIn {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (max-width: 600px) {
    .error-code {
      font-size: 80px;
    }
    .key {
      width: 55px;
      height: 55px;
      font-size: 22px;
    }
  }
</style>

<div class="error-container">
  <div class="error-box">

    <div class="error-code">404</div>

    <div class="keyboard">
      <div class="key">⌨</div>
      <div class="key">⌨</div>
      <div class="key">⌨</div>
    </div>

    <p class="error-message">
      Oops! Looks like this key combination doesn’t exist.
    </p>

    <div class="typing">
      > Page not found<span class="cursor"></span>
    </div>

    <div class="actions">
      <a href="/" class="btn btn-home">Go Home</a>
      <a href="/shop" class="btn btn-shop">Continue Shopping</a>
    </div>

  </div>
</div>

<%- include('../partials/user/footer') %>

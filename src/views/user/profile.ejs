<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/css/user/profile.css">

<section class="breadcrumb">
  <div class="container">
    <a href="/">home</a>
    <span>/</span>
    <span style="color: #222">my profile</span>
  </div>
</section>

<section class="profile-section">
  <div class="container">
    <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success">
      <i class="fa fa-check-circle"></i> <%= success %>
    </div>
    <% } %> <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger">
      <i class="fa fa-exclamation-circle"></i> <%= error %>
    </div>
    <% } %>
    <!-- Profile Header -->
    <div class="profile-header">
      <div class="profile-image-container">
        <img
          src="<%= user.profileImage ? user.profileImage : '/assets/profile-icon-9.png' %>"
          alt="<%= user.username %>"
          class="profile-image"
          onerror="this.onerror=null; this.src='/assets/profile-icon-9.png';"
        />
      </div>
      <div class="profile-header-info">
        <div class="profile-name"><%= user.username.toLowerCase() %></div>
        <div class="profile-email"><%= user.email %></div>
        <div class="profile-quick-actions">
          <a href="/profile/edit" class="btn btn-primary">
            <i class="fa fa-edit"></i> edit profile
          </a>
          <button
            class="btn btn-primary"
            onclick="window.location.href='/my-orders'"
          >
            <i class="fa fa-shopping-bag"></i> my orders
          </button>
          <button
            class="btn btn-primary"
            onclick="window.location.href='/wishlist'"
          >
            <i class="fa fa-heart-o"></i> wishlist
          </button>
        </div>
      </div>
    </div>

    <!-- Content Grid -->
    <div class="profile-layout">
      <!-- Personal Information -->
      <div class="info-card">
        <div class="card-header">
          <h2 class="card-title">
            <i class="fa fa-user"></i> personal information
          </h2>
        </div>
        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">Full Name</div>
            <div class="info-value"><%= user.username %></div>
          </div>
          <div class="info-item">
            <div class="info-label">Email Address</div>
            <div class="info-value"><%= user.email %></div>
          </div>
          <div class="info-item">
            <div class="info-label">Phone Number</div>
            <div class="info-value"><%= user.phone || 'Not provided' %></div>
          </div>
          <div class="info-item">
            <div class="info-label">Member Since</div>
            <div class="info-value">
              <%= new Date(user.createdAt).toLocaleDateString() %>
            </div>
          </div>

        <h4>Your Referral Code</h4>


     

        </div>
                <% if (user.referralCode) { %>
          <div class="referral-box">
            <span id="referralCode"><%= user.referralCode %></span>
            <button onclick="copyReferral()">Copy</button>
          </div>
        <% } else { %>
          <p>Referral code not available</p>
        <% } %>
      </div>



      <!-- Security -->
      <div class="info-card">
        <div class="card-header">
          <h2 class="card-title">
            <i class="fa fa-shield"></i> security settings
          </h2>
        </div>
        <div class="security-options">
          <div class="security-item">
            <div class="security-info">
              <h4>password</h4>
              <p>change your account password</p>
            </div>
            <a
              href="/profile/change-password"
              class="btn btn-secondary btn-small"
            >
              reset password
            </a>
          </div>
          <div class="security-item">
            <div class="security-info">
              <h4>forgot password</h4>
              <p>request a password reset link via email</p>
            </div>
            <a href="/forgot-password" class="btn btn-secondary btn-small">
              send reset link
            </a>
          </div>
        </div>
      </div>

      <!-- Replace the address section in your profile page with this -->

<div class="info-card full-width">
  <div class="card-header">
    <h2 class="card-title">
      <i class="fa fa-map-marker"></i> saved addresses
    </h2>
    <a href="/profile/address/add?returnUrl=/profile" class="btn btn-secondary btn-small">
      <i class="fa fa-plus"></i> add new
    </a>
  </div>

  <% if (user.addresses && user.addresses.length > 0) { %> 
  <% const defaultAddress = user.addresses.find(a => a.isDefault); 
     const otherAddresses = user.addresses.filter(a => !a.isDefault); %>

  <!-- DEFAULT ADDRESS SECTION -->
  <% if (defaultAddress) { %>
  <h3 style="margin-bottom: 15px; font-size: 16px; color: #222">
    Default Address
  </h3>

  <div class="address-item default-address">
    <div class="default-badge">Default</div>

    <div class="address-type">
      <i class="fa fa-star" style="color: #ffa500"></i> <%= defaultAddress.type %>
      <% if (defaultAddress.label) { %> - <%= defaultAddress.label %><% } %>
    </div>

    <div class="address-text">
      <%= defaultAddress.street %><br />
      <%= defaultAddress.city %>, <%= defaultAddress.state %> <%= defaultAddress.zipCode %><br />
      <% if (defaultAddress.country) { %><%= defaultAddress.country %><% } %>
    </div>

    <div style="margin-top: 15px; display: flex; gap: 10px">
      <!-- Edit -->
      <a
        href="/profile/address/<%= defaultAddress._id %>/edit?returnUrl=/profile"
        class="btn btn-secondary btn-small address-btn"
        style="background: #d9e8ff; border-color: #88aaff"
      >
        <i class="fa fa-edit"></i> Edit
      </a>

      <!-- Delete -->
      <form
        action="/profile/address/<%= defaultAddress._id %>/delete?returnUrl=/profile"
        method="POST"
        class="delete-address-form"
      >
        <button
          class="btn btn-secondary btn-small address-btn"
          style="background: #ffe3e3; border-color: #ff9d9d"
        >
          <i class="fa fa-trash"></i> Delete
        </button>
      </form>
    </div>
  </div>

  <hr style="margin: 30px 0; border: 0; border-top: 1px solid #eee" />
  <% } %>

  <!-- OTHER ADDRESSES -->
  <h3 style="margin-bottom: 15px; font-size: 16px; color: #222">
    Other Addresses
  </h3>

  <% if (otherAddresses.length > 0) { %>
  <div class="address-list">
    <% otherAddresses.forEach(address => { %>
    <div class="address-item">
      <div class="address-type">
        <%= address.type %>
        <% if (address.label) { %> - <%= address.label %><% } %>
      </div>

      <div class="address-text">
        <%= address.street %><br />
        <%= address.city %>, <%= address.state %> <%= address.zipCode %><br />
        <% if (address.country) { %><%= address.country %><% } %>
      </div>

      <div style="margin-top: 15px; display: flex; gap: 10px">

          <button
          type="button"
            class="btn btn-secondary btn-small set-default-btn"
            style="margin-top: 10px"
            data-address-id="<%= address._id %>"
            data-return-url="<%= returnUrl %>"
          >
            <i class="fa fa-star-o"></i> Set as Default
          </button>


        <!-- Edit -->
        <a
          href="/profile/address/<%= address._id %>/edit?returnUrl=/profile"
          class="btn btn-secondary btn-small address-btn"
          style="background: #d9e8ff; border-color: #88aaff"
        >
          <i class="fa fa-edit"></i> Edit
        </a>

        <!-- Delete -->
        <form
          action="/profile/address/<%= address._id %>/delete?returnUrl=/profile"
          
          class="delete-address-form"
        >
          <button
          type="submit"
            class="btn btn-secondary btn-small address-btn"
            style="background: #ffe3e3; border-color: #ff9d9d"
          >
            <i class="fa fa-trash"></i> Delete
          </button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <p style="color: #888">No other addresses saved.</p>
  <% } %> 

  <% } else { %>
  <div class="empty-state">
    <i class="fa fa-map-marker"></i>
    <p>no saved addresses yet</p>
  </div>
  <% } %>
</div>
    </div>
  </div>
</section>

<script>

  src="https://cdn.jsdelivr.net/npm/sweetalert2@11">

    document.addEventListener("DOMContentLoaded", () => {
        const defaultBtns = document.querySelectorAll('.set-default-btn');

        defaultBtns.forEach(btn => {
            btn.addEventListener('click', async function() {
                const addressId = this.dataset.addressId;
                const returnUrl = this.dataset.returnUrl;
                
                const url = `/profile/address/${addressId}/set-default`;
                
                this.disabled = true;
                this.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Setting...';

                try {
                    const response = await fetch(url, {
                        method: 'PATCH',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                       
                        body: JSON.stringify({ returnUrl }) 
                    });

                    const responseData = await response.json();

                    if (response.ok && responseData.success) {
                     
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: responseData.message,
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                     
                            window.location.reload(); 
                        });

                    } else {
                    
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: responseData.message || 'Failed to set default address.',
                            confirmButtonColor: '#dc3545'
                        });
                
                        this.disabled = false;
                        this.innerHTML = '<i class="fa fa-star-o"></i> Set as Default';
                    }

                } catch (error) {
                    console.error('AJAX Submission Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Network Error',
                        text: 'Could not connect to the server.',
                        confirmButtonColor: '#dc3545'
                    });
                    // Re-enable button on network error
                    this.disabled = false;
                    this.innerHTML = '<i class="fa fa-star-o"></i> Set as Default';
                }
            });
        });
    });

  document.querySelectorAll(".delete-address-form").forEach((form) => {
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const actionUrl = form.getAttribute("action");

    const result = await Swal.fire({
      title: "Delete this address?",
      text: "You won't be able to recover it!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#d33",
      cancelButtonColor: "#3085d6",
      confirmButtonText: "Yes, delete it!",
    });

    if (!result.isConfirmed) return;

    Swal.fire({
      title: "Deleting...",
      allowOutsideClick: false,
      didOpen: () => Swal.showLoading(),
    });

    try {
      const response = await fetch(actionUrl, {
        method: "DELETE",
      });

      const data = await response.json();

      if (response.ok) {
        Swal.fire({
          icon: "success",
          title: "Deleted!",
          text: data.message,
          timer: 1500,
          showConfirmButton: false,
        }).then(() => {
          window.location.href = data.redirectUrl;
        });
      } else {
        throw new Error(data.message);
      }
    } catch (err) {
      Swal.fire("Error", err.message || "Delete failed", "error");
    }
  });
});

    function copyReferral() {
    const code = document.getElementById("referralCode").innerText;
    navigator.clipboard.writeText(code).then(() => {
      alert("Referral code copied!");
    });
  }
</script>
> <%- include('../partials/user/footer') %>

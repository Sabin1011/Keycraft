<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/css/user/about.css">

<div class="about-wrapper">
  <div class="about-container">

    <!-- HERO -->
    <div class="about-hero">
      <h1>KEYCRAFT</h1>

      <div class="keyboard">
        <div class="key">K</div>
        <div class="key">E</div>
        <div class="key">Y</div>
        <div class="key">⌨</div>
      </div>

      <p>
        Crafted for precision. Designed for comfort.
        KeyCraft builds premium mechanical keyboards that blend performance,
        durability, and style.
      </p>
    </div>

    <!-- CONTENT -->
    <div class="section">

      <div class="card">
        <h3>Who We Are</h3>
        <p>
          KeyCraft is a modern mechanical keyboard brand focused on delivering
          high-quality keyboards for gamers, developers, creators, and everyday
          professionals who value tactile feedback and reliability.
        </p>
      </div>

      <div class="card">
        <h3>What We Build</h3>
        <p>
          From minimalist office setups to RGB-powered gaming desks,
          our keyboards are engineered with premium switches,
          durable keycaps, and long-lasting builds.
        </p>
      </div>

      <div class="card">
        <h3>Connectivity Options</h3>
        <p>
          Choose the way you connect. Every KeyCraft keyboard is designed
          for flexibility and seamless switching.
        </p>

        <div class="connections">
          <span class="chip">Wired (USB)</span>
          <span class="chip">Wireless</span>
          <span class="chip">Bluetooth</span>
          <span class="chip">Multi-Device</span>
        </div>
      </div>

    </div>

  </div>
</div>

<%- include('../partials/user/footer') %>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - KeyCraft</title>

    <link
      href="https://fonts.googleapis.com/css?family=Questrial|Raleway:700,900"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/forgotNewPassword.css">


  </head>
  <body>
    <section class="reset-password-section">
      <div class="container">
        <div class="reset-password-container">
          <div class="reset-password-form">
            <div class="form-icon">
              <i class="fa fa-key"></i>
            </div>

            <h2 class="form-title">set your new password</h2>

            <p class="form-description">
              please enter a strong new password and confirm it below to secure
              your account.
            </p>

            <!-- Backend Error -->
            <% if (typeof error !== "undefined") { %>
            <div class="error-message active"><%= error %></div>
            <% } %>

            <form action="/reset-password-success" method="POST">
              <!-- Email comes from backend -->
              <input type="hidden" name="email" value="<%= email %>" />

              <div class="form-group">
                <label for="password" class="form-label">new password *</label>
                <input
                  type="password"
                  name="password"
                  class="form-input"
                  placeholder="enter new password (min. 8 characters)"
                  required
                  minlength="8"
                />
              </div>

              <div class="form-group">
                <label for="confirmPassword" class="form-label"
                  >confirm new password *</label
                >
                <input
                  type="password"
                  name="confirmPassword"
                  class="form-input"
                  placeholder="re-enter new password"
                  required
                  minlength="8"
                />
              </div>

              <button type="submit" class="btn btn-primary">
                <i class="fa fa-refresh"></i> reset password
              </button>

              <button
                type="button"
                class="btn btn-secondary"
                onclick="window.location.href='/login'"
              >
                <i class="fa fa-sign-in"></i> back to login
              </button>
            </form>

            <div class="info-box">
              <p>
                <i class="fa fa-info-circle"></i> <b>security tip:</b> choose a
                unique password with uppercase, lowercase, numbers & symbols.
              </p>
            </div>

            <div class="back-to-login">
              problem resetting password? <a href="/support">contact support</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </body>
</html>

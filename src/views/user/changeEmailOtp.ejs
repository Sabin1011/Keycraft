<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/css/changeEmailOtp.css">

<section class="otp-section">
  <div class="otp-container">
    <div class="otp-icon">
      <i class="fa fa-envelope"></i>
    </div>

    <h1 class="otp-title">verify your email</h1>
    <p class="otp-description">
      enter the 6-digit code sent to<br />
      <span class="otp-email"><%= newEmail %></span>
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="error-message"><%= error %></div>
    <% } %>

    <form action="/profile/edit-profile/verify-otp" method="POST" id="otpForm">
      <div class="otp-inputs">
        <input type="text" class="otp-input" maxlength="1" data-index="0" />
        <input type="text" class="otp-input" maxlength="1" data-index="1" />
        <input type="text" class="otp-input" maxlength="1" data-index="2" />
        <input type="text" class="otp-input" maxlength="1" data-index="3" />
        <input type="text" class="otp-input" maxlength="1" data-index="4" />
        <input type="text" class="otp-input" maxlength="1" data-index="5" />
      </div>

      <input type="hidden" name="otp" id="otpValue" />

      <button type="submit" class="btn btn-primary" id="verifyBtn">
        verify code
      </button>
    </form>

    <div class="resend-section">
      didn't receive code?
      <form action="/profile/resend-otp" method="POST" style="display: inline">
        <button type="submit" class="resend-btn" id="resendBtn">resend</button>
      </form>
      <span id="timer"></span>
    </div>
  </div>
</section>

<script>
  const inputs = document.querySelectorAll(".otp-input");
  const otpValue = document.getElementById("otpValue");
  const verifyBtn = document.getElementById("verifyBtn");
  const resendBtn = document.getElementById("resendBtn");
  const timer = document.getElementById("timer");

  inputs[0].focus();

  // Handle input
  inputs.forEach((input, index) => {
    input.addEventListener("input", (e) => {
      // Only allow numbers
      e.target.value = e.target.value.replace(/[^0-9]/g, "");

      // Move to next input
      if (e.target.value && index < 5) {
        inputs[index + 1].focus();
      }

      updateOTP();
    });

    // Handle backspace
    input.addEventListener("keydown", (e) => {
      if (e.key === "Backspace" && !e.target.value && index > 0) {
        inputs[index - 1].focus();
      }
    });

    // Handle paste
    input.addEventListener("paste", (e) => {
      e.preventDefault();
      const pasteData = e.clipboardData.getData("text").replace(/[^0-9]/g, "");

      if (pasteData.length === 6) {
        pasteData.split("").forEach((char, i) => {
          if (inputs[i]) inputs[i].value = char;
        });
        inputs[5].focus();
        updateOTP();
      }
    });
  });

  function updateOTP() {
    otpValue.value = Array.from(inputs)
      .map((i) => i.value)
      .join("");
  }

  // Simple timer for resend button
  let countdown = 60;
  const timerInterval = setInterval(() => {
    countdown--;
    if (countdown > 0) {
      timer.textContent = ` (${countdown}s)`;
      resendBtn.disabled = true;
    } else {
      timer.textContent = "";
      resendBtn.disabled = false;
      clearInterval(timerInterval);
    }
  }, 1000);

  // Form submission
  document.getElementById("otpForm").addEventListener("submit", function () {
    verifyBtn.disabled = true;
    verifyBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> verifying...';
  });
</script>

<%- include('../partials/user/footer') %>

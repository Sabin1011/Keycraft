<%- include('../partials/user/header') %>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Questrial', sans-serif;
        background: #f5f5f5;
        color: #222;
    }


    /* Page Header */
    .page-header {
        padding: 60px 0 300px;
        text-align: center;
        background: #222 url('/assets/shop-page-bg.png') center/cover no-repeat;
        color: #fff;
    }

    .page-header h1 {
        font-size: 36px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .page-header p {
        font-size: 16px;
        font-weight: 500;
        color: #ddd;
    }

    /* Layout */
    .products-section {
        padding: 50px 15px;
    }

    .products-layout {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
    }

    /* Sidebar */
    .filters-sidebar {
        background: #fff;
        padding: 25px;
        border-radius: 15px;
        border: 1px solid #eee;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    .filter-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #333;
    }

    /* Search & Price */
    #searchInput {
        padding: 10px 15px;
        border-radius: 25px;
        border: 1px solid #ddd;
        width: 100%;
        font-size: 14px;
        transition: all 0.3s;
    }

    #searchInput:focus {
        outline: none;
        border-color: #222;
        box-shadow: 0 0 6px rgba(0,0,0,0.1);
    }

    .search-controls {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
    }

    .clear-btn {
        padding: 10px 15px;
        border: 1px solid #222;
        background: #fff;
        cursor: pointer;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .clear-btn:hover {
        background: #222;
        color: #fff;
    }

    .price-slider {
        width: 100%;
        margin: 10px 0 15px;
    }

    /* Categories */
    .category-list {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .category-list li {
        flex: 1 1 45%;
    }

    .category-link {
        display: inline-block;
        padding: 8px 15px;
        font-size: 13px;
        border-radius: 25px;
        text-decoration: none;
        text-transform: lowercase;
        color: #555;
        border: 1px solid transparent;
        transition: all 0.3s;
        text-align: center;
    }

    .category-link:hover {
        background: #222;
        color: #fff;
        border-color: #222;
    }

    .category-link.active-cat {
        background: #222;
        color: #fff;
        border-color: #222;
        font-weight: 600;
    }

    /* Product Grid */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }

    .product-card {
        background: #fff;
        border-radius: 15px;
        overflow: hidden;
        transition: 0.3s;
        border: 1px solid #eee;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 25px rgba(0,0,0,0.1);
    }

    .product-image img {
        width: 100%;
        height: 240px;
        object-fit: contain;
        background: #f9f9f9;
    }

    .product-info {
        padding: 15px;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .product-category {
        font-size: 12px;
        color: #888;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .product-name {
        font-size: 16px;
        font-weight: 500;
        margin-bottom: 8px;
        color: #222;
    }

    .product-price {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 12px;
        color: #222;
    }

    .product-actions {
        display: flex;
        gap: 10px;
    }

    .btn-small {
        flex: 1;
        padding: 10px;
        border: 1px solid #222;
        background: #fff;
        border-radius: 25px;
        text-transform: lowercase;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-small:hover {
        background: #222;
        color: #fff;
    }

    .btn-primary {
        background: #222;
        color: #fff;
        border-color: #222;
    }

    /* Sort dropdown */
    select#sortSelect {
        padding: 8px 15px;
        border-radius: 25px;
        border: 1px solid #ddd;
        font-size: 14px;
        background: #fff;
        cursor: pointer;
        transition: all 0.3s;
    }

    select#sortSelect:focus {
        outline: none;
        border-color: #222;
        box-shadow: 0 0 6px rgba(0,0,0,0.1);
    }

    /* Pagination */
    .pagination {
        margin-top: 40px;
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .pagination a {
        padding: 8px 15px;
        background: #fff;
        border: 1px solid #ddd;
        text-decoration: none;
        color: #222;
        border-radius: 25px;
        transition: all 0.3s;
    }

    .pagination a:hover {
        background: #222;
        color: #fff;
        border-color: #222;
    }

    .pagination a.active {
        background: #222;
        color: #fff;
        border-color: #222;
    }

    .product-actions a{
        text-decoration: none;
        display: flex;
        justify-content: center;
    }

    @media(max-width:768px){
        .products-layout {
            grid-template-columns: 1fr;
        }

        .category-list li {
            flex: 1 1 100%;
        }
    }
</style>

<section class="page-header">
    <h1>Shop</h1>
    <p>Explore our product collection</p>
</section>

<section class="products-section">
    <div class="container">
        <div class="products-layout">

            <!-- Sidebar -->
            <aside class="filters-sidebar">

                <h3 class="filter-title">Search</h3>
                <div class="search-controls">
                    <input id="searchInput" type="text" placeholder="Search..."
                        value="<%= search %>" onkeyup="if(event.key === 'Enter') applyFilters()" />
                    <button class="clear-btn" onclick="clearSearch()">✕</button>
                </div>

                <h3 class="filter-title" style="margin-top:25px;">Categories</h3>
                <ul class="category-list">
                    <li>
                        <a href="#" class="category-link <%= activeCategory === '' ? 'active-cat' : '' %>"
                           onclick="event.preventDefault(); applyCategoryFilter('')">all products</a>
                    </li>
                    <% categories.forEach(cat => { %>
                    <li>
                        <a href="#" class="category-link <%= activeCategory === cat._id.toString() ? 'active-cat' : '' %>"
                           onclick="event.preventDefault(); applyCategoryFilter('<%= cat._id %>')">
                            <%= cat.name.toLowerCase() %>
                        </a>
                    </li>
                    <% }) %>
                </ul>

                <h3 class="filter-title" style="margin-top:25px;">Price Range</h3>
                <input type="range" id="priceRange" min="0" max="<%= maxPriceValue %>"
                    value="<%= maxPrice %>" class="price-slider" />
                <p>Max: ₹<span id="maxPriceLabel"><%= maxPrice %></span></p>

                <button class="clear-btn" style="width:100%; margin-top:20px;"
                    onclick="applyFilters(true)">Clear All Filters</button>
            </aside>

            <!-- Products -->
            <div>
                <div style="display:flex; justify-content:flex-end; margin-bottom:20px;">
                    <select id="sortSelect" onchange="applyFilters()">
                        <option value="a-z" <%= activeSort === 'a-z' ? 'selected' : '' %>>Sort by: Name A-Z</option>
                        <option value="z-a" <%= activeSort === 'z-a' ? 'selected' : '' %>>Sort by: Name Z-A</option>
                        <option value="low-high" <%= activeSort === 'low-high' ? 'selected' : '' %>>Sort by: Price Low-High</option>
                        <option value="high-low" <%= activeSort === 'high-low' ? 'selected' : '' %>>Sort by: Price High-Low</option>
                    </select>
                </div>

                <div class="product-grid">
                    <% if (products.length === 0) { %>
                    <p style="grid-column:1/-1; text-align:center; color:#888; font-size:1.1em;">No products found</p>
                    <% } %>

                    <% products.forEach(p => { %>
                    <div class="product-card">
                        <div class="product-image">
                            <% if (p.images && p.images.length > 0) { %>
                                <img src="<%= p.images[0] %>" alt="<%= p.name %>" />
                            <% } else { %>
                                <img src="/images/default-product.png" alt="No Image" />
                            <% } %>
                        </div>

                        <div class="product-info">
                            <div class="product-category"><%= p.category ? p.category.name : "Uncategorized" %></div>
                            <div class="product-name"><%= p.name %></div>
                            <div class="product-price">₹<%= p.price.toFixed(2) %></div>

                            <div class="product-actions">
                                <a href="/singleProduct/<%= p._id %>" class="btn-small btn-primary">details</a>
                                <button class="btn-small" disabled>add to cart</button>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>

                <div class="pagination">
                    <% for (let i = 1; i <= totalPages; i++) { %>
                    <a href="/shop?page=<%= i %>&search=<%= search %>&maxPrice=<%= maxPrice %>&category=<%= activeCategory %>&sort=<%= activeSort %>"
                        class="<%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    const priceSlider = document.getElementById("priceRange");
    const maxPriceLabel = document.getElementById("maxPriceLabel");
    const searchInput = document.getElementById("searchInput");
    const sortSelect = document.getElementById("sortSelect");

    maxPriceLabel.textContent = priceSlider.value;

    priceSlider.oninput = function () {
        maxPriceLabel.textContent = this.value;
        applyFilters();
    };

    function applyFilters(reset = false) {
        const url = new URL(window.location.href);
        url.searchParams.set("page", 1);

        if (reset) {
            url.searchParams.delete("search");
            url.searchParams.set("maxPrice", "<%= maxPriceValue %>");
            url.searchParams.delete("category");
            url.searchParams.set("sort", "a-z");
            window.location.href = url.toString();
            return;
        }

        url.searchParams.set("search", searchInput.value);
        url.searchParams.set("maxPrice", priceSlider.value);
        url.searchParams.set("sort", sortSelect.value);

        const currentCategory = url.searchParams.get("category");
        if (!currentCategory) url.searchParams.delete("category");

        window.location.href = url.toString();
    }

    function applyCategoryFilter(categoryId) {
        const url = new URL(window.location.href);
        url.searchParams.set("page", 1);

        if (categoryId) url.searchParams.set("category", categoryId);
        else url.searchParams.delete("category");

        url.searchParams.set("search", searchInput.value);
        url.searchParams.set("maxPrice", priceSlider.value);
        url.searchParams.set("sort", sortSelect.value);

        window.location.href = url.toString();
    }

    function clearSearch() {
        searchInput.value = "";
        applyFilters();
    }
</script>

<%- include('../partials/user/footer') %>

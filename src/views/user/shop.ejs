<%- include('../partials/user/header') %>

<link rel="stylesheet" href="/css/user/shop.css">
<section class="page-header">
    <h1>Shop</h1>
    <p>Explore our product collection</p>
</section>

<section class="products-section">
    <div class="container">
        <div class="products-layout">

            <aside class="filters-sidebar">

                <h3 class="filter-title">Search</h3>
                <div class="search-controls">
                    <input id="searchInput" type="text" placeholder="Search..."
                        value="<%= search %>" onkeyup="if(event.key === 'Enter') applyFilters()" />
                    <button class="clear-btn" onclick="clearSearch()">✕</button>
                </div>

                <h3 class="filter-title" style="margin-top:25px;">Categories</h3>
                <ul class="category-list">
                    <li>
                        <a href="#" class="category-link <%= activeCategory === '' ? 'active-cat' : '' %>"
                           onclick="event.preventDefault(); applyCategoryFilter('')">all products</a>
                    </li>
                    <% categories.forEach(cat => { %>
                    <li>
                        <a href="#" class="category-link <%= activeCategory === cat._id.toString() ? 'active-cat' : '' %>"
                           onclick="event.preventDefault(); applyCategoryFilter('<%= cat._id %>')">
                            <%= cat.name.toLowerCase() %>
                        </a>
                    </li>
                    <% }) %>
                </ul>

                <h3 class="filter-title" style="margin-top:25px;">Price Range</h3>
                <input type="range" id="priceRange" min="0" max="<%= maxPriceValue %>"
                    value="<%= maxPrice %>" class="price-slider" />
                <p>Max: ₹<span id="maxPriceLabel"><%= maxPrice %></span></p>

                <button class="clear-btn" style="width:100%; margin-top:20px;"
                    onclick="applyFilters(true)">Clear All Filters</button>
            </aside>

            <!-- Products -->
            <div>
                <div style="display:flex; justify-content:flex-end; margin-bottom:20px;">
                    <select id="sortSelect" onchange="applyFilters()">
                        <option value="a-z" <%= activeSort === 'a-z' ? 'selected' : '' %>>Sort by: Name A-Z</option>
                        <option value="z-a" <%= activeSort === 'z-a' ? 'selected' : '' %>>Sort by: Name Z-A</option>
                        <option value="low-high" <%= activeSort === 'low-high' ? 'selected' : '' %>>Sort by: Price Low-High</option>
                        <option value="high-low" <%= activeSort === 'high-low' ? 'selected' : '' %>>Sort by: Price High-Low</option>
                    </select>
                </div>

                <div class="product-grid">
                    <% if (products.length === 0) { %>
                    <p style="grid-column:1/-1; text-align:center; color:#888; font-size:1.1em;">No products found</p>
                    <% } %>

                    <% products.forEach(p => { %>
                    <div class="product-card">
                        
                        <button 
                            onclick="toggleWishlist(event, this, '<%= p._id %>')" 
                            class="wishlist-btn" 
                            data-product-id="<%= p._id %>"
                            title="<%= wishlistProductIds.includes(p._id.toString()) ? 'Remove from wishlist' : 'Add to wishlist' %>">
                            <i class="<%= wishlistProductIds.includes(p._id.toString()) ? 'fas' : 'far' %> fa-heart"></i>
                        </button>

                        <div class="product-image">
                            <% if (p.images && p.images.length > 0) { %>
                                <img src="<%= p.images[0] %>" alt="<%= p.name %>" />
                            <% } else { %>
                                <img src="/images/default-product.png" alt="No Image" />
                            <% } %>
                        </div>

                        <div class="product-info">
                            <div class="product-category"><%= p.category ? p.category.name : "Uncategorized" %></div>
                            <div class="product-name"><%= p.name %></div>
                            <div class="product-price">
                                <% if (p.hasOffer) { %>
                                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                    <span style="text-decoration:line-through; color:#888; font-size:14px;">
                                        ₹<%= p.originalPrice.toFixed(2) %>
                                    </span>

                                    <span style="font-size:18px; font-weight:700;">
                                        ₹<%= p.discountedPrice.toFixed(2) %>
                                    </span>

                                    <span style="background:#27ae60; color:#fff; padding:3px 8px; border-radius:20px; font-size:11px; font-weight:600;">
                                        <% if (p.offerDetails.discountType === 'percentage') { %>
                                        <%= p.discountPercentage %>% OFF
                                        <% } else { %>
                                        ₹<%= p.discountAmount.toFixed(0) %> OFF
                                        <% } %>
                                    </span>
                                </div>

                                <div style="font-size:11px; color:#e67e22; margin-top:4px; font-weight:600;">
                                    🎉 <%= p.offerDetails.title %>
                                </div>
                                <% } else { %>
                                    ₹<%= p.originalPrice.toFixed(2) %>
                                <% } %>
                            </div>


                                <div class="product-actions">
                                    <a href="/singleProduct/<%= p._id %>" class="btn-small btn-primary">details</a>

                                    <% if (p.totalStock <= 0) { %>
                                        <button class="btn-small" disabled style="background:#ccc; cursor:not-allowed; opacity:0.7;">
                                            out of stock
                                        </button>
                                    <% } else { %>
                                        <form action="/cart/add/<%= p._id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="btn-small btn-primary">
                                                add to cart
                                            </button>
                                        </form>
                                    <% } %>
                                </div>

                                <% if (p.totalStock <= 0) { %>
                                    <div style="position:absolute; top:15px; left:15px; background:#e74c3c; color:white; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:600; z-index:10;">
                                        Out of Stock
                                    </div>
                                <% } else if (p.totalStock <= 5) { %>
                                    <div style="position:absolute; top:15px; left:15px; background:#e67e22; color:white; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:600; z-index:10;">
                                        Only <%= p.totalStock %> left!
                                    </div>
                                <% } %>
                                
                        </div>
                    </div>
                    <% }) %>
                </div>

                <div class="pagination">
                    <% for (let i = 1; i <= totalPages; i++) { %>
                    <a href="/shop?page=<%= i %>&search=<%= search %>&maxPrice=<%= maxPrice %>&category=<%= activeCategory %>&sort=<%= activeSort %>"
                        class="<%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    const priceSlider = document.getElementById("priceRange");
    const maxPriceLabel = document.getElementById("maxPriceLabel");
    const searchInput = document.getElementById("searchInput");
    const sortSelect = document.getElementById("sortSelect");
    

    maxPriceLabel.textContent = priceSlider.value;

    priceSlider.oninput = function () {
        maxPriceLabel.textContent = this.value;
        applyFilters();
    };

    function applyFilters(reset = false) {
        const url = new URL(window.location.href);
        url.searchParams.set("page", 1);

        if (reset) {
            url.searchParams.delete("search");
            url.searchParams.set("maxPrice", "<%= maxPriceValue %>");
            url.searchParams.delete("category");
            url.searchParams.set("sort", "a-z");
            window.location.href = url.toString();
            return;
        }

        url.searchParams.set("search", searchInput.value);
        url.searchParams.set("maxPrice", priceSlider.value);
        url.searchParams.set("sort", sortSelect.value);

        const currentCategory = url.searchParams.get("category");
        if (!currentCategory) url.searchParams.delete("category");

        window.location.href = url.toString();
    }

    function applyCategoryFilter(categoryId) {
        const url = new URL(window.location.href);
        url.searchParams.set("page", 1);

        if (categoryId) url.searchParams.set("category", categoryId);
        else url.searchParams.delete("category");

        url.searchParams.set("search", searchInput.value);
        url.searchParams.set("maxPrice", priceSlider.value);
        url.searchParams.set("sort", sortSelect.value);

        window.location.href = url.toString();
    }

    function clearSearch() {
        searchInput.value = "";
        applyFilters();
    }

    async function toggleWishlist(event, button, productId) {
        event.preventDefault();
        event.stopPropagation();

        const icon = button.querySelector('i');
        const isInWishlist = icon.classList.contains('fas');

        const url = isInWishlist 
            ? `/wishlist/remove/${productId}` 
            : `/wishlist/add/${productId}`;

        try {
            const response = await fetch(url, { 
                method: "POST",
                headers: {
                    'Content-Type': 'application/json',
                }
            });
            
            const data = await response.json();

            if (response.status === 401) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Login Required',
                    text: data.message || 'Please login to add items to your wishlist',
                    showCancelButton: true,
                    confirmButtonText: 'Go to Login',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#2c3e50',
                    cancelButtonColor: '#95a5a6',
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/login';
                    }
                });
                return;
            }

            if (data.success) {

                icon.classList.toggle("fas");
                icon.classList.toggle("far");

                button.title = icon.classList.contains('fas') 
                    ? 'Remove from wishlist' 
                    : 'Add to wishlist';

                updateWishlistCount();

                const message = icon.classList.contains('fas') 
                    ? 'Added to wishlist' 
                    : 'Removed from wishlist';
                
                Swal.fire({
                    icon: 'success',
                    title: message,
                    timer: 1500,
                    showConfirmButton: false,
                    position: 'top-end',
                    toast: true,
                    background: '#d4edda',
                    color: '#155724',
                });
            }
        } catch (err) {
            console.error('Error toggling wishlist:', err);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Failed to update wishlist. Please try again.',
                confirmButtonColor: '#e74c3c',
            });
        }
    }

    async function updateWishlistCount() {
        try {
            const res = await fetch('/api/wishlist/count');
            const data = await res.json();
            const badge = document.getElementById('wishlistCount');
            if (badge) {
                badge.textContent = data.count;
                badge.style.display = data.count > 0 ? 'block' : 'none';
            }
        } catch (err) {
            console.error('Error updating wishlist count:', err);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateWishlistCount();
    });
</script>

<%- include('../partials/user/footer') %>
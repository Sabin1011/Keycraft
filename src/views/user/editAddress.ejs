<%- include('../partials/user/header') %>

<link rel="stylesheet" href="/css/addressForm.css">

<section class="breadcrumb">
  <div class="container">
    <a href="/home">home</a>
    <span>/</span>
    <% if (returnUrl === '/checkout') { %>
      <a href="/checkout">checkout</a>
    <% } else { %>
      <a href="/profile">my profile</a>
    <% } %>
    <span>/</span>
    <span style="color: #222">edit address</span>
  </div>
</section>

<section class="address-section">
  <div class="container">
    <% if (success) { %>
    <div style="padding: 15px 20px; background: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 10px; margin-bottom: 25px;">
      <i class="fa fa-check-circle"></i> <%= success %>
    </div>
    <% } %>
    <% if (error) { %>
    <div style="padding: 15px 20px; background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 10px; margin-bottom: 25px;">
      <i class="fa fa-exclamation-circle"></i> <%= error %>
    </div>
    <% } %>

    <div class="page-header">
      <div class="page-title">edit address</div>
      <div class="page-subtitle">update your address details below</div>
    </div>

    <form action="/profile/address/<%= address._id %>/edit" method="POST">
      <input type="hidden" name="returnUrl" value="<%= returnUrl %>">
      <%- include('../partials/addressForm', { address, mode: 'edit', returnUrl }) %>
    </form>
  </div>
</section>

<%- include('../partials/user/footer') %>
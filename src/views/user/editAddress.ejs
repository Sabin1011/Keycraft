<%- include('../partials/user/header') %>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Questrial", sans-serif;
    background: #fafafa;
    color: #222;
    min-height: 100vh;
  }

  .breadcrumb {
    padding: 15px 0;
    background: #fff;
    border-bottom: 1px solid #e5e5e5;
  }

  .breadcrumb a {
    color: #666;
    text-decoration: none;
    font-size: 13px;
    transition: color 0.3s;
  }

  .breadcrumb a:hover {
    color: #222;
  }

  .breadcrumb span {
    color: #999;
    margin: 0 8px;
  }

  .address-section {
    padding: 40px 0;
    min-height: calc(100vh - 200px);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .page-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 15px;
    padding: 40px;
    margin-bottom: 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    color: #fff;
  }

  .page-title {
    font-size: 32px;
    font-weight: 700;
    text-transform: lowercase;
    margin-bottom: 8px;
  }

  .page-subtitle {
    font-size: 16px;
    opacity: 0.9;
  }

  .form-layout {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
  }

  .form-card {
    background: #fff;
    border-radius: 12px;
    border: 1px solid #e5e5e5;
    padding: 35px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: all 0.3s;
    height: fit-content;
  }

  .form-card:hover {
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .form-card.full-width {
    grid-column: 1 / -1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 2px solid #f5f5f5;
  }

  .card-title {
    font-size: 20px;
    font-weight: 700;
    text-transform: lowercase;
    color: #222;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .card-title i {
    color: #667eea;
  }

  .form-group {
    margin-bottom: 25px;
  }

  .form-label {
    display: block;
    font-size: 11px;
    color: #999;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }

  .form-label.required::after {
    content: "*";
    color: #e74c3c;
    margin-left: 4px;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid #e5e5e5;
    border-radius: 8px;
    font-size: 14px;
    font-family: "Questrial", sans-serif;
    transition: all 0.3s;
    background: #fff;
    color: #222;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-select {
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%23666' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 16px center;
    padding-right: 40px;
  }

  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.3s;
    border: 2px solid transparent;
  }

  .checkbox-group:hover {
    background: #fff;
    border-color: #667eea;
  }

  .checkbox-group input[type="checkbox"] {
    width: 20px;
    height: 20px;
    cursor: pointer;
    accent-color: #667eea;
    margin-top: 2px;
    flex-shrink: 0;
  }

  .checkbox-content {
    flex: 1;
  }

  .checkbox-label {
    font-size: 16px;
    color: #222;
    cursor: pointer;
    user-select: none;
    font-weight: 600;
    text-transform: lowercase;
    margin-bottom: 4px;
  }

  .checkbox-description {
    font-size: 13px;
    color: #666;
    line-height: 1.6;
  }

  .helper-text {
    font-size: 12px;
    color: #999;
    margin-top: 6px;
  }

  .address-preview {
    background: #f8f9fa;
    border-radius: 10px;
    padding: 25px;
    margin-top: 20px;
    border: 2px solid #e5e5e5;
  }

  .preview-title {
    font-size: 11px;
    color: #999;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }

  .preview-content {
    font-size: 14px;
    color: #666;
    line-height: 1.8;
  }

  .preview-empty {
    color: #999;
    font-style: italic;
  }

  .info-box {
    background: #fff9e6;
    border: 2px solid #ffe066;
    border-radius: 10px;
    padding: 20px;
    display: flex;
    gap: 15px;
    align-items: flex-start;
  }

  .info-box i {
    color: #f39c12;
    font-size: 20px;
    flex-shrink: 0;
  }

  .info-box-content h4 {
    font-size: 14px;
    font-weight: 600;
    text-transform: lowercase;
    margin-bottom: 5px;
    color: #222;
  }

  .info-box-content p {
    font-size: 13px;
    color: #666;
    line-height: 1.6;
  }

  .form-actions {
    display: flex;
    gap: 15px;
    margin-top: 0;
  }

  .btn {
    padding: 14px 32px;
    border: none;
    font-size: 14px;
    text-transform: lowercase;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.3s;
    font-family: "Questrial", sans-serif;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
    flex: 1;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
  }

  .btn-secondary {
    background: #f8f9fa;
    color: #666;
    border: 2px solid #e5e5e5;
  }

  .btn-secondary:hover {
    background: #222;
    color: #fff;
    border-color: #222;
  }

  @media (max-width: 1200px) {
    .form-layout {
      grid-template-columns: 1fr;
    }

    .container {
      padding: 0 25px;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 15px;
    }

    .page-header {
      padding: 30px 20px;
    }

    .page-title {
      font-size: 24px;
    }

    .form-card {
      padding: 25px 20px;
    }

    .form-actions {
      flex-direction: column;
    }
  }
</style>

<section class="breadcrumb">
  <div class="container">
    <a href="/home">home</a>
    <span>/</span>
    <a href="/profile">my profile</a>
    <span>/</span>
    <span style="color: #222">edit address</span>
  </div>
</section>

<section class="address-section">
  <div class="container">
    <% if (success) { %>
    <div
      style="
        padding: 15px 20px;
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        border-radius: 10px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 10px;
      "
    >
      <i class="fa fa-check-circle"></i> <%= success %>
    </div>
    <% } %> <% if (error) { %>
    <div
      style="
        padding: 15px 20px;
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        border-radius: 10px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 10px;
      "
    >
      <i class="fa fa-exclamation-circle"></i> <%= error %>
    </div>
    <% } %>
    <div class="page-header">
      <div class="page-title">edit address</div>
      <div class="page-subtitle">update your address details below</div>
    </div>

    <form action="/profile/address/<%= address._id %>/edit" method="POST">
      <div class="form-layout">
        <!-- TYPE -->
        <div class="form-card">
          <label class="form-label">address type</label>
          <input
            type="text"
            name="type"
            class="form-input"
          
            value="<%= address.type %>"
          />
        </div>

        <!-- STREET -->
        <div class="form-card">
          <label class="form-label">street</label>
          <input
            type="text"
            name="street"
            class="form-input"
    
            value="<%= address.street %>"
          />
        </div>

        <!-- CITY -->
        <div class="form-card">
          <label class="form-label">city</label>
          <input
            type="text"
            name="city"
            class="form-input"
         
            value="<%= address.city %>"
          />
        </div>

        <!-- STATE -->
        <div class="form-card">
          <label class="form-label">state</label>
          <input
            type="text"
            name="state"
            class="form-input"
        
            value="<%= address.state %>"
          />
        </div>

        <!-- ZIP -->
        <div class="form-card">
          <label class="form-label">zip code</label>
          <input
            type="text"
            name="zipCode"
            class="form-input"
          
            value="<%= address.zipCode %>"
          />
        </div>

        <!-- COUNTRY -->
        <div class="form-card">
          <label class="form-label">country</label>
          <input
            type="text"
            name="country"
            class="form-input"
            value="<%= address.country %>"
          />
        </div>
      </div>

      <button
        class="btn btn-primary"
        style="margin-top: 25px; background: #333; color: #fff"
      >
        <i class="fa fa-save"></i> save changes
      </button>
    </form>
  </div>
</section>

<%- include('../partials/user/footer') %>

<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/css/cart.css">

<section class="cart-container">
  <div class="container">
    <div class="cart-title">
      <h1>Shopping Cart</h1>
      <div class="title-underline"></div>
    </div>

    <% if (message) { %>
    <div class="alert-message alert-<%= messageType %>"><%= message %></div>
    <% } %> <% if (cart && cart.items && cart.items.length > 0) { %>
    <div class="cart-content">

      <!-- Cart Items -->
      <div class="cart-items">

        <% cart.items.forEach(item => { %>
        <div class="cart-item">
          <div class="item-image">
            <% if (item.product.images && item.product.images.length > 0) { %>
            <img
              src="<%= item.product.images[0] %>"
              alt="<%= item.product.name %>"
            />
            <% } else { %>
            <img src="/images/default-product.png" alt="No Image" />
            <% } %>
          </div>

          <div class="item-details">
            <div class="item-category">
              <%= item.product.category ? item.product.category.name :
              'Uncategorized' %>
            </div>
            <div class="item-name"><%= item.product.name %></div>

            <% if (!item.isAvailable) { %>
              <div style="color:#dc3545;font-size:13px;font-weight:600;margin-top:6px;">
                <%= item.outOfStockMessage %>
              </div>
            <% } %>

            <% if (item.selectedVariant) { %> <p style="color: #334d3e;">Variant:</p>
            <strong style="color: rgb(83, 187, 104);"><%= item.selectedVariant.name %></strong>
            <% } else { %>  
            <span style="color: red; font-size: 13px">
              Variant unavailable
            </span>
            <% } %> 

            <div class="item-price">
              <% if (item.discountedPrice < item.originalPrice) { %>
              <span
                style="
                  text-decoration: line-through;
                  color: #999;
                  font-size: 14px;
                "
              >
                ₹<span id="base-<%= item.product._id %>-<%= item.variantId %>">
                  <%= item.originalPrice.toFixed(2) %>
                </span>
              </span>

              <br />
              <% } %> ₹<span
                id="unit-<%= item.product._id %>-<%= item.variantId %>"
              >
                <%= item.discountedPrice.toFixed(2) %>
              </span>
              ×
              <span id="qty-text-<%= item.product._id %>-<%= item.variantId %>">
                <%= item.quantity %>
              </span>
              <span
                style="
                  margin-left: 8px;
                  background: #27ae60;
                  color: #fff;
                  padding: 3px 7px;
                  font-size: 11px;
                  font-weight: 600;
                  border-radius: 3px;
                "
              >
                <% if (item.offerDetails?.discountType === 'percentage') { %>
                <%= item.discountPercentage %>% OFF <% } else { %> ₹<%=
                item.discountAmount.toFixed(0) %> OFF <% } %>
              </span>

              <% if (item.offerDetails?.title) { %>
              <div
                style="
                  margin-top: 5px;
                  font-size: 11px;
                  color: #e67e22;
                  font-weight: 600;
                "
              >
                🎉 <%= item.offerDetails.title %>
              </div>
              <% } %>
            </div>
          </div>

          <div class="item-actions">
            <div class="quantity-control">
              <button
                class="quantity-btn decrease-btn"
                data-product="<%= item.product._id %>"
                data-variant="<%= item.variantId %>"
              >
                −
              </button>

              <span id="qty-<%= item.product._id %>-<%= item.variantId %>"
                ><%= item.quantity %></span
              >

              <button
                class="quantity-btn increase-btn"
                data-product="<%= item.product._id %>"
                data-variant="<%=item.variantId%>"
                <%if(!item.isAvailable) {%> disabled <%} %>
              >
                +
              </button>
            </div>

            <button
              class="remove-btn"
              data-product="<%= item.product._id %>"
              data-variant="<%= item.variantId %>"
            >
              Remove
            </button>
          </div>
          <a
            href="/singleProduct/<%= item.product._id %>?variant=<%=item.variantId%>"
            class="view-product-btn"
          >
            View Product
          </a>
        </div>
        <% }) %>
      </div>

      <div class="cart-summary">
        <h3 class="summary-title">Order Summary</h3>

        <div>
          Subtotal(<span id="subtotal-items"> <%= cartCount%> </span> items )
          ₹<span id="subtotal-amount"><%= cart.baseTotal.toFixed(2) %></span>
        </div>

        <%if(totalDiscount>0) {%>
        <div class="summary-row" style="color: #27ae60">
          <span>Discount</span>
          <span
            >- ₹<span id="discount-amount"
              ><%= totalDiscount.toFixed(2) %></span
            >
          </span>
        </div>
        <%}%>

        <div class="summary-row">
          <span>Shipping</span>
          <span>Free</span>
        </div>

        <div class="summary-row">
          <span>Total</span>
          <span id="grand-total">₹<%= cart.totalPrice.toFixed(2) %></span>
        </div>

        <% if (invalidItemExists) { %>
        <div
          style="
            color: red;
            font-size: 14px;
            margin-bottom: 10px;
            text-align: center;
          "
        >
          Some items in your cart are unavailable or out of stock. Please update
          your cart to proceed.
        </div>
        <% } %>
        <button id="checkoutBtn" class="checkout-btn">
          Proceed to Checkout
        </button>

        <div
          id="checkoutError"
          style="
            display: none;
            color: red;
            font-size: 14px;
            margin-top: 10px;
            text-align: center;
          "
        ></div>

        <a href="/shop" class="continue-shopping">Continue Shopping</a>
      </div>
    </div>
    <% } else { %>

    <div class="empty-cart">
      <div class="empty-cart-icon">🛒</div>
      <h2>Your Cart is Empty</h2>
      <p>Looks like you haven't added any keyboards to your cart yet.</p>
      <a
        href="/shop"
        class="checkout-btn"
        style="max-width: 300px; margin: 0 auto"
        >Start Shopping</a
      >
    </div>
    <% } %>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const decreaseButtons = document.querySelectorAll(".decrease-btn");

    decreaseButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const productId = btn.dataset.product;
        const variantId = btn.dataset.variant;

        const url = `/cart/decrease/${productId}?variantId=${variantId}`;

        const res = await fetch(url, {
          method: "PATCH",
          headers: { "X-Requested-With": "XMLHttpRequest" },
        });

        const data = await res.json();

        if (data.success) {
          if (data.removed) {
            btn.closest(".cart-item").remove();
          } else {
            document.getElementById(
              `qty-${productId}-${variantId}`
            ).textContent = data.quantity;

            const qty1 = document.getElementById(
              `qty-${productId}-${variantId}`
            );
            const qty2 = document.getElementById(
              `qty-text-${productId}-${variantId}`
            );

            if (qty1) {
              qty1.textContent = data.quantity;
            }

            if (qty2) {
              qty2.textContent = data.quantity;
            }
          }

          const discountElement = document.getElementById("discount-amount");
          if (discountElement) {
            discountElement.textContent = data.totalDiscount.toFixed(2);
          }
          document.getElementById("subtotal-items").textContent =
            data.totalItems;

          document.getElementById("subtotal-amount").textContent =
            data.baseTotal.toFixed(2);

          document.getElementById(
            "grand-total"
          ).textContent = `₹${data.totalPrice.toFixed(2)}`;

          if (data.totalItems === 0) {
            location.reload();
          }
        }
      });
    });

    const increaseButtons = document.querySelectorAll(".increase-btn");

    increaseButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const productId = btn.dataset.product;
        const variantId = btn.dataset.variant;

        const res = await fetch(
          `/cart/increase/${productId}?variantId=${variantId}`,
          {
            method: "PATCH",
            headers: { "X-Requested-With": "XMLHttpRequest" },
          }
        );

        const data = await res.json();

        if (!data.success) {
          Swal.fire({
            icon: "warning",
            title: "Quantity limit",
            text: data.message,
            confirmButtonColor: "#401f75"
          });
          return;
        }


        document.getElementById(`qty-${productId}-${variantId}`).textContent =
          data.quantity;
        document.getElementById(
          `qty-text-${productId}-${variantId}`
        ).textContent = data.quantity;

        const discountElement = document.getElementById("discount-amount");
        if (discountElement) {
          discountElement.textContent = data.totalDiscount.toFixed(2);
        }
        document.getElementById("subtotal-items").textContent = data.totalItems;

        document.getElementById("subtotal-amount").textContent =
          data.baseTotal.toFixed(2);

        document.getElementById(
          "grand-total"
        ).textContent = `₹${data.totalPrice.toFixed(2)}`;
      });
    });

    const removeButtons = document.querySelectorAll(".remove-btn");

    removeButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const productId = btn.dataset.product;
        const variantId = btn.dataset.variant;

        const url = `/cart/remove/${productId}?variantId=${variantId}`;

        const response = await fetch(url, {
          method: "DELETE",
          headers: { "X-Requested-With": "XMLHttpRequest" },
        });

        const data = await response.json();

        if (data.success) {
          btn.closest(".cart-item").remove();

          const discountElement = document.getElementById("discount-amount");
          if (discountElement) {
            discountElement.textContent = data.totalDiscount.toFixed(2);
          }

          document.getElementById(
            "subtotal-items"
          ).textContent = `Subtotal (${data.totalItems} items)`;

          document.getElementById(
            "subtotal-amount"
          ).textContent = `₹${data.baseTotal}`;

          if (document.querySelectorAll(".cart-item").length === 0) {
            location.reload();
          }
        } else {
          console.log("Remove error:", data.message);
        }
      });
    });
  });

  const checkoutBtn = document.getElementById("checkoutBtn");
  const checkoutError = document.getElementById("checkoutError");

  checkoutBtn.addEventListener("click", async () => {
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = "Checking stock...";

    const res = await fetch("/cart/validate-stock", {
      method: "POST",
      headers: {
        "X-Requested-With": "XMLHttpRequest",
      },
    });

    const data = await res.json();

    if (!data.success) {
      checkoutBtn.disabled = true;
      checkoutBtn.classList.add("disabled");

      checkoutError.style.display = "block";
      checkoutError.innerHTML = "";

      if (data.stockErrors) {
        data.stockErrors.forEach((err) => {
          checkoutError.innerHTML += `<div>${err.message}</div>`;
        });
      } else {
        checkoutError.innerText = data.message || "Stock issue detected";
      }

      checkoutBtn.textContent = "Cannot Proceed";
      return;
    }

    window.location.href = "/checkout";
  });
</script>

<%- include('../partials/user/footer') %>

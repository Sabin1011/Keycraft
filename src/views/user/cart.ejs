<%- include('../partials/user/header') %>

<style>
    .cart-container {
        padding: 60px 0;
        background: #f8f9fa;
        min-height: 70vh;
    }

    .cart-title {
        text-align: center;
        margin-bottom: 50px;
    }

    .cart-title h1 {
        font-size: 36px;
        font-family: 'Raleway', sans-serif;
        font-weight: 300;
        color: #2c3e50;
        text-transform: capitalize;
    }

    .title-underline {
        width: 50px;
        height: 3px;
        background: #2c3e50;
        margin: 20px auto 0;
    }

    /* Message Alert Styles */
    .alert-message {
        max-width: 600px;
        margin: 0 auto 30px;
        padding: 15px 20px;
        border-radius: 4px;
        font-size: 14px;
        text-align: center;
        animation: slideDown 0.3s ease-out;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .alert-error {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .cart-content {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 30px;
        margin-top: 40px;
    }

    .cart-items {
        background: #fff;
        border: 1px solid #ecf0f1;
        padding: 30px;
    }

    .cart-item {
        display: grid;
        grid-template-columns: 120px 1fr auto;
        gap: 25px;
        padding: 25px 0;
        border-bottom: 1px solid #ecf0f1;
    }

    .cart-item:last-child {
        border-bottom: none;
    }

    .item-image {
        width: 120px;
        height: 120px;
        object-fit: cover;
        background: #f8f9fa;
    }

    .item-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .item-details {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .item-name {
        font-size: 18px;
        font-weight: 500;
        color: #2c3e50;
        margin-bottom: 8px;
        font-family: 'Raleway', sans-serif;
    }

    .item-category {
        font-size: 11px;
        color: #95a5a6;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 12px;
        font-weight: 600;
    }

    .item-price {
        font-size: 16px;
        color: #2c3e50;
        font-weight: 600;
    }

    .item-actions {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-end;
    }

    .quantity-control {
        display: flex;
        align-items: center;
        gap: 15px;
        border: 1px solid #dfe6e9;
        padding: 5px;
    }

    .quantity-control form {
        margin: 0;
        display: inline;
    }

    .quantity-btn {
        background: #fff;
        border: none;
        color: #2c3e50;
        width: 30px;
        height: 30px;
        cursor: pointer;
        font-size: 16px;
        transition: all 0.3s;
        font-weight: 600;
    }

    .quantity-btn:hover {
        background: #2c3e50;
        color: #fff;
    }

    .quantity-display {
        font-size: 14px;
        font-weight: 600;
        color: #2c3e50;
        min-width: 30px;
        text-align: center;
    }

    .remove-btn {
        background: transparent;
        border: 1px solid #e74c3c;
        color: #e74c3c;
        padding: 8px 20px;
        font-size: 11px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s;
        font-family: 'Questrial', sans-serif;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .remove-btn:hover {
        background: #e74c3c;
        color: #fff;
    }

    .cart-summary {
        background: #fff;
        border: 1px solid #ecf0f1;
        padding: 30px;
        height: fit-content;
        position: sticky;
        top: 20px;
    }

    .summary-title {
        font-size: 20px;
        font-family: 'Raleway', sans-serif;
        font-weight: 500;
        color: #2c3e50;
        margin-bottom: 25px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px solid #ecf0f1;
        font-size: 14px;
    }

    .summary-row:last-child {
        border-bottom: none;
        font-size: 18px;
        font-weight: 600;
        color: #2c3e50;
        padding-top: 20px;
        margin-top: 10px;
        border-top: 2px solid #2c3e50;
    }

    .checkout-btn {
        width: 100%;
        padding: 16px;
        background: #2c3e50;
        color: #fff;
        border: none;
        font-size: 13px;
        text-transform: uppercase;
        cursor: pointer;
        margin-top: 25px;
        transition: all 0.3s;
        font-family: 'Questrial', sans-serif;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-decoration: none;
        display: block;
        text-align: center;
    }

    .checkout-btn:hover {
        background: #34495e;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .continue-shopping {
        width: 100%;
        padding: 16px;
        background: transparent;
        color: #2c3e50;
        border: 2px solid #2c3e50;
        font-size: 13px;
        text-transform: uppercase;
        cursor: pointer;
        margin-top: 15px;
        transition: all 0.3s;
        font-family: 'Questrial', sans-serif;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-decoration: none;
        display: block;
        text-align: center;
    }

    .continue-shopping:hover {
        background: #2c3e50;
        color: #fff;
    }

    .empty-cart {
        text-align: center;
        padding: 80px 20px;
        background: #fff;
        border: 1px solid #ecf0f1;
    }

    .empty-cart-icon {
        font-size: 80px;
        color: #ddd;
        margin-bottom: 20px;
    }

    .empty-cart h2 {
        font-size: 28px;
        font-family: 'Raleway', sans-serif;
        font-weight: 300;
        color: #2c3e50;
        margin-bottom: 15px;
    }

    
    .view-product-btn {
        display: inline-block;
        padding: 8px 22px;
        border-radius: 6px;
        border: 1.5px solid #2c3e50;
        color: #ffffff;
        background: linear-gradient(135deg, #7b7a7a, #000000);
        font-size: 14px;
        text-decoration: none;
        transition: all 0.9s ease-in-out;
    }

    .view-product-btn:hover {
    
        background: linear-gradient(135deg, #000000,#7b7a7a);
        color: #ffffff;
        border-color: #2c3e50;
        box-shadow: 0 3px 8px rgba(0,0,0,0.15);
        
    }

    .view-product-btn:active {
        transform: scale(0.97);
    }


    .empty-cart p {
        font-size: 14px;
        color: #95a5a6;
        margin-bottom: 30px;
    }
    .checkout-btn.disabled {
        background: #ccc;    
        pointer-events: none;   
        cursor: not-allowed;    
        color: #666;            
    }


    @media (max-width: 968px) {
        .cart-content {
            grid-template-columns: 1fr;
        }

        .cart-summary {
            position: static;
        }

        .cart-item {
            grid-template-columns: 100px 1fr;
            gap: 15px;
        }

        .item-actions {
            grid-column: 1 / -1;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            margin-top: 15px;
        }
    }
</style>

<section class="cart-container">
    <div class="container">
        <div class="cart-title">
            <h1>Shopping Cart</h1>
            <div class="title-underline"></div>
        </div>

        <!-- Display Messages -->
        <% if (message) { %>
            <div class="alert-message alert-<%= messageType %>">
                <%= message %>
            </div>
        <% } %>

        <% if (cart && cart.items && cart.items.length > 0) { %>
            <div class="cart-content">
                <!-- Cart Items -->
                <div class="cart-items">
                    <% cart.items.forEach(item => { %>
                        <div class="cart-item">
                            <div class="item-image">
                                <% if (item.product.images && item.product.images.length > 0) { %>
                                    <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>">
                                <% } else { %>
                                    <img src="/images/default-product.png" alt="No Image">
                                <% } %>
                            </div>

                            <div class="item-details">
                                <div class="item-category">
                                    <%= item.product.category ? item.product.category.name : 'Uncategorized' %>
                                </div>
                                <div class="item-name"><%= item.product.name %></div>

                                <% if (item.selectedVariant) { %>
                                    <div style="font-size: 14px; color: #2c3e50; margin-bottom: 8px;">
                                        Switch Type: <strong><%= item.selectedVariant.name %></strong>
                                    </div>
                                <% } else { %>
                                    <div style="font-size: 14px; color: #2c3e50; margin-bottom: 8px;">
                                        Switch Type: <strong>Default</strong>
                                    </div>
                                <% } %>

                                <% if (!item.isAvailable) { %>
                                    <div style="color: red; font-size: 13px; font-weight: 600;">
                                        <%= item.outOfStockMessage %>
                                    </div>
                                <% } %>

                                <div class="item-price">₹<%= item.product.price.toFixed(2) %> × <%= item.quantity %></div>
                            </div>

                            <div class="item-actions">
                                <div class="quantity-control">

                                    <form method="POST" action="/cart/decrease/<%= item.product._id %>?variantId=<%= item.variantId %>">
                                        <button type="submit" class="quantity-btn" <%= !item.isAvailable ? "disabled style='opacity:0.5;cursor:not-allowed;'" : "" %>>−</button>
                                    </form>

                                    <span class="quantity-display"><%= item.quantity %></span>

                                    <form method="POST" action="/cart/increase/<%= item.product._id %>?variantId=<%= item.variantId %>">
                                        <button type="submit" class="quantity-btn" <%= !item.isAvailable ? "disabled style='opacity:0.5;cursor:not-allowed;'" : "" %>>+</button>
                                    </form>

                                </div>



                                <form method="POST" action="/cart/remove/<%= item.product._id %>?variantId=<%= item.variantId %>">
                                    <button type="submit" class="remove-btn">Remove</button>
                                </form>
                                
                            </div>
                            <a 
                            href="/singleProduct/<%= item.product._id %>?variant=<%=item.variantId%>" 
                            class="view-product-btn"
                            >
                            View Product
                            </a>


                        </div>
                    <% }) %>
                </div>

                <!-- Cart Summary -->
                <div class="cart-summary">
                    <h3 class="summary-title">Order Summary</h3>
                    
                    <div class="summary-row">
                        <span>Subtotal (<%= cart.items.length %> items)</span>
                        <span>₹<%= cart.totalPrice.toFixed(2) %></span>
                    </div>
                    
                    <div class="summary-row">
                        <span>Shipping</span>
                        <span>Free</span>
                    </div>
                    
                    <div class="summary-row">
                        <span>Total</span>
                        <span>₹<%= cart.totalPrice.toFixed(2) %></span>
                    </div>

                    <% if (invalidItemExists) { %>
                        <div style="color: red; font-size: 14px; margin-bottom: 10px; text-align: center;">
                            Some items in your cart are unavailable or out of stock. Please update your cart to proceed.
                        </div>
                    <% } %>
                    <a 
                        href="<%= invalidItemExists ? '#' : '/checkout' %>" 
                        class="checkout-btn <%= invalidItemExists ? 'disabled' : '' %>"
                    >
                        Proceed to Checkout
                    </a>

                    <a href="/shop" class="continue-shopping">Continue Shopping</a>
                </div>  
            </div>
        <% } else { %>
            <!-- Empty Cart -->
            <div class="empty-cart">
                <div class="empty-cart-icon">🛒</div>
                <h2>Your Cart is Empty</h2>
                <p>Looks like you haven't added any keyboards to your cart yet.</p>
                <a href="/shop" class="checkout-btn" style="max-width: 300px; margin: 0 auto;">Start Shopping</a>
            </div>
        <% } %>
    </div>
</section>

<%- include('../partials/user/footer') %>
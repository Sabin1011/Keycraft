<%- include('../partials/user/header') %>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Questrial', sans-serif;
            background: #fafafa;
            color: #222;
            min-height: 100vh;
        }

        .breadcrumb {
            padding: 15px 0;
            background: #fff;
            border-bottom: 1px solid #e5e5e5;
        }

        .breadcrumb a {
            color: #666;
            text-decoration: none;
            font-size: 13px;
            transition: color 0.3s;
        }

        .breadcrumb a:hover {
            color: #222;
        }

        .breadcrumb span {
            color: #999;
            margin: 0 8px;
        }

        .address-section {
            padding: 40px 0;
            min-height: calc(100vh - 200px);
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 40px;
        }

        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 40px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            color: #fff;
        }

        .page-title {
            font-size: 32px;
            font-weight: 700;
            text-transform: lowercase;
            margin-bottom: 8px;
        }

        .page-subtitle {
            font-size: 16px;
            opacity: 0.9;
        }

        .form-layout {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .form-card {
            background: #fff;
            border-radius: 12px;
            border: 1px solid #e5e5e5;
            padding: 35px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            transition: all 0.3s;
            height: fit-content;
        }

        .form-card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            transform: translateY(-2px);
        }

        .form-card.full-width {
            grid-column: 1 / -1;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f5f5f5;
        }

        .card-title {
            font-size: 20px;
            font-weight: 700;
            text-transform: lowercase;
            color: #222;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-title i {
            color: #667eea;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            display: block;
            font-size: 11px;
            color: #999;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .form-label.required::after {
            content: '*';
            color: #e74c3c;
            margin-left: 4px;
        }

        .form-input,
        .form-select,
        .form-textarea {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e5e5e5;
            border-radius: 8px;
            font-size: 14px;
            font-family: 'Questrial', sans-serif;
            transition: all 0.3s;
            background: #fff;
            color: #222;
        }

        .form-input:focus,
        .form-select:focus,
        .form-textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .form-textarea {
            resize: vertical;
            min-height: 120px;
        }

        .form-select {
            cursor: pointer;
            appearance: none;
            background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%23666' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
            background-repeat: no-repeat;
            background-position: right 16px center;
            padding-right: 40px;
        }

        .checkbox-group {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
        }

        .checkbox-group:hover {
            background: #fff;
            border-color: #667eea;
        }

        .checkbox-group input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: #667eea;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .checkbox-content {
            flex: 1;
        }

        .checkbox-label {
            font-size: 16px;
            color: #222;
            cursor: pointer;
            user-select: none;
            font-weight: 600;
            text-transform: lowercase;
            margin-bottom: 4px;
        }

        .checkbox-description {
            font-size: 13px;
            color: #666;
            line-height: 1.6;
        }

        .helper-text {
            font-size: 12px;
            color: #999;
            margin-top: 6px;
        }

        .address-preview {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 25px;
            margin-top: 20px;
            border: 2px solid #e5e5e5;
        }

        .preview-title {
            font-size: 11px;
            color: #999;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
        }

        .preview-content {
            font-size: 14px;
            color: #666;
            line-height: 1.8;
        }

        .preview-empty {
            color: #999;
            font-style: italic;
        }

        .info-box {
            background: #fff9e6;
            border: 2px solid #ffe066;
            border-radius: 10px;
            padding: 20px;
            display: flex;
            gap: 15px;
            align-items: flex-start;
        }

        .info-box i {
            color: #f39c12;
            font-size: 20px;
            flex-shrink: 0;
        }

        .info-box-content h4 {
            font-size: 14px;
            font-weight: 600;
            text-transform: lowercase;
            margin-bottom: 5px;
            color: #222;
        }

        .info-box-content p {
            font-size: 13px;
            color: #666;
            line-height: 1.6;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            margin-top: 0;
        }

        .btn {
            padding: 14px 32px;
            border: none;
            font-size: 14px;
            text-transform: lowercase;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.3s;
            font-family: 'Questrial', sans-serif;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
            flex: 1;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        }

        .btn-secondary {
            background: #f8f9fa;
            color: #666;
            border: 2px solid #e5e5e5;
        }

        .btn-secondary:hover {
            background: #222;
            color: #fff;
            border-color: #222;
        }

        @media (max-width: 1200px) {
            .form-layout {
                grid-template-columns: 1fr;
            }
            
            .container {
                padding: 0 25px;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 15px;
            }

            .page-header {
                padding: 30px 20px;
            }

            .page-title {
                font-size: 24px;
            }

            .form-card {
                padding: 25px 20px;
            }

            .form-actions {
                flex-direction: column;
            }
        }
    </style>

    <section class="breadcrumb">
        <div class="container">
            <a href="/home">home</a>
            <span>/</span>
            <a href="/profile">my profile</a>
            <span>/</span>
            <span style="color: #222;">add address</span>
        </div>
    </section>

    <section class="address-section">
        <div class="container">
            <!-- Page Header -->
            <div class="page-header">
                <div class="page-title">add new address</div>
                <div class="page-subtitle">save a new delivery address to your profile</div>
            </div>

            <!-- Form Layout -->
            <form action="/profile/address/add" method="POST">
                <div class="form-layout">
                    <!-- Left Column: Address Type & Basic Info -->
                    <div class="form-card">
                        <div class="card-header">
                            <h2 class="card-title">
                                <i class="fa fa-tag"></i> address type
                            </h2>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label required">select type</label>
                            <select name="type" class="form-select" required>
                                <option value="">choose address type</option>
                                <option value="home">home</option>
                                <option value="work">work</option>
                                <option value="other">other</option>
                            </select>
                            <div class="helper-text">categorize this address for easy reference</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">label (optional)</label>
                            <input 
                                type="text" 
                                name="label" 
                                class="form-input" 
                                placeholder="e.g., mom's house, office, vacation home">
                            <div class="helper-text">give this address a memorable name</div>
                        </div>

                        <div class="info-box">
                            <i class="fa fa-info-circle"></i>
                            <div class="info-box-content">
                                <h4>quick tip</h4>
                                <p>you can save multiple addresses and choose which one to use during checkout</p>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Location Details -->
                    <div class="form-card">
                        <div class="card-header">
                            <h2 class="card-title">
                                <i class="fa fa-map-marker"></i> location details
                            </h2>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label required">country</label>
                            <select name="country" class="form-select" required>
                                <option value="">select country</option>
                                <option value="United States">United States</option>
                                <option value="Canada">Canada</option>
                                <option value="United Kingdom">United Kingdom</option>
                                <option value="Australia">Australia</option>
                                <option value="India">India</option>
                                <option value="Germany">Germany</option>
                                <option value="France">France</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label required">state / province</label>
                            <input 
                                type="text" 
                                name="state" 
                                class="form-input" 
                                placeholder="e.g., california, ontario, bavaria"
                                required>
                        </div>

                        <div class="form-group">
                            <label class="form-label required">city</label>
                            <input 
                                type="text" 
                                name="city" 
                                class="form-input" 
                                placeholder="e.g., san francisco, toronto, munich"
                                required>
                        </div>

                        <div class="form-group">
                            <label class="form-label required">zip / postal code</label>
                            <input 
                                type="text" 
                                name="zipCode" 
                                class="form-input" 
                                placeholder="e.g., 94102, m5h 2n2, 80331"
                                required>
                        </div>
                    </div>

                    <!-- Full Width: Street Address -->
                    <div class="form-card full-width">
                        <div class="card-header">
                            <h2 class="card-title">
                                <i class="fa fa-home"></i> street address
                            </h2>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label required">full street address</label>
                            <textarea 
                                name="street" 
                                class="form-textarea" 
                                placeholder="123 main street, apartment 4b&#10;building name, floor number&#10;any additional delivery instructions"
                                required></textarea>
                            <div class="helper-text">include apartment, suite, unit, building, floor, or any special delivery instructions</div>
                        </div>

                        <div class="address-preview">
                            <div class="preview-title">address preview</div>
                            <div class="preview-content preview-empty">
                                your address will appear here as you type
                            </div>
                        </div>
                    </div>

                    <!-- Full Width: Preferences & Actions
                    <div class="form-card full-width">
                        <div class="card-header">
                            <h2 class="card-title">
                                <i class="fa fa-star"></i> preferences
                            </h2>
                        </div>
                        
                        <div class="form-group">
                            <label class="checkbox-group">
                                <input type="checkbox" name="isDefault" value="true">
                                <div class="checkbox-content">
                                    <div class="checkbox-label">set as default address</div>
                                    <div class="checkbox-description">make this your primary delivery location. it will be automatically selected during checkout.</div>
                                </div>
                            </label>
                        </div>

                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="checkbox-group">
                                <input type="checkbox" name="isBilling" value="true">
                                <div class="checkbox-content">
                                    <div class="checkbox-label">use as billing address</div>
                                    <div class="checkbox-description">also save this address for billing purposes and payment processing.</div>
                                </div>
                            </label>
                        </div>
                    </div> -->

                    <!-- Full Width: Form Actions -->
                    <div class="form-card full-width">
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-check"></i> save address
                            </button>
                            <a href="/profile" class="btn btn-secondary">
                                <i class="fa fa-times"></i> cancel
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <script>
        // Live address preview
        const streetInput = document.querySelector('[name="street"]');
        const cityInput = document.querySelector('[name="city"]');
        const stateInput = document.querySelector('[name="state"]');
        const zipInput = document.querySelector('[name="zipCode"]');
        const countryInput = document.querySelector('[name="country"]');
        const previewContent = document.querySelector('.preview-content');

        function updatePreview() {
            const street = streetInput.value.trim();
            const city = cityInput.value.trim();
            const state = stateInput.value.trim();
            const zip = zipInput.value.trim();
            const country = countryInput.value;

            if (!street && !city && !state && !zip && !country) {
                previewContent.innerHTML = '<span class="preview-empty">your address will appear here as you type</span>';
                return;
            }

            let preview = '';
            if (street) preview += street.replace(/\n/g, '<br>') + '<br>';
            if (city || state || zip) {
                const cityStateZip = [city, state, zip].filter(Boolean).join(', ');
                if (cityStateZip) preview += cityStateZip + '<br>';
            }
            if (country) preview += country;

            previewContent.innerHTML = preview || '<span class="preview-empty">your address will appear here as you type</span>';
        }

        [streetInput, cityInput, stateInput, zipInput, countryInput].forEach(input => {
            input.addEventListener('input', updatePreview);
        });
    </script>

<%- include('../partials/user/footer') %>
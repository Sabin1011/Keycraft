<%- include('../partials/user/header') %>

<link rel="stylesheet" href="/css/addressForm.css" />

<section class="breadcrumb">
  <div class="container">
    <a href="/">home</a>
    <span>/</span>
    <% if (returnUrl === '/checkout') { %>
    <a href="/checkout">checkout</a>
    <% } else { %>
    <a href="/profile">my profile</a>
    <% } %>
    <span>/</span>
    <span style="color: #222">add address</span>
  </div>
</section>

<section class="address-section">
  <div class="container">
    <% if (success) { %>
    <div
      style="
        padding: 15px 20px;
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        border-radius: 10px;
        margin-bottom: 25px;
      "
    >
      <i class="fa fa-check-circle"></i> <%= success %>
    </div>
    <% } %> <% if (error) { %>
    <div
      style="
        padding: 15px 20px;
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        border-radius: 10px;
        margin-bottom: 25px;
      "
    >
      <i class="fa fa-exclamation-circle"></i> <%= error %>
    </div>
    <% } %>

    <div class="page-header">
      <div class="page-title">add new address</div>
      <div class="page-subtitle">
        save a new delivery address to your profile
      </div>
    </div>

    <form id="addressForm" action="/profile/address/add" method="POST">
      <input type="hidden" name="returnUrl" value="<%= returnUrl %>" />
      <%- include('../partials/addressForm', { address: null, mode: 'add',
      returnUrl }) %>
    </form>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("addressForm");

    const fields = ["type", "street", "city", "state", "zipCode", "country"];

    function clearErrors() {
      document.querySelectorAll(".error-message").forEach((el) => el.remove());
      document
        .querySelectorAll(".form-group input")
        .forEach((el) => el.classList.remove("is-invalid"));
    }

    function displayErrors(errors) {
      clearErrors();
      for (const key in errors) {
        const input = form.querySelector(`[name="${key}"]`);
        if (input) {
          input.classList.add("is-invalid");
          const errorDiv = document.createElement("div");
          errorDiv.className = "error-message";
          errorDiv.style.color = "#dc3545";
          errorDiv.style.fontSize = "0.85em";
          errorDiv.style.marginTop = "5px";
          errorDiv.textContent = errors[key];

          input.parentNode.appendChild(errorDiv);
        }
      }
    }

    if (form) {
      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        const submitButton = form.querySelector('button[type="submit"]');
        const originalButtonText = submitButton
          ? submitButton.textContent
          : "Submit";

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        clearErrors(); 

        try {

          if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = "Saving...";
          }

          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(data),
          });

          const responseData = await response.json();

          if (response.ok && responseData.success) {

            Swal.fire({
              icon: "success",
              title: "Success!",
              text: responseData.message,
              timer: 2000,
              showConfirmButton: false,
            }).then(() => {
              window.location.href = responseData.redirectUrl;
            });
          } else if (response.status === 400 && responseData.errors) {
      
            displayErrors(responseData.errors);

            Swal.fire({
              icon: "warning",
              title: "Validation Failed",
              text: "Please correct the highlighted errors in the form.",
              confirmButtonColor: "#222",
            });
          } else {
            Swal.fire({
              icon: "error",
              title: "Error!",
              text: responseData.message || "An unexpected error occurred.",
              confirmButtonColor: "#dc3545",
            });
          }
        } catch (error) {
          console.error("AJAX Submission Error:", error);
          Swal.fire({
            icon: "error",
            title: "Network Error",
            text: "Could not connect to the server. Please check your internet connection.",
            confirmButtonColor: "#dc3545",
          });
        } finally {
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = originalButtonText;
          }
        }
      });
    }
  });
</script>
<%- include('../partials/user/footer') %>

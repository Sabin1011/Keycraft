<%- include('../partials/user/header') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="/css/myOrders.css">
<section class="orders-section">
  
  <div class="orders-container">
    <div style="margin-bottom: 20px; display: flex; gap: 10px;">
  <form action="/my-orders" method="GET" style="display: flex; gap: 10px; width: 100%;">
    <input 
      type="text" 
      name="search" 
      placeholder="Search by Order ID..." 
      value="<%= typeof search !== 'undefined' ? search : '' %>"
      style="
        flex: 1;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
      "
    />

    <button 
      type="submit" 
      class="btn" 
      style="
        background: #401f75; 
        padding: 10px 18px;
        border-radius: 6px;
        color: #fff;
        font-weight: 500;
      "
    >
      Search
    </button>

    <% if (typeof search !== "undefined" && search.trim() !== "") { %>
      <a 
        href="/my-orders" 
        class="btn"
        style="
          background: #e74c3c; 
          padding: 10px 18px;
          border-radius: 6px;
          color: #fff;
          font-weight: 500;
          text-decoration: none;
        "
      >
        Clear
      </a>
    <% } %>
  </form>
</div>

    <h2 style="margin-bottom: 20px; color: #401f75">My Orders</h2>

    <% if (orders.length === 0) { %>
    <p>You haven't placed any orders yet.</p>
    <% } %> 
    <% orders.forEach(order => { %>
    <div class="orders-card">
      <div class="order-info">
        <div class="order-id">Order ID: <%= order.orderId %></div>
        <div class="order-date">
          Placed on: <%= new Date(order.createdAt).toDateString() %>
        </div>
        <div class="order-status">Status: <%= order.status %></div>
        <div class="order-total">
        <%
          const paidAmount = order.finalAmount ??
          (order.totalAmount - (order.discountAmount || 0));
        %>

        Total Paid: ₹<%= paidAmount.toFixed(2) %>
          <% if (order.discountAmount > 0) { %>
            <span style="color:green; font-size:12px;">
              (Saved ₹<%= order.discountAmount %>)
            </span>
          <% } %>
          <% if(order.couponId) { %>
            <p style="font-size: 14px; color: #666;">
              Coupon Used: <strong><%= order.couponId.code %></strong>
            </p>
          <% } %>
        </div>
      </div>

      <div class="button-group">
        <a href="/order/<%= order.orderId %>" class="btn btn-details"
          >View Details</a
        >

        <% const disabledForStatuses = ['cancelled', "returned", "delivered"] %>

        <% if(!disabledForStatuses.includes(order.status.toLowerCase())) { %>
        <form
          id="cancelForm_<%= order.orderId %>"
          action="/order/<%= order.orderId %>/cancel"
          method="post"
          style="display: inline"
          onsubmit="return handleCancel(event, '<%= order.orderId %>')"
        >
        <input type="hidden" id="reason_<%= order.orderId %>" name="reason" />
          <button type="submit" class="btn btn-cancel">Cancel</button>
        </form>
          
        <% } %> 
        <% if(order.status === 'Delivered') { %>
        <form 
          id="returnForm_<%= order.orderId %>"
          action="/order/<%= order.orderId %>/return"
          method="POST"
          onsubmit="return handleReturn(event, '<%= order.orderId %>')"
        >
            <input type="hidden" name="reason" id="returnReason_<%= order.orderId %>">
            <input type="hidden" name="redirectTo" value="/my-orders">
            <button class="btn btn-return">Return</button>
        </form>

        <% } %>

        <a href="/order/<%= order.orderId %>/invoice" class="btn btn-invoice"
          >Invoice</a
        >
      </div>
    </div>
    <% }) %>
  </div>
</section>

<script>

function handleReturn(event, orderId) {
    event.preventDefault();

    Swal.fire({
        title: "Return Order?",
        text: "Please enter a reason for return",
        input: "text",
        inputPlaceholder: "Reason is required",
        showCancelButton: true,
        confirmButtonText: "Submit",
        cancelButtonText: "Cancel",
        inputValidator: (value) => !value && "Reason required!"
    }).then(result => {
        if (result.isConfirmed) {
            document.getElementById("returnReason_" + orderId).value = result.value;
            document.getElementById("returnForm_" + orderId).submit();
        }
    });
}

  function handleCancel(event, orderId) {
    event.preventDefault(); 

    Swal.fire({
      title: "Cancel Order?",
      text: "Please enter a reason for cancellation",
      input: "text",
      inputPlaceholder: "Reason is required",
      showCancelButton: true,
      confirmButtonText: "Confirm Cancel",
      cancelButtonText: "Close",
      inputValidator: (value) => {
        if (!value) {
          return "Reason is required!";
        }
      },
    }).then((result) => {
      if (result.isConfirmed) {

        document.getElementById("reason_" + orderId).value = result.value;

        document.getElementById("cancelForm_" + orderId).submit();
      }
    });

    return false; 
  }
</script>

<%- include('../partials/user/footer') %>

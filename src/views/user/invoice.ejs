<%- include('../partials/user/header') %>

<style>
  body {
    font-family: "Questrial", sans-serif;
    background: #fff;
    color: #000;
  }

  .invoice-wrapper {
    max-width: 900px;
    margin: 40px auto;
    padding: 40px;
    border: 1px solid #ddd;
    border-radius: 12px;
    background: #fff;
  }

  .invoice-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .invoice-header img {
    height: 60px;
  }

  h2, h3 {
    margin-bottom: 10px;
    font-weight: 600;
  }

  .section {
    margin-top: 25px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .items-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }

  .items-table th,
  .items-table td {
    border: 1px solid #dcdcdc;
    padding: 12px;
    text-align: left;
  }

  .items-table th {
    background: #f5f5f5;
    font-weight: 600;
  }

  .total-box {
    margin-top: 20px;
    float: right;
    width: 45%;
    border: 1px solid #ddd;
    padding: 15px;
    border-radius: 10px;
  }

  .total-box .row strong {
    font-size: 16px;
  }

  .footer-note {
    margin-top: 50px;
    font-size: 14px;
    color: #666;
    text-align: center;
  }

  .btn {
    padding: 10px 18px;
    background: #27ae60;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    margin-top: 25px;
    text-decoration: none;
    display: inline-block;
  }
  @media print {

  /* Hide everything except invoice-wrapper */
  body * {
    visibility: hidden !important;
  }

  .invoice-wrapper, 
  .invoice-wrapper * {
    visibility: visible !important;
  }

  /* Perfect centered A4 layout */
  @page {
    size: A4;
    margin: 20mm; /* Clean margin on all sides */
  }

  .invoice-wrapper {
    position: absolute;
    left: 0;
    top: 0;

    width: 100% !important;
    background: white !important;

    padding: 25px !important;    /* Inner spacing */
    border: 1px solid #ccc !important;
    border-radius: 6px !important;

    box-shadow: none !important; /* Remove screen shadow for print */
  }

  header, footer, .site-header, .site-footer {
    display: none !important;
    visibility: hidden !important;
  }

  /* Fix table formatting */
  .items-table th,
  .items-table td {
    border: 1px solid #555 !important;
    padding: 10px !important;
  }

  .items-table {
    border: 1px solid #555 !important;
  }

  .total-box {
    border: 1px solid #555 !important;
    padding: 15px !important;
  }

  .btn, a.btn {
    display: none !important;
  }
}
</style>


<div class="invoice-wrapper">

  <!-- HEADER -->
  <div class="invoice-header">
    <div>
      <h2>INVOICE</h2>
      <p><strong>Order ID:</strong> <%= order.orderId %></p>
      <p><strong>Date:</strong> <%= new Date(order.createdAt).toDateString() %></p>
    </div>

    <!-- If you have a shop logo -->
    <div>
      <img src="/images/logo.png" alt="Store Logo">
    </div>
  </div>

  <!-- BILLING + SHIPPING -->
  <div class="section">
    <h3>Customer Details</h3>
    <div class="row"><strong>Name:</strong> <span><%= order.userId.username %></span></div>
    <div class="row"><strong>Email:</strong> <span><%= order.userId.email %></span></div>
  </div>

  <div class="section">
    <h3>Shipping Address</h3>
    <p>
      <%= order.address.street %>,  
      <%= order.address.city %>, 
      <%= order.address.state %> - <%= order.address.zipCode %><br>
      <%= order.address.country %>
    </p>
  </div>

  <div class="section">
    <h3>Payment Info</h3>
    <div class="row"><strong>Payment Method:</strong> <%= order.paymentMethod.toUpperCase() %></div>
    <div class="row"><strong>Status:</strong> <%= order.status %></div>
  </div>


  <!-- ITEM TABLE -->
  <div class="section">
    <h3>Order Items</h3>

    <table class="items-table">
      <thead>
        <tr>
          <th>Item</th>
          <th>Unit Price</th>
          <th>Qty</th>
          <th>Total</th>
        </tr>
      </thead>

      <tbody>
        <% order.items.forEach(item => { %>
          <tr>
            <td>
              <strong><%= item.product.name %></strong><br>
              <% if(item.product.specifications) { %>
                <span style="font-size: 13px; color: #444;"><%= item.product.specifications %></span>
              <% } %>
            </td>

            <td>₹<%= item.price.toFixed(2) %></td>
            <td><%= item.quantity %></td>
            <td>₹<%= (item.quantity * item.price).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>


  <!-- TOTAL SUMMARY -->
  <div class="total-box">
    <div class="row"><span>Subtotal:</span> <strong>₹<%= order.subtotal %></strong></div>
    <div class="row"><span>Shipping:</span> <strong>₹<%= order.shippingFee %></strong></div>
    <div class="row"><span>Tax:</span> <strong>₹<%= order.tax %></strong></div>

    <% if(order.discount) { %>
      <div class="row"><span>Discount:</span> <strong>-₹<%= order.discount %></strong></div>
    <% } %>

    <hr>

    <div class="row" style="margin-top: 10px;">
      <strong>Total Paid:</strong> 
      <strong style="font-size: 18px;">₹<%= order.totalAmount %></strong>
    </div>
  </div>
  
  <div style="clear: both;"></div>

  <p class="footer-note">
    Thank you for shopping with KeyCraft!  
    <br>
    This is a computer-generated invoice. No signature required.
  </p>

  <a href="javascript:window.print()" class="btn">Print Invoice</a>

</div>

<%- include('../partials/user/footer') %>

<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/css/user/invoice.css">


<div class="invoice-wrapper">

  <div class="invoice-header">
    <div>
      <h2>INVOICE</h2>
      <p><strong>Order ID:</strong> <%= order.orderId %></p>
      <p><strong>Date:</strong> <%= new Date(order.createdAt).toDateString() %></p>
    </div>

    <div>
      <img src="/assets/keycraft-logo.png" alt="Store Logo">
    </div>
  </div>

  <div class="section">
    <h3>Customer Details</h3>
    <div class="row"><strong>Name:</strong> <span><%= order.userId.username %></span></div>
    <div class="row"><strong>Email:</strong> <span><%= order.userId.email %></span></div>
  </div>

  <div class="section">
    <h3>Shipping Address</h3>
    <p>
      <%= order.address.street %>,  
      <%= order.address.city %>, 
      <%= order.address.state %> - <%= order.address.zipCode %><br>
      <%= order.address.country %>
    </p>
  </div>

  <div class="section">
    <h3>Payment Info</h3>
    <div class="row"><strong>Payment Method:</strong> <%= order.paymentMethod.toUpperCase() %></div>
    <div class="row"><strong>Status:</strong> <%= order.status %></div>
  </div>

  <div class="section">
    <h3>Order Items</h3>

    <table class="items-table">
      <thead>
        <tr>
          <th>Item</th>
          <th>Unit Price</th>
          <th>Qty</th>
          <th>Total</th>
        </tr>
      </thead>

      <tbody>
        <% order.items.forEach(item => { %>
          <tr>
            <td>
              <strong><%= item.product.name %></strong><br>
              <% if(item.product.specifications) { %>
                <span style="font-size: 13px; color: #444;"><%= item.product.specifications %></span>
              <% } %>
            </td>

            <td>₹<%= item.price.toFixed(2) %></td>
            <td><%= item.quantity %></td>
            <td>₹<%= (item.quantity * item.price).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="total-box">

  <div class="row">
    <span>Subtotal:</span>
    <strong>₹<%= order.totalAmount.toFixed(2) %></strong>
  </div>

  <div class="row">
    <span>Shipping:</span>
    <strong>₹0.00</strong>
  </div>

  <% if (order.discountAmount && order.discountAmount > 0) { %>
    <div class="row">
      <span>Discount:</span>
      <strong style="color: green;">-₹<%= order.discountAmount.toFixed(2) %></strong>
    </div>
  <% } %>

  <hr>

  <div class="row" style="margin-top: 10px;">
    <strong>Total Paid:</strong>
    <strong style="font-size: 18px;">
        ₹<%= order.finalAmount 
              ? order.finalAmount.toFixed(2)
              : (order.totalAmount - order.discountAmount).toFixed(2) %>
    </strong>
  </div>

</div>

  
  <div style="clear: both;"></div>

  <p class="footer-note">
    Thank you for shopping with KeyCraft!  
    <br>
    This is a computer-generated invoice. No signature required.
  </p>

  <a href="javascript:window.print()" class="btn">Print Invoice</a>

</div>

<%- include('../partials/user/footer') %>

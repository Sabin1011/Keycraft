<%- include('../partials/user/header') %>

<link rel="stylesheet" href="/css/orderDetails.css" />

<div class="page-wrapper">
  <h2>Order Details</h2>

  <div class="section-box">
    <div class="info-row"><strong>Order ID:</strong> <%= order.orderId %></div>
    <div class="info-row">
      <strong>Placed On:</strong> <%= new Date(order.createdAt).toDateString()
      %>
    </div>
    <div class="info-row"><strong>Status:</strong> <%= order.status %></div>
    <div class="info-row">
      <strong>Payment Method:</strong> <%= order.paymentMethod.toUpperCase() %>
    </div>
  </div>

  <h3>Items in Your Order</h3>
  <div class="section-box">
    <% order.items.forEach(item => { %>

    <div class="item-row">
      <img src="<%= item.product.images[0] %>" />

      <div class="item-info">
        <h4><%= item.product.name %></h4>
        <p>Qty: <%= item.quantity %></p>
        <p>Price: ₹<%= item.price.toFixed(2) %></p>
        <% if (item.product.specifications) { %>
        <p style="font-size: 14px; color: #444">
          <%= item.product.specifications %>
        </p>
        <% } %>
      </div>

      <%
        const canCancelItem =
          item.status === "Active" &&
          !["Delivered", "Partially Returned", "Returned"].includes(order.status);
      %>

      <% if (canCancelItem) { %>
        <form
          id="cancelForm_<%= item._id %>"
          action="/order/<%= order.orderId %>/cancel-item/<%= item._id %>"
          method="POST"
          onsubmit="return handleCancel(event, '<%= order.orderId %>', '<%= item._id %>')"
        >
          <input type="hidden" name="redirectTo" value="<%= currentUrl %>" />
          <input type="hidden" id="reason_<%= order.orderId %>" name="reason" />
          <button class="btn btn-cancel">Cancel Item</button>
        </form>
      <% } %>



      <% 
        const canReturnItem =
          (order.status === "Delivered" || order.status === "Partially Returned") &&
          item.status === "Active";
      %>

      <% if (canReturnItem) { %>
        <form
          action="/order/<%= order.orderId %>/return-item/<%= item._id %>"
          method="POST"
        >
          <input type="hidden" name="redirectTo" value="<%= currentUrl %>" />
          <button class="btn btn-return">Return Item</button>
        </form>
      <% } %>


      <% if (item.status === "Return Requested") { %>
        <span style="color:#856404;font-weight:600;">Return Requested</span>
      <% } else if (item.status === "Returned") { %>
        <span style="color:#2e7d32;font-weight:600;">Returned</span>
      <% } %> 
    </div>

    <% }) %>
  </div>

  <h3>Payment Summary</h3>

  <div class="section-box">
    <div class="info-row">
      <span>Subtotal:</span>
      <span>₹<%= order.subtotal.toFixed(2) %></span>
    </div>

    <div class="info-row">
      <span>Shipping Fee:</span>
      <span>₹0</span>
    </div>

    <% if (order.discountAmount > 0) { %>
    <div class="info-row">
      <span>Discount:</span>
      <span style="color: green">-₹<%= order.discountAmount.toFixed(2) %></span>
    </div>
    <% } %>

    <div class="divider"></div>

    <div class="info-row" style="font-size: 18px; font-weight: 700">
      <span>Total Paid:</span>
      <span>₹<%= order.finalAmount.toFixed(2) %></span>
    </div>
  </div>

  <h3>Shipping Address</h3>
  <div class="section-box">
    <p>
      <%= order.address.street %>, <%= order.address.city %>, <%=
      order.address.state %> - <%= order.address.zipCode %><br />
      <%= order.address.country %>
    </p>
  </div>

  <h3>Billing Address</h3>
  <div class="section-box">
    <p>Same as shipping (or put billing field here if different)</p>
  </div>

  <h3>Tracking Information</h3>
  <div class="section-box">
    <% if(order.trackingNumber) { %>
    <p><strong>Carrier:</strong> <%= order.carrier %></p>
    <p><strong>Tracking Number:</strong> <%= order.trackingNumber %></p>
    <a href="<%= order.trackingUrl %>" target="_blank" class="btn btn-success">
      Track Package
    </a>
    <p><strong>Estimated Delivery:</strong> <%= order.estimatedDelivery %></p>
    <% } else { %>
    <p>No tracking available yet.</p>
    <% } %>
  </div>

  <a href="/my-orders" class="btn btn-secondary">Back to My Orders</a>
  <a href="/order/<%= order.orderId %>/invoice" class="btn btn-success"
    >View Invoice</a
  >
</div>

<script>
  function handleReturn(event, orderId) {
    event.preventDefault();

    Swal.fire({
      title: "Return Order?",
      text: "Please enter a reason for return",
      input: "text",
      inputPlaceholder: "Reason is required",
      showCancelButton: true,
      confirmButtonText: "Submit",
      cancelButtonText: "Cancel",
      inputValidator: (value) => !value && "Reason required!",
    }).then((result) => {
      if (result.isConfirmed) {
        document.getElementById("returnReason_" + orderId).value = result.value;
        document.getElementById("returnForm_" + orderId).submit();
      }
    });
  }

  async function handleCancel(event, orderId, itemId) {
    event.preventDefault();

    const reasonPopup = await Swal.fire({
      title: "Cancel Item?",
      text: "Please provide a reason",
      input: "text",
      inputPlaceholder: "Reason is required",
      showCancelButton: true,
      confirmButtonText: "Next",
      cancelButtonText: "Close",
      inputValidator: (value) => !value && "Reason is required!",
    });

    if (!reasonPopup.isConfirmed) return;

    document.getElementById("reason_" + orderId).value = reasonPopup.value;

    const preview = await fetch(`/order/${orderId}/cancel-preview/${itemId}`);
    const data = await preview.json();

    if (!data.couponWillBreak) {
      document.getElementById("cancelForm_" + itemId).submit();
      return false;
    }

    const confirmLoss = await Swal.fire({
      title: "Coupon Will Be Removed!",
      html: `
      Cancelling this item reduces the total below minimum purchase.<br><br>
      <strong>New Total: ₹${data.newTotal}</strong>
      <p style="color:red; margin-top:10px;">Coupon will no longer apply.</p>
    `,
      icon: "warning",
      showCancelButton: true,
      confirmButtonText: "Proceed",
      cancelButtonText: "Keep Item",
    });

    if (confirmLoss.isConfirmed) {
      document.getElementById("cancelForm_" + itemId).submit();
    }

    return false;
  }
</script>

<%- include('../partials/user/footer') %>

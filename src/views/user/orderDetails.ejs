<%- include('../partials/user/header') %>

<link rel="stylesheet" href="/css/user/orderDetails.css" />

<div class="page-wrapper">
  <h2>Order Details</h2>

  <div class="section-box">
    <div class="info-row"><strong>Order ID:</strong> <%= order.orderId %></div>
    <div class="info-row">
      <strong>Placed On:</strong> <%= new Date(order.createdAt).toDateString()
      %>
    </div>
    <div class="info-row"><strong>Status:</strong> <%= order.status %></div>
    <div class="info-row">
      <strong>Payment Method:</strong> <%= order.paymentMethod.toUpperCase() %>
    </div>
  </div>

  <h3>Items in Your Order</h3>
  <div class="section-box">
    <% order.items.forEach(item => { %>

    <div class="item-row">
      <img src="<%= item.product.images[0] %>" />

      <div class="item-info">
        <h4><%= item.product.name %></h4>
        <p>Qty: <%= item.quantity %></p>
        <p>Price: ₹<%= item.price.toFixed(2) %></p>
        <% if (item.product.specifications) { %>
        <p style="font-size: 14px; color: #444">
          <%= item.product.specifications %>
        </p>
        <% } %>
      </div>

      <% const canCancelItem = item.status === "Active" && !["Delivered",
      "Partially Returned", "Returned"].includes(order.status); %> <% if
      (canCancelItem) { %>

      <input type="hidden" name="redirectTo" value="<%= currentUrl %>" />
      <input type="hidden" id="reason_<%= order.orderId %>" name="reason" />
      <button
        class="btn btn-cancel"
        style="height: 40px"
        onclick="cancelItem('<%= order.orderId %>', '<%= item._id %>')"
      >
        Cancel Item
      </button>

      <% } %> <% const canReturnItem = (order.status === "Delivered" ||
      order.status === "Partially Returned") && item.status === "Active"; %> <%
      if (canReturnItem) { %>

      <input type="hidden" name="redirectTo" value="<%= currentUrl %>" />
      <button
        class="btn btn-return"
        onclick="returnItem('<%=order.orderId %>','<%= item._id %>')"
        style="height: 40px"
      >
        Return Item
      </button>

      <% } %> <% if (item.status === "Return Requested") { %>
      <span style="color: #856404; font-weight: 600">Return Requested</span>
      <% } else if (item.status === "Returned") { %>
      <span style="color: #2e7d32; font-weight: 600">Returned</span>
      <% } %>
    </div>

    <% }) %>
  </div>

  <h3>Payment Summary</h3>

  <div class="section-box">
    <div class="info-row">
      <span>Subtotal:</span>
      <span>₹<%= order.subtotal.toFixed(2) %></span>
    </div>

    <div class="info-row">
      <span>Shipping Fee:</span>
      <span>₹0</span>
    </div>

    <% if (order.discountAmount > 0) { %>
    <div class="info-row">
      <span>Discount:</span>
      <span style="color: green">-₹<%= order.discountAmount.toFixed(2) %></span>
    </div>
    <% } %>

    <div class="divider"></div>

    <div class="info-row" style="font-size: 18px; font-weight: 700">
      <span>Total Paid:</span>
      <span>₹<%= order.finalAmount.toFixed(2) %></span>
    </div>
  </div>

  <h3>Shipping Address</h3>
  <div class="section-box">
    <p>
      <%= order.address.street %>, <%= order.address.city %>, <%=
      order.address.state %> - <%= order.address.zipCode %><br />
      <%= order.address.country %>
    </p>
  </div>

  <h3>Billing Address</h3>
  <div class="section-box">
    <p>Same as shipping (or put billing field here if different)</p>
  </div>

  <h3>Tracking Information</h3>
  <div class="section-box">
    <% if(order.trackingNumber) { %>
    <p><strong>Carrier:</strong> <%= order.carrier %></p>
    <p><strong>Tracking Number:</strong> <%= order.trackingNumber %></p>
    <a href="<%= order.trackingUrl %>" target="_blank" class="btn btn-success">
      Track Package
    </a>
    <p><strong>Estimated Delivery:</strong> <%= order.estimatedDelivery %></p>
    <% } else { %>
    <p>No tracking available yet.</p>
    <% } %>
  </div>

  <a href="/my-orders" class="btn btn-secondary">Back to My Orders</a>
  <a href="/order/<%= order.orderId %>/invoice" class="btn btn-success"
    >View Invoice</a
  >
</div>

<script>
  function returnItem(orderId, itemId) {
    Swal.fire({
      title: "Return Item?",
      text: "Are you sure you want to return this item?",
      icon: "warning",
      showCancelButton: true,
      confirmButtonText: "Yes, return",
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(`/order/${orderId}/return-item/${itemId}`, {
          method: "PATCH",
        })
          .then((res) => res.json())
          .then((data) => {
            if (data.success) {
              Swal.fire(
                "Requested",
                "Return request submitted",
                "success"
              ).then(() => location.reload());
            }
          });
      }
    });
  }

  async function cancelItem(orderId, itemId) {
    const previewRes = await fetch(
      `/order/${orderId}/cancel-preview/${itemId}`
    );
    const preview = await previewRes.json();

    let message = "This will refund and update your order.";

    if (preview.couponWillBreak) {
      message = `
      Cancelling this item will remove your coupon.<br><br>
      <b style="color:red">New Total: ₹${preview.newTotal}</b>
    `;
    }

    const confirm = await Swal.fire({
      title: "Cancel Item?",
      html: message,
      icon: "warning",
      showCancelButton: true,
      confirmButtonText: "Proceed",
      cancelButtonText: "Keep item",
    });

    if (!confirm.isConfirmed) return;

    const res = await fetch(`/order/${orderId}/cancel-item/${itemId}`, {
      method: "PATCH",
    });

    const data = await res.json();

    if (data.success) {
      Swal.fire("Cancelled", "Item cancelled successfully", "success").then(
        () => location.reload()
      );
    } else {
      Swal.fire("Error", "Cancel failed", "error");
    }
  }
</script>

<%- include('../partials/user/footer') %>
